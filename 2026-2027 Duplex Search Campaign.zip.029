 "_henderson_tax_note": "Vance County 0.7129/100 (NCDOR 2025-26) + City of Henderson 0.65/100 (FY2024-25 rate, WIZS); auto 2026-09-14, verify the city rate for FY2025-26",
 "tax_assessed_combined_rate": {
  "_note": "Adopted 2026-09-15 (file 32): where an assessed value is known, tax = assessed x this combined rate (county + city), not price x stress rate. NC does not reassess on sale; VA cities reassess annually or biennially and converge toward the sale.",
  "Fayetteville": {
   "rate": 0.009485,
   "basis": "Cumberland 0.499 + city 0.4495 (unchanged on the 2026 bills) on TOTAL_PROP_VALUE (sales-comparison), plus owner_side_municipal_fees.Fayetteville",
