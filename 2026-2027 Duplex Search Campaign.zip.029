␀␀4␀␀␀2026-2027 Duplex Search Campaign/_pipeline/_probe.py# Probe (2026-09-14): file 14 statuses and URL hosts, the Bright Data MCP config shape (values masked) and a direct
# Web Unlocker REST call with that token, and the CrimeGrade URL pattern recorded in the README.
import csv, collections, json, re, urllib.request
CAMP = "C:/Users/najum/Dropbox/linked/FAMILY/Ogo/.Investment/2026-2027 Duplex Search Campaign/"
rows = list(csv.DictReader(open(CAMP + "14 Live status and ranking of the 42 tracked candidates (2026-09-11).csv", encoding="utf-8")))
print("file 14 statuses:", collections.Counter(r["status"] for r in rows))
print("url hosts:", collections.Counter(("redfin" if "redfin" in r["url"] else "zillow" if "zillow" in r["url"] else "other") for r in rows))
for r in rows:
    if any(s in r["address"] for s in ("Carver", "Day St", "Tunstall", "Daughtry")): print("  ", r["address"], "|", r["status"], "|", r["url"])
readme = open(CAMP + "_pipeline/README - pipeline handoff (2026-09-11).md", encoding="utf-8").read()
print("crimegrade urls in README:", re.findall(r"https://crimegrade\.org[^\s)\]]*", readme)[:3])
m = re.search(r"CrimeGrade: local curl of .{0,200}", readme); print("README crimegrade line:", m.group(0) if m else None)
cfg = json.load(open("C:/Users/najum/.claude.json", encoding="utf-8"))
bd = {k: v for k, v in cfg.get("mcpServers", {}).items() if k.startswith("brightdata")}
def mask(o):
    if isinstance(o, dict): return {kk: mask(vv) for kk, vv in o.items()}
    if isinstance(o, list): return [mask(x) for x in o]
    if isinstance(o, str): return re.sub(r"[A-Za-z0-9_\-]{12,}", lambda mm: mm.group(0)[:4] + "..." + mm.group(0)[-3:], o)
    return o
for k, v in bd.items(): print(k, "->", json.dumps(mask(v))[:300])
tok = acct = None
for k, v in bd.items():
    env = v.get("env", {}) or {}
    tok = env.get("API_TOKEN") or env.get("BRIGHTDATA_API_TOKEN")
    if not tok and v.get("url"):
        mm = re.search(r"token=([^&]+)", v["url"]); tok = mm.group(1) if mm else None
    if tok: acct = k; break
print("token found:", bool(tok), "from", acct)
if tok:
    body = json.dumps({"zone": "mcp_unlocker", "url": "https://www.redfin.com/zipcode/23707/filter/property-type=multifamily", "format": "raw", "data_format": "markdown"}).encode()
    req = urllib.request.Request("https://api.brightdata.com/request", data=body, headers={"Authorization": "Bearer " + tok, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            c = r.read().decode("utf-8", "ignore"); print("REST unlocker: HTTP", r.status, "| chars", len(c), "| Redfin page:", "Redfin" in c[:300], "| head:", c[:100].replace("\n", " "))
    except urllib.error.HTTPError as e: print("REST unlocker HTTPError", e.code, e.read()[:300])
    except Exception as ex: print("REST unlocker ERR", ex)
