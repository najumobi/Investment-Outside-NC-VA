    if p and rent:
        rec["rent_to_price_pct"] = round(rent/p*100, 2)
        noi = 0.6*rent*12; ads = pmt(0.75*p, 0.074); rec["coc_7.4_50pct_rule"] = round((noi-ads)/(0.25*p)*100, 1); rec["dscr_7.4"] = round(noi/ads, 2)
    ko = []
    if r["land"] == "True": ko.append("land")
    if not p: ko.append("no price")
    elif p > HARD: ko.append("above hard ceiling")
    if units and units != 2: ko.append("%d units, not a duplex" % units)
    if not g: ko.append("not geocoded")
    if g and d.get("gate") and d["gate"] != "PASS": ko.append("tract fails Gate 1 at x1.0")
    if rec.get("rent_to_price_pct") is not None and rec["rent_to_price_pct"] < 0.9: ko.append("rent-to-price under 0.9%")
    rec["knockouts"] = "; ".join(ko)
    rec["shortlist"] = "YES" if not ko and p and p <= PRACTICAL else ""
    out.append(rec)
keys = []
for o in out:
    for k in o.keys():
        if k not in keys: keys.append(k)
with open("round13_scored.csv", "w", newline="", encoding="utf-8") as f:
    wr = csv.DictWriter(f, fieldnames=keys); wr.writeheader(); wr.writerows(out)
sl = [o for o in out if o["shortlist"]]
print("shortlist:", len(sl), "| gate1 pass:", sum(1 for o in out if o["gate1_x1.0"] == "PASS"), "| geocoded:", sum(1 for o in out if o["tract"]))
for o in sorted(sl, key=lambda o: -(o.get("coc_7.4_50pct_rule") or 0)):
    print(f"  {o['address'][:44]:44s} | ${o['price']:>7} | {o['beds']}bd {o['sqft']}sf | tier {o['tract_tier']} x1.25 {o['gate1_x1.25'][:4]} | r2p {o.get('rent_to_price_pct')} coc7.4 {o.get('coc_7.4_50pct_rule')} | {o['rent_basis']} | {o['source']} | {o['url']}")
print("\nKNOCKOUT TALLY:")
from collections import Counter
print(Counter(k for o in out for k in o["knockouts"].split("; ") if k))
