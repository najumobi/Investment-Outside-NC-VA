SP = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/37ab4f58-10b5-4e46-9065-f6c248237ea6/scratchpad/"
PRACTICAL, HARD = 481443, 532643
rows = list(csv.DictReader(open("round14_listings.csv", encoding="utf-8")))
print("listings:", len(rows))
cache_fn = SP+"geo_cache.json"; cache = json.load(open(cache_fn)) if os.path.exists(cache_fn) else {}
def clean_street(a):
    parts = [x.strip() for x in a.split(",")]
    st = re.sub(r"\s+(Unit|Apt|#|Lot).*$", "", parts[0], flags=re.I); st = re.sub(r"^(\d+)\s*[-&/]\s*\d+\s", r"\1 ", st)
    return st, parts
buf = io.StringIO(); w = csv.writer(buf); need = []
for i, r in enumerate(rows):
    if r["address"] in cache: continue
    st, parts = clean_street(r["address"])
    if len(parts) < 3: continue
    stz = parts[-1].split(); w.writerow([i, st, parts[-2], stz[0], stz[-1]]); need.append(i)
geo = {i: cache[r["address"]] for i, r in enumerate(rows) if r["address"] in cache}
if need:
    b = uuid.uuid4().hex
    body = ("--%s\r\nContent-Disposition: form-data; name=\"addressFile\"; filename=\"a.csv\"\r\nContent-Type: text/csv\r\n\r\n%s\r\n--%s\r\nContent-Disposition: form-data; name=\"benchmark\"\r\n\r\nPublic_AR_Current\r\n--%s\r\nContent-Disposition: form-data; name=\"vintage\"\r\n\r\nCurrent_Current\r\n--%s--\r\n" % (b, buf.getvalue(), b, b, b)).encode()
    req = urllib.request.Request("https://geocoding.geo.census.gov/geocoder/geographies/addressbatch", data=body, headers={"Content-Type": "multipart/form-data; boundary="+b, "User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=600) as resp: out = resp.read().decode("utf-8","replace")
    for rec in csv.reader(io.StringIO(out)):
        if len(rec) >= 12 and rec[2] == "Match": geo[int(rec[0])] = rec[8]+rec[9]+rec[10]; cache[rows[int(rec[0])]["address"]] = geo[int(rec[0])]
    json.dump(cache, open(cache_fn, "w"))
print("geocoded:", len(geo), "of", len(rows))
S10 = json.load(open(SP+"tract_scores_x1.0.json")); S125 = json.load(open(SP+"tract_scores_x1.25.json"))
md = json.load(open(SP+"map_data.json"))["rows"]; cat = {r["fips"]: r["cat"] for r in md}; names = {r["fips"]: r["name"]+" "+r["st"] for r in md}
tiers = {}
for fn in ("active_tract_watchlist.csv", "shallow_tract_watchlist.csv"):
    for rr in csv.DictReader(open(SP+fn, encoding="utf-8")): tiers[rr["geoid"]] = rr["tier"]
def pmt(loan, rate): r = rate/12; return loan*r/(1-(1+r)**-360)*12
def num(x):
    try: return float(str(x).replace(",",""))
    except: return None
out = []
for i, r in enumerate(rows):
    g = geo.get(i); d = S10.get(g, {}) if g else {}; d125 = S125.get(g, {}) if g else {}
    fips = g[:5] if g else None
    p = num(r["price"]); beds = num(r["beds"]); units_txt = num(r["units_text"])
    units = int(units_txt) if units_txt else (2 if (beds and beds <= 6) else None)
    med = d.get("median_rent"); rent_stated = num(r["rent_text"])
    rent = rent_stated or ((units or 2) * med if med else None)
    rec = dict(r); rec.update({"tract": g, "county": names.get(fips, ""), "county_category": cat.get(fips, ""), "tract_tier": tiers.get(g, "") if g else "", "gate1_x1.0": d.get("gate", ""), "gate1_x1.25": d125.get("gate", ""),
                 "tract_median_rent": med, "tract_tpr": None if d.get("tenant_payment_risk") is None else round(d["tenant_payment_risk"], 1), "units_assumed": units, "rent_used": rent, "rent_basis": "listing text" if rent_stated else "tract median x units"})
    if p and rent:
        rec["rent_to_price_pct"] = round(rent/p*100, 2)
        noi = 0.6*rent*12; ads = pmt(0.75*p, 0.074); rec["coc_7.4_50pct_rule"] = round((noi-ads)/(0.25*p)*100, 1); rec["dscr_7.4"] = round(noi/ads, 2)
    ko = []
    if r["land"] == "True": ko.append("land")
    if not p: ko.append("no price")
    elif p > HARD: ko.append("above hard ceiling")
    if units and units != 2: ko.append("%d units, not a duplex" % units)
    if not g: ko.append("not geocoded")
    if g and d.get("gate") and d["gate"] != "PASS": ko.append("tract fails Gate 1 at x1.0")
    if rec.get("rent_to_price_pct") is not None and rec["rent_to_price_pct"] < 0.9: ko.append("rent-to-price under 0.9%")
    rec["knockouts"] = "; ".join(ko)
    rec["shortlist"] = "YES" if not ko and p and p <= PRACTICAL else ""
    out.append(rec)
keys = []
for o in out:
    for k in o.keys():
        if k not in keys: keys.append(k)
with open("round14_scored.csv", "w", newline="", encoding="utf-8") as f:
    wr = csv.DictWriter(f, fieldnames=keys); wr.writeheader(); wr.writerows(out)
sl = [o for o in out if o["shortlist"]]
print("shortlist:", len(sl), "| gate1 pass:", sum(1 for o in out if o["gate1_x1.0"] == "PASS"), "| geocoded:", sum(1 for o in out if o["tract"]))
for o in sorted(sl, key=lambda o: -(o.get("coc_7.4_50pct_rule") or 0)):
    print(f"  {o['address'][:44]:44s} | ${o['price']:>7} | {o['beds']}bd {o['sqft']}sf | tier {o['tract_tier']} x1.25 {o['gate1_x1.25'][:4]} | r2p {o.get('rent_to_price_pct')} coc7.4 {o.get('coc_7.4_50pct_rule')} | {o['rent_basis']} | {o['source']} | {o['url']}")
print("\nKNOCKOUT TALLY:")
from collections import Counter
print(Counter(k for o in out for k in o["knockouts"].split("; ") if k))
