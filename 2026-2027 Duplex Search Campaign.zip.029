qrows = list(csv.DictReader(open(qf, encoding="utf-8"))); qfields = list(qrows[0].keys()); q = {r["zip"]: r for r in qrows}
tf = CAMP+"12 ZIP sweep tally, rounds 1-13 (2026-09-12).csv"
tally = list(csv.DictReader(open(tf, encoding="utf-8"))); fields = list(tally[0].keys())
tally = [r for r in tally if r["round"] != "round 14"]
for z in Z16:
    qr = q[z]
    tally.append({"round":"round 14","set":qr["set"],"zip":z,"state":"VA" if int(z) < 27000 else "NC","counties":qr["counties"],"weighted_duplex_units_in_passing_tracts":qr["weighted_duplex_units"],"in_home_csa":"no","listings_found_redfin":MERGED.get(z,0),"mechanical_shortlist":sl.get(z,0),"advancing_after_full_gates":adv.get(z,0),"second_source_checked":"Zillow duplex page pulled with Redfin in the same pass, "+TODAY+("; Redfin has no page for this ZIP" if z == "24020" else "")})
    if not qr["status"].startswith("swept"): qr["status"] = f"swept {TODAY} (round 14: Redfin + Zillow duplex page)"
newname = CAMP+f"12 ZIP sweep tally, rounds 1-14 COMPLETE ({TODAY}).csv"
with open(newname,"w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=fields); w.writeheader(); w.writerows(tally)
with open(qf,"w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=qfields); w.writeheader(); w.writerows(qrows)
print("merged per zip:", {z: n for z, n in MERGED.items() if n})
print("tally rows:", len(tally), "| queue swept:", sum(1 for r in qrows if r["status"].startswith("swept")), "of", len(qrows), "| excluded:", sum(1 for r in qrows if r["status"].startswith("excluded")), "| pending:", sum(1 for r in qrows if r["status"].startswith("pending")))
# campaign totals by round
by = defaultdict(lambda: [0,0,0,0,0])
for r in tally:
    b = by[r["round"]]; b[0] += 1; b[1] += int(r["listings_found_redfin"] or 0); b[2] += int(r["mechanical_shortlist"] or 0); b[3] += int(r["advancing_after_full_gates"] or 0); b[4] += 1 if int(r["listings_found_redfin"] or 0) == 0 else 0
tot = [0,0,0,0,0]
def rk(k):
    m = re.search(r"(\d+)", k); return int(m.group(1)) if m else 0
for k in sorted(by, key=rk):
    b = by[k]; tot = [tot[i]+b[i] for i in range(5)]
    print(f"{k:10s} ZIPs {b[0]:3d} | listings {b[1]:4d} | mechanical {b[2]:3d} | entrants {b[3]:2d} | empty ZIPs {b[4]:3d}")
print(f"{'TOTAL':10s} ZIPs {tot[0]:3d} | listings {tot[1]:4d} | mechanical {tot[2]:3d} | entrants {tot[3]:2d} | empty ZIPs {tot[4]:3d}")
f14 = CAMP+"14 Live status and ranking of the 42 tracked candidates (2026-09-11).csv"
rows14 = list(csv.DictReader(open(f14, encoding="utf-8")))
print("file 14 rows:", len(rows14), "| active:", sum(1 for r in rows14 if r["status"].startswith("ACTIVE")), "| entrants this round:", sum(1 for o in out if o["verdict"] == "ENTRANT"))
pend=[r for r in qrows if r["status"].startswith("pending")]
print("pending ZIPs after round 14:", len(pend), "-> QUEUE COMPLETE" if not pend else "")
