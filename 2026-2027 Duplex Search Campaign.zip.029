␀␀␀␀␀Í;.]ð»¤9␀␀9␀␀:␀␀␀2026-2027 Duplex Search Campaign/_pipeline/_setup_sweep.py# One-time setup for the weekly re-sweep (2026-09-14): copies the tract model out of the Temp scratchpads into
# _pipeline/model, brings the round 4-9 listing CSVs and ZIP lists into _pipeline, builds sweep_zips.json
# (top-100 ZIPs by listings found in the complete sweep) and seeds seen_index.csv from every prior round.
import csv, json, re, os, glob, sys, shutil
CAMP = "C:/Users/najum/Dropbox/linked/FAMILY/Ogo/.Investment/2026-2027 Duplex Search Campaign/"
PIPE = CAMP + "_pipeline/"; MODEL = PIPE + "model/"
SP37 = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/37ab4f58-10b5-4e46-9065-f6c248237ea6/scratchpad/"
P2 = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/d3fc537c-7b24-472b-90c0-ce79334bff8a/scratchpad/pass2/"
os.makedirs(MODEL, exist_ok=True); os.makedirs(CAMP + "_sweeps", exist_ok=True)
for f in ["tract_scores_x1.0.json", "tract_scores_x1.25.json", "map_data.json", "active_tract_watchlist.csv", "shallow_tract_watchlist.csv", "geo_cache.json"]:
    if not os.path.exists(MODEL + f): shutil.copy(SP37 + f, MODEL + f)
if not os.path.exists(MODEL + "US.txt"): shutil.copy(P2 + "US.txt", MODEL + "US.txt")
for r in range(4, 10):
    src = P2 + f"round{r}_listings.csv"
    if os.path.exists(src) and not os.path.exists(PIPE + f"round{r}_listings.csv"): shutil.copy(src, PIPE)
for r in range(5, 9):
    src = P2 + f"round{r}_zips.json"
    if os.path.exists(src) and not os.path.exists(PIPE + f"round{r}_zips.json"): shutil.copy(src, PIPE)
print("model:", {f: os.path.getsize(MODEL + f) for f in os.listdir(MODEL)})
sys.path.insert(0, PIPE); from parsers import key

tally = list(csv.DictReader(open(CAMP + "12 ZIP sweep tally, rounds 1-14 COMPLETE (2026-09-12).csv", encoding="utf-8")))
def n(r):
    try: return int(r["listings_found_redfin"])
    except: return 0
q = {r["zip"]: r for r in csv.DictReader(open(CAMP + "06d ZIP sweep queue, active and shallow sets (2026-09-09).csv", encoding="utf-8"))}
print("06d redfin url sample:", next(iter(q.values()))["redfin_for_sale_url"])
tally.sort(key=lambda r: (-n(r), -int(q.get(r["zip"], {}).get("weighted_duplex_units", 0) or 0)))
top = tally[:100]
zurl = {}
for fn in glob.glob(PIPE + "round*_zips.json") + glob.glob(SP37 + "*zips.json"):
    try:
        for z in json.load(open(fn, encoding="utf-8")):
            if isinstance(z, dict) and z.get("zip") and z.get("zillow"): zurl.setdefault(z["zip"], (z["zillow"], os.path.basename(fn)))
    except Exception as ex: print("skip", fn, ex)
geo = {}
for line in open(MODEL + "US.txt", encoding="utf-8"):
    p = line.rstrip("\n").split("\t")
    if len(p) > 4 and p[4] in ("NC", "VA") and p[1] not in geo: geo[p[1]] = (p[2], p[4])
FIX = {"22840": "mcgaheysville-va-22840", "24058": "radford-va-24058", "23233": "henrico-va-23233", "24224": "saint-paul-va-24224", "24613": "bluefield-va-24613", "23075": "highland-springs-va-23075"}
def slug(city, st, z): return re.sub(r"[^a-z0-9]+", "-", city.lower()).strip("-") + f"-{st.lower()}-{z}"
out = []; src = {"round": 0, "geonames": 0}
for i, r in enumerate(top, 1):
    z = r["zip"]; qr = q.get(z, {})
    if z in zurl: zu, how = zurl[z]; src["round"] += 1; how = "from " + how
    else:
        s = FIX.get(z)
        if not s:
            city, st = geo.get(z, (None, None)); s = slug(city, st, z) if city else None
        zu = f"https://www.zillow.com/{s}/duplex/" if s else None; src["geonames"] += 1; how = "geonames-derived, unverified"
    out.append({"rank": i, "zip": z, "state": r["state"], "counties": r["counties"], "set": r["set"], "listings_last_sweep": n(r), "units": qr.get("weighted_duplex_units"),
                "redfin": qr.get("redfin_for_sale_url") or f"https://www.redfin.com/zipcode/{z}/filter/property-type=multifamily", "zillow": zu, "zillow_source": how})
json.dump(out, open(PIPE + "sweep_zips.json", "w", encoding="utf-8"), indent=1)
print("sweep_zips.json:", len(out), "ZIPs; zillow urls", src, "| listings covered:", sum(o["listings_last_sweep"] for o in out), "| min listings:", out[-1]["listings_last_sweep"])

seen = {}
DATES = {"06c": "2026-09-09", "15 ": "2026-09-11", "round13": "2026-09-12", "round14": "2026-09-12"}
files = [CAMP + "06c Current multi-family listings, ZIP rounds 1-3, scored (2026-09-09).csv", CAMP + "15 Round 4 sweep, 50 ZIPs scored (2026-09-11).csv"] + sorted(glob.glob(PIPE + "round*_listings.csv"))
for fn in files:
    base = os.path.basename(fn); d = next((v for k, v in DATES.items() if base.startswith(k)), "2026-09-11")
    rows = list(csv.DictReader(open(fn, encoding="utf-8"))); added = 0
    for r in rows:
        a = (r.get("address") or "").strip(); m = re.search(r"(\d{5})$", a)
        if not m: continue
        z = m.group(1); k = key(a) + "|" + z
        if k in seen: continue
        price = (r.get("price") or "").replace(",", "").replace("$", "")
        seen[k] = {"key": k, "address": a, "zip": z, "first_seen": d, "last_seen": d, "price_first": price, "price_last": price, "source": r.get("source", ""), "url": r.get("url", ""), "status": "listed", "gone_date": "", "note": "seed from " + base[:40]}; added += 1
    print(f"  {base[:60]:60s} rows {len(rows):4d} added {added}")
with open(PIPE + "seen_index.csv", "w", newline="", encoding="utf-8") as f:
    w = csv.DictWriter(f, fieldnames=list(next(iter(seen.values())).keys())); w.writeheader(); w.writerows(seen.values())
print("seen_index.csv:", len(seen), "keys")
