Z16 = [z["zip"] for z in json.load(open(SP+"round14_zips.json"))]
MERGED = {z: 0 for z in Z16}
for r in lst: MERGED[r["page_zip"]] = MERGED.get(r["page_zip"], 0) + 1
sl = {}; adv = {}
for r in scored:
    if r["shortlist"] == "YES" and r["address"].split(",")[0] not in DUP: z = r["page_zip"]; sl[z] = sl.get(z,0)+1
for o in out:
    if o["verdict"] == "ENTRANT": z = o["address"][-5:]; adv[z] = adv.get(z,0)+1
