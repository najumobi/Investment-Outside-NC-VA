 "211-213 E Clifford St #215": {"grade": "OUT", "c": "C4", "units": 3, "units_txt": "Package: 'three income-producing rental units for one price: one duplex and one house' (two 1910 wood-frame buildings in the photo)", "rents": null, "cond": "OUT under Gate 3: a three-unit package across two buildings, not a single duplex", "pnote": "two adjacent two-story frame houses, metal roof on one, worn porches, sloped drive", "flood": null, "built": 1910, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "420 Mount Vernon Ave": {"grade": "RED", "c": "C6", "units": 2, "units_txt": "1920 duplex, 3-4 bed per the remarks, sold as an 'Investor Special: interior and siding full rehab, new roof'", "rents": null, "cond": "OUT (RED): unfinished renovation, exterior stripped to OSB sheathing with no siding, an open doorway; Port Norfolk historic district (23707) so the exterior needs a certificate of appropriateness", "pnote": "rear view: bare OSB walls, new wood stairs, doorway with no door, one new window; a shell", "flood": null, "built": 1920, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "132 Kemper Rd Unit A & B": {"grade": "YELLOW", "c": "C4", "units": 2, "units_txt": "1923 side-by-side duplex, two 1-bed/1-bath units plus a laundry area with a full bath; HVAC replaced 2-3 years ago, water heater 1 year ago; relisted Sep 12 after an Aug 20 contingency fell through", "rents": null, "cond": "YELLOW: 1923 building, 1-bed units (tract median x2 overstates 1-bed rents, run comps before believing 1.18%), a failed contingency in August that the agent must explain; Danville tax 0.84% known", "pnote": "blue-painted brick bungalow, full-width porch with four columns, two mailboxes, brick foundation, tidy lawn, iron gate; presentable", "flood": 1, "built": 1923, "dom": 169, "status": "ACTIVE", "last_sold": ""},
 "816 Elizabeth St": {"grade": "OUT", "c": "C3", "units": 1, "units_txt": "Remarks describe 'a three-bedroom, one-bathroom single-family residence'; filed as multi-family by mistake", "rents": null, "cond": "OUT under Gate 3: single-family house", "pnote": "small vinyl cottage with a new porch and rear addition; looks renovated", "flood": null, "built": 1910, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "801 S Elm St": {"grade": "OUT", "c": "", "units": 0, "units_txt": "'3 lots being sold together ... CC zoning'; unimproved land", "rents": null, "cond": "OUT: land, not a building", "pnote": "listing photo is a GIS parcel-map screenshot", "flood": null, "built": null, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "4912 Watlington Rd": {"grade": "OUT", "c": "", "units": 0, "units_txt": "'Multi-family land in the city ... retention pond already installed'; unimproved land", "rents": null, "cond": "OUT: land, not a building", "pnote": "listing photo is a parcel map with a pond", "flood": null, "built": null, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "311 Arch St": {"grade": "YELLOW", "c": "C4", "units": 2, "units_txt": "1950 duplex: 311 Arch occupied (living room, bedroom, kitchen, gas upright wall heater; upstairs 25x14 open room and full bath) plus a second unit; wall heaters, no central systems mentioned", "rents": 950, "cond": "YELLOW: 1950 building on wall heaters (no central heat or air; the upstairs room has no heat at all), $95,000 price is under the $133,333 DSCR loan floor; rent basis = the stated $475/month for 311 Arch, the vacant 313 Arch assumed the same ($950 total)", "pnote": "white side-by-side duplex with two doors and two porch rails, dark trim, leaves on the ground; tired but intact", "flood": null, "built": 1950, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "3809 Virginia St": {"grade": "RED", "c": "C5", "units": 2, "units_txt": "1968 'duplex' with one 5-bed/5-bath unit and one 4-bed/4-bath unit, both leased: a per-room rooming operation", "rents": null, "cond": "OUT (RED): the aerial shows blue tarps on the roofs of the buildings inside the outlined parcel, and a nine-bed, nine-bath per-room operation is not the novice single-duplex thesis", "pnote": "drone aerial with the parcel outlined in red; two structures with blue tarps, cars, a church parking lot across the street", "flood": null, "built": 1968, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "404 Lynn Rd": {"grade": "OUT", "c": "", "units": 1, "units_txt": "Remarks: '4 BEDROOM 1 AND 1/2 BATH HOME'; a single-family house filed as multi-family", "rents": null, "cond": "OUT under Gate 3: single-family house", "pnote": "interior photo only (bedroom with an air mattress); no exterior shown", "flood": null, "built": 1971, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "410 Latham Street": {"grade": "OUT", "c": "", "units": 0, "units_txt": "Vacant lot (drone photo of grass between two neighbours); no remarks", "rents": null, "cond": "OUT: land, not a building", "pnote": "aerial of a cleared grass lot", "flood": null, "built": null, "dom": null, "status": "ACTIVE", "last_sold": ""},
 "2311 Nickey Ave": {"grade": "YELLOW", "c": "C4", "units": 2, "units_txt": "1963 duplex, two 2-bed/1-bath units, both rented; updated kitchens and bathrooms, new flooring, paint, appliances, cabinets; no carpet", "rents": null, "cond": "YELLOW: 1963 with algae-streaked vinyl siding and a crawl space in the photo, interior updates claimed but not dated; rents not stated (tract median x2 = $2,388 likely overstates two 2-bed units, expect about $1,000 each); Fayetteville SF-6 zoning question from advisory file 31 (duplexes need a special use permit) must be checked; CrimeGrade for 28301 not in the constants", "pnote": "small white vinyl cottage marked 2311 A, green algae on the siding, block foundation with crawl vents, gravel drive, wooded lot; dated but sound-looking", "flood": null, "built": 1963, "dom": null, "status": "ACTIVE", "last_sold": ""},
