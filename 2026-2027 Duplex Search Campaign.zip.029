  ]
 },
 "fayetteville_casualty_rules": {
  "read_on": "2026-09-24",
  "routing": "30-7.C.1: nonconforming structure + conforming use -> 30-7.C; nonconforming structure + nonconforming use -> 30-7.B",
  "structure_rule_30_7_C_5": ">50% replacement cost: restore only in conformity; <=50%: previous form with a permit within 180 days and work within 1 year; never increase the nonconformity",
  "use_rule_30_7_B_8": ">50%: conform, EXCEPT B.8.a.3-4: a lawfully nonconforming multifamily residential structure in a residential district may rebuild to its prior density (duplex/triplex/quadruplex named) with a permit within 6 months, work within 12, up to 36 with the City Manager, Article 30-5 and conforming buffers first",
  "single_family_lot_rule_30_7_D_3": "same-footprint rebuild on a pre-7/1/2011 nonconforming lot, single-family only",
  "reading": "since Ord. S2025-008 (4/14/2025) two-family is P in SF-6, so an SF-6 duplex's use conforms and only its density does not; the text routes it to C.5 (one unit after a >50% loss) unless the city reads B.8.a.3 broadly; P(two-unit rebuild letter) 0.35; ask Development Services once for Rhew, Edgar, Nickey, Squirrel, Varsity, Pecan",
  "parking_on_rebuild": "30-5.A.4: 2 spaces per unit; 30-5.A.5.a: existing two- to four-family parking must sit in a vehicular use area"
 },
 "advisory_44_rules_adopted": {
  "portal_sale_lines": "a portal 'Sold' line (Redfin/Zillow 'Public Records') enters the board only when the county deed chain (camapwa DeedDetails) or the ROD index shows the instrument and its stamps (Pecan's '6/24/2025 $20,000' had neither)",
  "source_of_title_recital": "read the current deed's source-of-title recital and fetch that instrument; flag quitclaims and ESTATE-NUMBER lines; when the county chain shows an estate with several heirs, pull the SIBLING parcels' cards - a same-day companion quitclaim usually completes a division",
  "e911_second_address": "query the county E911 address layer for the parcel's PIN; a second address point typed APT is two-unit evidence for the lawful-establishment burden",
  "pwc_meter_count": "query 120Water per unit address AND for the street's other duplexes; one asset where comparable duplexes carry two = owner-paid water base case",
  "fee_unit_count": "count solid-waste fee units on every bill year available (2012+ online) as evidence of lawful two-unit use",
  "insurance_step_ledger": "re-affirmed: $1,680 carries the 10/1/2026 step; do not add it again (advisories 42 and 44 both did)",
  "casualty_routing": "see fayetteville_casualty_rules; state which article governs and why before quoting a rebuild rule",
  "delinquent_advertisement_pdf": "pull the county's advertisement PDF for any ADVERTISED bill year - it lists sibling parcels under the same owner (2604 Pecan surfaced this way)",
  "seller_entity_type": "identify a corporate seller's line of business (FMCSA/USDOT, SOS, licensing boards) - a non-real-estate corporation holding one parcel is a one-off seller with no lender clock",
  "historic_map_check": "for Fayetteville rows check the official Local Historic Districts map (9/2014 PDF) since the zoning layer carries no HLO suffix",
  "transport_0924": "Bright Data connectors 2b7b1243 / 1d64e66b / 57ad3277 served early then all rejected credentials mid-session (reconnect in connector settings); Apify web-fetch (8ff1a9a7, d6dc1e15) served Redfin rentals and Zillow rental-manager pages; sosnc.gov and portal-nc.tylertech.cloud front bot-verification gates in the in-app browser - run by hand; enCodePlus export returns the PDF on the first request"
 },
 "stoneleigh_villas_3116MF": {
  "read_on": "2026-09-24",
  "parcels": 98,
  "halves": 96,
  "whole_duplex_parcels": [
   "741 Tamarack Dr (lot 37, sec 1, PB 50/63)",
   "1176 Landau Rd (lot 20 A-B, sec 2, PB 52/39; created 5/1/2025 by combining two halves)"
  ],
  "half_values_2025_reval": "79,700-119,300, median 107,800; sales-comparison factor 1.35x cost for halves, 1.85x for the whole parcels",
  "pair_sales_2026": {
   "3541/3545 Torbay": 245000,
   "3592/3594 Torbay": 263000,
   "751/755 Hedgelawn": 239000,
   "759/763 Hedgelawn": 239000
  },
  "pair_median": 242000,
  "pair_rent_to_price": "0.84-0.86%",
  "achieved_rent_2bd2ba": 1025,
  "asks_2026": {
   "754 Hedgelawn": 925,
   "707 Hedgelawn": 1050,
   "3563 Rolls": 1050,
   "759 Hedgelawn": 1100,
   "3545 Torbay renovated": 1099,
   "1176 Landau half renovated (11/2025, off in 19 days)": 1250
  },
  "adjacent_complex": "Lake in the Pines, 848 Tamarack Dr: 620 units, 1983, 2BR/1BA 680-860 sf $873-1,419, water included, first month free through 10/6/2026",
  "hoa": "Stoneleigh Villas Homeowner Association, NC non-profit SOS 1093388 (formed 4/16/2009), office on the 700 block of Tamarack; dues undisclosed; covenants: COVENANTS OF RECORD READ 9/24 (ROD Corp search 'STONELEIGH VILLAS', 8 names / 13 entries; three instruments fetched): (a) Restrictive Covenants for Stoneleigh Villas Section One, Book 2842 Page 483-486, recorded 10/12/1981 by the developer O & N Investments Inc (4 pages, read in full): par. 1 permits 'one-detached, single-family dwelling or two (2) to four (4) family dwellings' up to 2.5 stories on any numbered lot (the duplex use is EXPRESSLY permitted by covenant); par. 2 and 10 minimum 850 sf per unit in two- to four-family dwellings (the subject's 948 sf units comply), brick or block foundations, 'no residence or structure shall use asbestos siding or exposed cinder block wall'; par. 4, 7, 8, 9, 14 reserve written consent of the developer or its successors for outbuildings, front-of-structure fences (except developer privacy fences), 'alterations, additions, or changes of any kind ... to the structure or design', masonry work and home occupations (dormant unless a successor asserts them); par. 5 no defective vehicles, bicycles, garbage cans or toys nearer the street than the front corner; par. 6 common pets only; par. 11 runs with the land to 9/1/2011 then auto-extends in ten-year periods (now 2021-2031) unless a recorded majority vote of lot owners amends; par. 12 any lot owner may enforce; par. 15 ten-foot side-line utility easement; par. 16 developer may subject the lots to a PWC underground-electric or street-lighting contract with a continuing monthly payment per building owner. NO leasing or rental restriction, NO association, NO assessment. (b) 'Declaration of Protective & Restrictive Covenants for Stoneleigh Villas Subdivision', Book 8093 Page 58-59, recorded 3/9/2009 by two signers styled 'the owners of two homes in the subdivision': purports to make 'all owners' members of an association, levy $40 monthly dues payable to a private company at a PO Box, fine $500 per violation up to $3,000, and mandate fences, security alarms or bars, curb numbers and security lights, with a 20-year term - one month before the 'Stoneleigh Villas Homeowner Association' non-profit was formed (4/16/2009) with its office at 731 Tamarack Dr. (c) 'Termination of Protective & Restrictive Covenants', Book 9768 Page 433, recorded 12/8/2015 by the then owners of 731 Tamarack Dr (Lot 35, Section One): recites that the prior owner of 731 executed the 2009 declaration, that the co-signer 'never owned property in Stoneleigh Villas Subdivision', that 731 was 'the only property encumbered with the Declaration', and terminates it. READ: no HOA, dues, assessment or leasing restriction binds Lot 37; the 2009 attempt bound one lot and is terminated; the 1981 covenants govern and permit the duplex; a title examiner will note (b) and (c) under the subdivision name",
  "meters": "one PWC service-line asset per half and per unit of the subject (per-unit water)",
  "history": "2017 revaluation cut the sector about 40-50% (subject $86,700 -> $43,300; a half $47,300 -> $29,400) while adjacent single-family rose; 2025 revaluation re-rated 3.3x (halves) to 5.5x (subject)",
  "crime_context": "the 400 m ring around the subject carries the 620-unit complex and the Rosehill Rd strip: 90 / 169 / 12 in two years against 15 / 50 / 14 at Pecan"
 },
 "advisory_45_rules_adopted": {
  "photo_provenance_hash": "hash each evidence frame against the property's prior-listing images in Redfin's sale history; a match voids the photo C-rating and forces YELLOW unverified (r4d: 5 of 5 matched the 2017 set)",
  "redfin_fallback": "when the sweep's Zillow capture is thin (no remarks/history), read the Redfin property page: it carries the source (FSBO.com), both listings' remarks, prior rents and the tax history",
  "bill_unpaid_flag": "suppress the bare '2026 bill unpaid' flag between 9/1 and 1/5 BUT read every prior bill's payer (see fayetteville_instruments.bill_payer_reading); a foreclosure-attorney or servicer payer is the distress signal the advisory's rule would hide",
  "pair_stamp_rule": "a stamp count repeated on two adjacent halves with no apportioned price is one pair sale (MLS-confirmed for 751/755 Hedgelawn and 3592/3594 Torbay)",
  "submarket_yield_screen": "when same-product pair sales trade under 0.90% rent-to-price on achieved rents, mark the row so a below-comp ask is not read as a bargain (Stoneleigh 0.84-0.86%)",
  "listing_source_column": "carry listing_source (MLS / FSBO / auction); FSBO rows have no broker to route disclosures, access or tenant coordination, and FSBO.com's free tier syndicates to Zillow/Redfin/Trulia but not realtor.com",
  "lien_before_reopen_price": "search the ROD by owner name and read the current deed of trust's note amount before setting any reopen line; the payoff sets the seller's floor (r4d: $140,000 of 8/2023 against a $103,000 basis makes the $153,000 line a break-even)",
  "owner_portfolio": "for an individual seller run OWNER LIKE and read the other parcels' bills; a portfolio-wide default changes the exit path (short sale / trustee sale) and the timing",
  "second_listing_records": "pull the property's other Zillow zpid and Trulia unit records for earlier owner texts and rent asks (r4d: a third text with month-to-month tenants at $875 and a 2/2024 unit ask of $1,000)",
  "stormwater_tier": "the city stormwater line signals the impervious-area tier; do not carry $84 as a constant",
  "advertisement_pattern": "delinquent_taxes__YYYY.pdf for 2024 and 2025",
  "insurance_step_ledger": "re-affirmed a third time: $1,680 carries the 10/1/2026 step; advisories 42, 44 and 45a all re-applied it",
  "transport_0924_evening": "Apify web-fetch (fabdb3db) served FSBO.com JSON-LD, Zillow's listing block and realtor.com; the 8ff1a9a7 and d6dc1e15 copies answered 'tool not found' on repeat calls; Bright Data 2b7b1243 served Redfin, hotpads and davidbcraig.com, 57ad3277 served Zillow and Trulia (truncated before price history), 1d64e66b returned an empty SERP; the Register of Deeds Blazor app was driven in the in-app browser and its session PDF link served to curl; Zillow refused the in-app browser; the Wayback Machine was offline; Composio and Reddit not used"
 },
 "pinetops_instruments": {
  "parcels": "NC OneMap NC1Map_Parcels layer 1 (ownname, parval, parusecode, sourcedate); Edgecombe webmap layer 10 was EMPTY on 9/25/2026 (count 0) - do not treat an empty return as 'no parcel'",
  "address_points": "https://gis.edgecombecountync.gov/arcgis/rest/services/webmap/MapServer/5 (FULLADD; simple 'x,y' geometry syntax; the Census geocoder sits about 50 m north of the lot)",
  "zoning_layer": "https://gis.edgecombecountync.gov/arcgis/rest/services/webmap/MapServer/17 (ALPHA; pre-2021 names; M-1 = the Town's LI)",
  "tax_card_and_bills": "https://taxpa.edgecombecountync.gov/paas/index.asp : POST ?DEST=pSearch&action=Search with PIN=####-##-####-## (cookie jar), then POST ?DEST=pDetail with pKEY=<12-digit PIN> (card: township, buildings, sq ft, utilities code, deed, sales price, values), then POST ?DEST=pBLDG|pLAND|pSALE|pCOLL&action= with txtPIN and pKEY (building use and value; land segment; 20-year bill list with amount due); the older paas.ASP?WCI=pData path is dead",
  "register_of_deeds": "https://cotthosting.com/ncedgecombeexternal/User/Login.aspx -> 'Sign in as a Guest' -> Book/Page or Quick Name (index CRP); Document Details lists grantors/grantees and kind; images open in an HTML5 viewer whose <img id='img_N'> elements can be drawn to a canvas and exported as JPEG via javascript_tool (page 1 only loads eagerly)",
  "delinquent_list": "https://www.edgecombecountync.gov/Departments/Tax%20Assessor/179165_ECTC_2025%20Delinquent%20Tax%20Listings.pdf (text layer)",
  "town_documents": "https://townofpinetopsnc.com/documents/288/<file>.pdf (minutes index /minutes; planning /meeting-agendas-and-minutes-1; budgets /annual-budget; rates /water-rates-and-policies); many 2024-2025 PDFs have no text layer",
  "permits": "Edgecombe County Inspections 252-641-7808, permit@edgecombeco.com (no online portal); Town zoning permit $25 (not required for interior repairs)",
  "wwtp": "ECHO DFR and effluent chart for NC0020435 (flow parameter 50050; 30DA AVG values); DWR moratorium list PDF (data evaluated 2/16/2024)",
  "street_view_dates": "https://www.google.com/maps/photometa/v1?...!2s<panoid>... returns [year,month] pairs; https://streetviewpixels-pa.googleapis.com/v1/thumbnail?cb_client=maps_sv.tactile&w=1000&h=600&pitch=0&panoid=<id>&yaw=<deg> serves a frame; the in-app browser renders Google Maps black"
 },
 "advisory_50_rules_adopted": {
  "duplex_lot_minimum_intake": "record the governing ordinance's duplex minimum lot area and width next to zoning conformity for every NC row (Pinetops: 15,000 sf and 85 ft in its densest districts)",
  "distressed_price_then_remodel": "a distressed last sale followed by a gut remodel of a vacant nonconforming duplex is the fact pattern that ends the use under a discontinuance clock; read the deed KIND (commissioner's, trustee's, tax) at the Register of Deeds and pull dated Street View frames before any offer",
  "moratorium_flag": "check the DWR moratorium list and distinguish '90% Rule imposed' (02T .0118, sewer-line extension permits) from 'Statutory moratorium imposed' (G.S. 143-215.67(c)); read ECHO flows against the permitted MGD",
  "distressed_unit_flag": "check the DEQ distressed list and score table for every NC town utility; read the budget message for the electric-to-general-fund transfer",
  "demolition_lien_reach": "for a seller with several parcels in one town, check the town's unfit-dwelling ordinance reach (Pinetops: other property within the Town or one mile)",
  "mechanics_lien_window": "for a listing remodeled within six months, search the ROD index for claims of lien and lien-agent notices and add LiensNC (login) and final lien waivers to the closing checklist",
  "vested_rights_ask": "ask small-town zoning administrators for a written determination under G.S. 160D-108(h) and the local ordinance's determination section (appealable de novo), not an informal 'zoning letter'",
  "county_solid_waste_fee": "Edgecombe's $150 fee bills only the unincorporated area and Leggett; the Pinetops bill is pure tax"
 },
 "nc_vested_rights_2025": {
  "sl_2025_94_s29": "law 10/6/2025: G.S. 160D-108(c) now ends 'A vested right obtained by permit or other local government approval shall not preclude the use or extinguish the existence of any other vested right or use by right attached to the property'; 160D-102(18) landowner = all holders of record of the fee, county tax records may be relied on",
  "24_month_clause": "160D-108(d): statutory vesting for a nonconforming use expires after 24 consecutive months of intentional and voluntary discontinuance (tolled by litigation); it does not shorten or lengthen a local ordinance's clock on a common-law nonconforming use",
  "h765": "not law (House Finance since 5/6/2025)"
 },
 "pinetops_utility_rates_fy27": {
