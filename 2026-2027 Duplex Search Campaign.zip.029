  "county_tax": "https://taxpa.edgecombecountync.gov/paas/index.asp (POST ?DEST=pSearch&action=Search with PIN ####-##-####-## AND ITEMSPERPAGE=20; pDetail with pKEY; pBLDG/pLAND/pSALE/pCOLL with txtPIN and pKEY; OWNER search works)",
  "city_tax": "https://rockymountnc.munisselfservice.com/css/citizens/RealEstate/Default.aspx?mode=new (ASP.NET postback: __VIEWSTATE, __EVENTVALIDATION, ParcelIDTextBox 12-digit MUNIS pin, YearSearchTextBox; ViewBill.aspx; AllBills.aspx)",
