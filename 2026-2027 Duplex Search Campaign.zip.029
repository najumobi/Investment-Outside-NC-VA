def crime_pen(g):
    g = g.split(" ")[0] if g else ""
    return {"F": 3, "D-": 2, "D": 1, "D+": 0.5}.get(g, 0)
ORDER = {"ENTRANT": 0, "NEAR-MISS": 1, "OUT (negative cash flow)": 2, "OUT (RED)": 3, "OUT": 4}
