 "edgecombe_tax_delinquency_instrument": {
  "_note": "Adopted 9/25/26 (advisory 48 round): the county's 2025 Delinquent Tax Liens advertisement (liens as of 1/6/2026, 20 pages) and the WebPAAS pCOLL amount-due column together date a seller's arrears; interest 2% for January + 0.75% a month + $4.00 advertising cost",
  "hunt_central_holdings_9_25": "all five parcels advertised for 2025; four still due (subject 663.03); 1401 Hargrove cleared at its 8/27/2026 sale"
 },
 "advisory_49_rules_adopted": {
  "_note": "Adopted 9/25/26 (round 13, 918 Star St). The advisory's own six pipeline suggestions (rent_ask_own field, Rocky Mount condition_history layers, crime envelope query, Zoneomics as a plain-curl transport, re-screen one-bedroom rows on comps before a GATE5 rank, claim advisory numbers on number plus address) are accepted; the entries below are what the verification added.",
  "assessment_history_before_tax_model": "before writing a 'seller-year' tax line, read the county AND city Munis AssessmentHistory (or the iasWorld valuesall datalet) for the CURRENT bill year: a renovation completed in year N is valued on 1/1/N+1 under G.S. 105-287(a)(2b) (918 Star: 18,060 in 2025 -> 78,400 in 2026 with 'Remodeled Year 2025' on the card); a preliminary N+2 value may already be posted",
  "rental_twin_last_available": "rent.com prints 'This property was last available on <date> for $<rent>' and 'Description updated on <date>' - the withdrawal date of a rental listing; Redfin flips the same URL to 'OFF MARKET / Rental removed'; Zillow reverts to the public record. Re-read the twin on every rebase; a sale withdrawal within days of a rental withdrawal is a state change to log",
  "permit_layer_currency": "query outStatistics max(piah_init_app) and per-year counts before reading an empty permit result: Rocky Mount's Permit_Application_Entry ends 11/13/2023; the Munis CSS Permits module is behind Tyler Portico sign-in - post-2023 permits need a records request or an account",
  "code_cases_by_address": "ViolationsAddress is keyed by geocoded Match_addr; a parcel-id LIKE query returns nothing while the address query returns the cases (918 Star: 0 vs 48)",
  "liens_ledger_layers": "Rocky Mount's Happy_Hill_Liens_Map_WFL1 (layers 3 and 7) and Down_East_Liens_Map_WFL1 carry per-parcel F2012-F2021 taxes, Weed_Cutti, Dem_Water and TOTALS as of 9/2/2021: the city's abatement-lien ledger for the two target neighbourhoods; abatement liens run with the land (G.S. 160A-193) and are outside the ten-year bar (G.S. 105-378(b))",
  "county_prior_bills": "Munis CSS AllBills lists every bill year with Paid / Outstanding and the 'Prior unpaid bill(s) exist for this parcel' banner; judge enforceability with G.S. 105-378(a) (ten years from the due date) but list every outstanding year as a tax-certification item (918 Star: 2008, 2009, 2010, 2015 under the prior owner, 711.24 with interest)",
  "prior_owner_deed_of_trust_expiry": "search the ROD under the prior individual owner AND under the beneficiaries of any deed of trust they gave; read an uncancelled instrument's stated maturity from the image and apply G.S. 45-36.24(b): recorded before 10/1/2011 with a stated maturity -> lien expires 15 years after maturity (35 years after recording if unstated) and is 'conclusively deemed satisfied of record' unless an extension agreement or notice of maturity date was recorded first (918 Star: 2007 purchase-money DT 2312/502, balloon 5/1/2010, expired 5/1/2025)",
  "cross_collateral_note": "a purchase-money note larger than the stamped price can be cross-collateralized (918 Star: 38,000 note on a 15,000 deed, 'also secured by a Deed of Trust recorded in the Edgecombe County Registry'); read Exhibit A before calling the stamps wrong",
  "street_lien_density": "count the street's parcels on the county's lien advertisement as a blight metric (Star St: 21 of 55 = 38 percent for 2024 taxes); the Nash list is DocumentCenter/View/4578 and is replaced in place each year (the current file is the 2024 liens)",
  "chimney_and_roof_scope": "compare dated Street View frames with the listing frames for removed chimneys, changed roof covering and porch rebuilds: each is permit-scope structural work (918 Star: two brick chimneys in 2012, 2022 and 2024 frames, none in 2026)",
  "munis_zone_field": "the Munis piah_new_zone / picv_zone code (R010 on 918 Star's 2005-2024 records) is a system default, not a zoning determination; use the zoning layers and the letter"
 },
 "nc_lien_limitation_statutes": {
  "_note": "Read 9/25/26 (round 13).",
  "gs_105_378_a": "no county or municipality may enforce a tax lien 'unless the action or procedure is instituted within 10 years from the date the taxes became due'; (b) does not apply to special assessments",
  "gs_45_36_24_b": "pre-10/1/2011 security instruments: lien expires 15 years after a stated maturity (35 years after recording if unstated) and the instrument is 'conclusively deemed satisfied of record pursuant to G.S. 45-37' unless extended by a recorded lien maturity extension agreement or notice of maturity date before expiry",
  "gs_44a_11_1_a": "lien agent designation required where the improvements cost 40,000 or more (owner-occupied single-family exemption only)",
  "gs_160d_1110_c": "the 40,000 no-permit exemption is for a single-family residence and never covers load-bearing, plumbing design, HVAC or electrical changes; a duplex has no exemption"
 },
 "forsyth_instruments": {
  "_note": "Adopted 9/25/26 (round 14, 306 Auburndale). Advisory 51's endpoints reproduced and extended.",
  "property_card": "https://lrcpwa.ncptscloud.com/api/SimpleParcelSearch?query=<address or PIN or owner>&pageIndex=0&pageSize=10 and /api/getParcelDetails?ParcelId=<PARCEL_PK>; header X-Tenant: forsyth (land class, building description, story height, effective year, additions with areas, interior adjustments, deeds with image URLs, photo date, values, neighborhood text); /api/GetParcelImage?ImageType=Photo|Sketch&ParcelId=<pk>&BuildingPk=<bpk> ('Photograph' returns 400)",
  "tax_bills": "https://bcpwa.ncptscloud.com/api/SimpleBillSearch?query=<PIN with dashes and .000>&pageIndex=0&pageSize=20 (twenty bills 2007-2026 with status); /api/GetbillDetails?BillId=<id> (line items by rate and district, realValue, dueDate, interestBeginDate, lastPaymentDate, interestPaid, transactions with paidBy and processedBy: DPC, LOCKBOX / DPC, EPAY / DPC, MORTGAGE = escrow servicer); /api/GetBillHistory?BillId=<id>; header X-Tenant: forsyth",
  "deed_images": "http://forsythdeeds.com/view_image.php?file=re/<6-digit book>/<6-digit page>.tif&type=pdf (image PDFs, no text layer; render with PyMuPDF and read as images); the county deeds array carries the URLs; a no-stamp deed is not a purchase (306 Auburndale's 2001 instrument was an LLC-to-member multiple-tracts transfer)",
  "layers": "https://maps.co.forsyth.nc.us/arcgis/rest/services: NCPTS/PWA_table/MapServer/1 (assessment TABLE - query with a where clause on PROPERTYADDRESS or CURRENTOWNERNAME1; a geometry query ignores the point and returns the first 50,000 rows) and /0 (tax polygons: TAXPIN, PARCEL_PK, BLK, LOT); Addressing/Master_Address_Repository/MapServer/0 (ADDRESS, UNIT, UNITTYPE, LANDUSE_DESC, INSP_LU_DESC, created_date, last_edited_date, CO_DATE, DEMO_DATE); Planning_Inspection/Planning_Inspection/MapServer 0 corporate limits, 1 zoning, 2 jurisdiction, 3 ZIP, 4 NRSA, 5/15 growth management 2030/2045, 6 parks, 7 wards, 8 inspectors by work area, 9 Opportunity Zones, 10 zoning history (DOCKETNUMBER, ZONEFROM/TO, FINALACTION, Laserfiche link), 11 historic signs, 12/13 National Register, 14 markers; FC_Annex_History/0; Locally_Zoned_Historic_District/0; Development_And_Permits/0 (calendar 2021 only); TaxReappraisal/PERMITS/1 (11/2017-9/2019); Tax/SalesApp/0 (misses street sales); WS_CommDev/DQ_Parcels_and_City_Owned_Parcels/0 (Feb-2019 delinquency snapshot, TotalAmoun); Foreclosures/Foreclosures_WebMap/11 (bank foreclosures 2010-2021 with lender and amount); Housing/Institutional_Home_Buyers/7-9 (investor, institutional, megafirm buyers); Environmental/Environmental_Planning_Inspection 0 floodway, 1 flood zone, 2 streams, 3 watersheds; Stormwater/SW_Reference/0 (pipes); WSPD/WSPD (beats and districts only, no incidents); imagery Imagery/Imagery_2022, ORTHOS_2018_NEW, ORTHOS2005, Imagery/Imagery_1968, Imagery/Imagery1951 (export with bbox)",
  "rates": "https://www.co.forsyth.nc.us/Tax/taxRates.aspx (county 0.5540, Winston-Salem 0.5890 for 2026; city vehicle fee 30); revaluation page /Tax/revaluation.aspx (2025 reappraisal; NC eight-year statutory maximum; the county runs four years)",
  "permits_city": "BuildIT https://buildit.cityofws.org/wsfcpermit (guest access to permit search, inspection comments and status behind an hCaptcha; records from about 2019); pre-2019 permits by records request to the Inspections Division (city-county for all of Forsyth except High Point, Kernersville, King); GeoCivix winston-salem.idtplans.com for plan submission (account)",
  "zoning_letter": "Administrative Letter - Zoning: Planning and Development Services, Suite 328, 100 East First Street, (336) 727-2624; request by email (residential yolandap@cityofws.org, commercial jeffv@cityofws.org); 50 per letter paid after preparation; 10-12 business days; covers zoning, open cases, variances and permitted use - ask explicitly for nonconforming status, 9.2.9B registration and rebuild rights (instruction sheet cityofws.org/DocumentCenter/View/20295; Inspections fee schedule DocumentCenter/View/1012)",
  "udo": "https://www.udoclearcode.org/_files/ugd/eea745_e5a7fcf655484924a9e21c2ddc7d542a.pdf (799 pages; footer LAST UPDATED; amendment history pages 11-12; Table 5.1.1 page 269; 5.3.4B pages 389-390; 9.2 pages 677-685; definitions 726, 729, 755; enforcement 705); the city web table (wshome.cityofws.org/1593) lags the PDF; Planning Board agenda books at cityofws.org/DocumentCenter/View/37064 (current month)",
  "voucher_standards": "ASPIRE (formerly HAWS) https://aspirews.org/hcv-downloads/ (Payment Standards by Zip Code xlsx, SAFMR pdf; January 1 effective dates adopted at the October board meeting)",
  "utilities": "City of Winston-Salem User Rate & Fee Manual (cityofws.org/1318/Rates -> DocumentCenter/View/38803 for FY27): water and sewer readiness-to-serve and consumption tiers, inside-city standard rate; residential refuse is tax-funded",
  "coverage_warnings": "Tax/SalesApp misses 2024-2025 Auburndale sales and carries null addresses; Development_And_Permits holds calendar 2021 only; TaxReappraisal/PERMITS holds 11/2017-9/2019; the NCPTS deeds array can omit an intermediate conveyance (306 Auburndale: the 1998-2001 Kings-to-LLC deed); the county card's totalUnits field is blank for converted houses"
 },
 "ws_udo_rules": {
  "_note": "Read verbatim 9/25/26 from the ClearCode PDF LAST UPDATED 8.17.26 (round 14). Re-check the footer at each use.",
  "table_5_1_1_duplex": "Z in RSQ, RM5, RM8, RM12, RM18, RMU, NO, LO, NB, PB, MU-S; P in E; blank in YR, AG, RS40, RS30, RS20, RS15, RS12, RS9, RS7 and all commercial, industrial and LI/GI/CI/IP/C cells",
  "sec_9_2_9_B_W": "converted buildings in RS/RSQ: pre-7/6/2004 conversions register 1/1/2008-1/1/2009 (kitchens, baths, access, electrical meters, units per floor, occupants) and are discontinued or brought into compliance by 1/1/2012 unless the council lengthened the period; failure to register and any post-7/6/2004 conversion = violation under 10.2 (100 per day after a five-day notice)",
  "definition_converted": "originally a detached single-family dwelling unit, 'modified, expanded, reconfigured or reconstructed in part or in its entirety into one or more occupiable separate living units' and not meeting the single-family or family definitions",
  "definition_dwelling_unit": "one or more rooms for one family with common access, kitchen and bathroom facilities 'and a single electrical meter'",
  "family_structural_evidence": "separate double-key bedroom locks, multiple mailboxes, locked or partitioned inside stairwells or doors, separate electrical meters, separate kitchens, multiple exterior entrances = evidence of no single housekeeping unit",
  "sec_5_3_4_B_2_W_adu": "attached ADU by zoning permit: subordinate to the single-family principal use; 'b. RESERVED'; at most 50 percent of heated floor area and 1,000 sf; all accessory uses within 50 percent; no added parking; one ADU per lot; height within the principal; no owner-occupancy or single-meter clause (UDO-CC15, 2/7/2022 city, 4/7/2022 county)",
  "sec_5_3_4_B_1_F_adu": "county version adds: no alteration to appear as multiple-family from the street (no multiple entranceways, mailboxes or nameplates), access by existing doors, no new street-facing stairways, 'Electric and/or gas utilities shall be supplied to both units through a single meter'",
  "sec_9_2_1_A": "nonconforming only if not permitted in the district AND existed in the city on 9/16/1968 (county 4/3/1967) or legally existed at a later effective date, and continues",
  "sec_9_2_8": "discontinuance for more than one year for any reason ends the status; intent is not a factor; active building permit within a year and CO within two preserve it",
  "sec_9_2_3": "one expansion of up to 25 percent by BOA special use permit; burden of proof on the applicant",
  "sec_10_2_1_B_W": "civil penalty 100 per day after a five-day correction notice; injunctive relief through the city attorney; settlement only after all violations are abated",
  "amendments": "consolidated through UDO-CC36 (8/17/2026); CC37 PRD bufferyards pending; housing-choice amendments anticipated by staff (8/13/2026 minutes); no docket on RS duplexes or ADUs as of 9/25/2026"
 },
 "nc_adu_statute_2026": {
  "_note": "Read 9/25/26 (round 14) from S445v7.pdf on ncleg.gov; the codified G.S. 160D-917 page still read 'Reserved' on 9/25/2026.",
  "sl_2026_59_s44": "G.S. 160D-917: a local government 'shall allow the development of at least one accessory dwelling unit which conforms to the North Carolina Residential Code ... for each single-family detached dwelling in areas zoned for residential use that allow for development of single-family detached dwellings'; shall not prohibit separate-household long-term rental of the primary and the ADU, require conditional zoning, set parking requirements, prohibit connection to the primary's utilities (capacity permitting), charge fees above a single-family permit, or set a size cap under 800 or over 1,000 sf; may require a 10-ft (or smaller district) setback, side-or-rear placement and that the ADU be smaller than the primary; exempts private covenants, historic districts, National Historic Landmarks and units without water and sewer; applies to non-coastal cities of 50,000+",
  "dates": "subsection (a) effective 1/15/2027 for applications on or after that date; implementing regulations due 7/1/2027, failing which ADUs 'shall be allowed in that local government without any limitations'",
  "campaign_reading": "the statute legalizes ONE ADU with a single-family house, not a duplex; under gate3_two_family_rule (Najum, 9/25/2026) an SFR + ADU does not pass Gate 3, so the statute matters to the campaign only as an owner-occupant exit that supports a seller's price, and as a resale route, never as a pass path",
  "sl_2026_39": "G.S. 160D-702(c) from 1/1/2027: no minimum dwelling square footage and no minimum off-street parking counts in development regulations (coastal exceptions)",
  "sl_2026_59_s42": "G.S. 160D-108(d): statutory vesting for a nonconforming use expires after 24 consecutive months of intentional and voluntary discontinuance, tolled by BOA/court proceedings and emergency declarations"
 },
 "aspire_payment_standards": {
  "_note": "Read 9/25/26 (round 14). The Housing Authority of Winston-Salem operates as ASPIRE (haws.org redirects to aspirews.org).",
  "effective_2026_01_01": {
   "27104": {
    "0BR": 1160,
    "1BR": 1260,
    "2BR": 1440,
    "3BR": 1880,
    "4BR": 2220,
    "5BR": 2553
   },
   "basis": "100 percent of the FY2026 SAFMR (Resolution 2302, 10/14/2025 board)"
  },
  "effective_2025_01_01": {
   "27104": {
    "0BR": 1210,
    "1BR": 1265,
    "2BR": 1485,
    "3BR": 1947,
    "4BR": 2288
   },
   "basis": "110 percent of the FY2025 SAFMR; hold-harmless rule keeps a standard at its level until the SAFMR catches up"
  },
  "fy2027_expectation": "October 2026 board, 1/1/2027 effective; at 100 percent 27104 2BR = 1,590; band 1,431-1,749",
  "portability_caps": {
   "0BR": 1660,
   "1BR": 1730,
   "2BR": 1900
  }
 },
 "wsfc_utility_rates_fy27": {
  "_note": "City of Winston-Salem User Rate & Fee Manual FY2026-27 (effective 7/2026), standard inside-city rate, read 9/25/26.",
  "water_rts_monthly_5_8": 8.14,
  "sewer_rts_monthly_5_8": 10.59,
  "water_per_cf": {
   "0-401": 0.0279,
   "402-936": 0.0432,
   "937-20052": 0.0478
  },
  "sewer_per_water_cf": 0.0507,
  "two_units_one_meter_annual": "8-10 CCF a month = 1,053-1,281 a year; the campaign line is 1,150",
  "service_initiation": 30,
  "deposit_max": 150,
  "refuse": "tax-funded residential collection; no owner-side line"
 },
 "advisory_51_rules_adopted": {
  "_note": "Adopted 9/25/26 (round 14, 306 Auburndale). Advisory 51's seven pipeline suggestions (forsyth_instruments, ws_udo_rules, the Winston-Salem rate, the RS two-unit check, the ADU pathway check, two DSCRs for ADU cases, the bill-payer read) are accepted; the entries below are what the verification added.",
  "ws_rs_two_unit_check": "before accepting a two-unit label in a Winston-Salem RS district, read the card land class, building description and effective year and the address repository UNIT field; an SFD card with a two-unit listing is a 9.2.9B converted-building case; a sub-address point created inside 1/1/2008-1/1/2009 is weak evidence of a registration (309 Auburndale)",
  "adu_pathway_check": "before any Z-FAIL is final, read the jurisdiction's ADU section AND G.S. 160D-917 (S.L. 2026-59 s.44, 1/15/2027) for cities of 50,000+, but under gate3_two_family_rule (9/25/2026) an ADU route is context, not a Gate 3 pass: carry Z-CURABLE-ADU with the lender note only, and look for a lawful-nonconforming-duplex path or a rezoning before spending agent time",
  "two_dscrs_for_adu": "carry lender-style DSCR with the principal rent only beside the both-rents figure; Fannie B3-3.8-02 (9/2/2026) counts ADU rent only for a one-unit principal residence, so an investor's loan qualifies on the property's own 1007 rent",
  "bill_payer_read": "on every NC row read the county bill API for payers, payment dates and interest paid across all years served (Forsyth serves twenty): a servicer payer proves an escrowed loan; repeated post-interest-date payments are a liquidity signal (306 Auburndale: five of the last eight)",
  "rental_history_before_proxy": "search HotPads, Trulia, Zillow and SERP for '<address> #<unit>' before carrying any SAFMR proxy: a unit's own recent ask is the documented rent for gate6_basis_rule (306 Auburndale lower unit 850 with water, 12/2025-3/2026)",
  "utilities_in_the_ad": "read the rental ad's utilities line ('Water is included and tenant is responsible for electricity') as the owner-paid-services source and price it from the city's rate manual",
  "seller_sibling_sales": "search the seller entity's other parcels for 2026 listings and closings (homes.com and Redfin detail pages serve via Apify): shared list days, shared cut days and the accepted discount to list are the seller's demonstrated floor (Big South: 74-76 percent of list twice)",
  "deed_chain_gaps": "when the county deeds array shows a 'price null' transfer, read the image: an LLC-to-member no-consideration deed means an earlier deed into the LLC is missing from the county chain; search the ROD index under the LLC",
  "effective_year_field": "the NC CAMA effective year is a reappraisal-cycle field-review construct, not a permit or conversion date; use the bill value series to date the reviews",
  "assessment_table_query": "the NCPTS PWA_table layer 1 is a table: query by where clause; a geometry query returns the first 50,000 rows"
 },
 "gate3_two_family_rule": {
  "_note": "Najum's answer of 9/25/2026 to the framework question raised by advisory 51 / file 44 (306 Auburndale).",
  "rule": "Gate 3 (true duplex) requires a TWO-FAMILY classification of record or by written zoning determination: two dwelling units lawfully permitted or lawfully nonconforming as a two-family use. A legal single-family house plus one accessory dwelling unit (attached or detached, under a local ADU section or G.S. 160D-917) does NOT satisfy Gate 3.",
  "consequences": "Z-CURABLE-ADU is not a pass path; carry it only as context. A converted house in a single-family district passes Gate 3 only on a written lawful-nonconforming-duplex determination (with the rebuild right stated, per lender_property_screen.fannie_rebuild_rule) or after a rezoning to a district where duplexes are permitted. Rows whose only two-unit status is an ADU route go OUT unless a two-family path exists.",
  "applied_to": [
   "r6b 306 Auburndale (9/25/2026): OUT, P 0.005",
   "2 Daughtry (9/25/2026): the Rocky Mount Sec. 507.C ADU fallback is context only; verdict and P 0.03 unchanged (chain rests on the two-family determination)",
   "w5 Gilmer (9/25/2026): PASS on the county's DUPLEX land-use classification (120) plus two E911 points in R-6 High Density (city layer); the 1986 R-6 use table is unread and the zoning letter must state the rebuild right",
   "w6 Church (9/26/2026): PROVISIONAL - county DUPLEX/TRI/QUAD + two Town address points + two E911 points + two water meters give a two-family classification of record, but RMD has prohibited duplexes since 4/15/2024; a formal determination (500) of lawful nonconformity is the pass condition, and 5.6.7 denies the rebuild right regardless"
  ]
 },
 "granville_oxford_instruments": {
  "_note": "Adopted 9/25/26 (round 15, 503 Granville St). Advisory 52's endpoints reproduced and extended.",
  "parcel_layers": "https://services8.arcgis.com/dT3Tew5pivPd2bWH/arcgis/rest/services/Granville_Service/FeatureServer/8 (Parcels_Polygon: PIN, MAPN, OwnerName1/2, mailing address, FormattedPropertyAddress, LegalDescription, DeedDate, DeedBookPage, SalePrice, Building/Land/Assessed values, TaxCode01-05 (C county, CI58 Oxford, SW45 solid waste), PRC = card URL; Zoning null inside Oxford; query by UPPER(FormattedPropertyAddress) LIKE) and /0 AddressPoints (SITUSADRS, Unit_Numbe, AddrNum_Su, ESN, IncMuni); Granville_Static/45 OxfordZoning2024, /39 City_of_Oxford, /42 City_Limits, /38 ETJ2025, /26 GC_ZONING (county), /31 Census_tracts; Granville_Flood/0; Granville_Water_Sewer (WTPPoints, valves, manholes, lift stations, mains) and 911_system (Water_Lines, Sewer_Lines, Sewer_Points) cover the COUNTY system only - empty inside Oxford; Neighborhoods/0 (county neighbourhood code by parcel; 013 = Oxford City Marginal)",
  "appraisal_card": "http://tax.granvillecounty.org/ITSPublic/AppraisalCard.aspx?id=<12-digit MAPN> - a PDF generated per request (0.8-3.6 s each on 9/25; bulk runs throttle); text-extractable with PyMuPDF: use class (01 SNG FAML, 02 TWO FAML, 74 MORTUARY, 44 CLBHOUS), STHT, sketch string, grade, heat/fuel, AYB/EYB, condition, deed book/page/date/price, plat book/page, land lines, notes (e.g. 'Interior Remodel for 2025', 'GRANVILLE ST PARK 96/100 ACRES', 'WB 72,E,83')",
  "tax_bills": "http://tax.granvillecounty.org/ITSPublic/TaxBillSearch/Parcel/<MAPN> loads a grid by POST to /ITSPublic/TaxBillSearch/GetSearchTablePartial/ (JSON model of the search fields; captcha-free; the in-app browser renders it): year, bill number, account, owner names (heirs shown as HEIRS), description, levy, balance, paid/pay; bill detail by POST /ITSPublic/TaxBillSearch/ViewTaxBill {taxYear, billNumber}; twelve years shown (2015-2026)",
  "rates_and_reval": "https://www.granvillecounty.org/303/Tax-Rates-within-Granville-County (county, fire district, Oxford, Butner, Creedmoor, Stovall, Stem; asterisk = unchanged) and /258/Revaluation (six-year cycle statement; 2018, 2024, 2030)",
  "register_of_deeds": "http://www.granvillecountydeeds.org/External/LandRecords/protected/v4/SrchName.aspx (Cott Systems eSearch 1.7.29; Guest User; click Acknowledge on the 2012 terms first; Quick Name (last/first, side, human/nonhuman, index CRP/FIN/PLT/REL, date range), Advanced Name, Property, Book/Page, File Number, Date Range, Index Books 1746-1977; results show date, kind (DEED, DEED OF TRUST, SATISFACTION), grantor, grantee, description (e.g. 'OX TP GRANVILLE ST S/S & MIMOSA PT LT 18 & LT 19 ST PB 2/24'), book/page, cross-reference, image page count; a scripted GET redirect-loops - use the in-app browser; JavaScript-set fields and JavaScript clicks on the ASP.NET buttons work; images not opened as guest this pass)",
  "permits": "Granville County Building Code Enforcement issues building, electrical, mechanical and plumbing permits county-wide including inside Oxford (919-603-1326); iWorQ portal https://granvillecounty.portal.iworq.net/GRANVILLECOUNTY/permits/602 (building permits: permit #, date, contractor, parcel address, description, project, sq ft, expiration, final), /603 (archived certificates), /600 and /601 (zoning permits); search select + text + Search button behind an invisible reCAPTCHA (form GET with g-recaptcha-response): real clicks in the in-app browser pass, JavaScript clicks return 'identity could not be verified', a scripted GET returns the unfiltered table; Oxford's own Planning Department issues zoning permits (2024 fee schedule) and enforces minimum housing / the IPMC",
  "city_documents": "oxfordnc.org: UDO PDF (2021-07-01 - Approved Oxford 160D UDO.pdf), 2024 Planning Zoning Fees (003).pdf, Document center/Permits applications Forms Fee Schedule/Utility Services/MONTHLY WATER AND SEWER RATES 7-1-2019.pdf and UTILITY_DEPOSIT_SCHEDULE_ADOPTED_7-1-17.pdf, System Development Fees.pdf (Raftelis draft 4/22/2020, scanned), the IPMC ordinance PDF, water_quality_report.php (2024 CCR text), newslist.php (budget book as .pub, RFQs, bids); the FY2026-27 adopted budget is a Publisher file that returns 403 - no rate table is fetchable; code at codelibrary.amlegal.com/codes/oxfordnc (Chapter 21 water; Appendix A tap rates; 5-61 housing code; 14-13 parks)",
  "historic": "oxfordhpc.org (overview, map-of-historic-districts.html with two jpg maps at /uploads/1/5/2/5/15256098/2072471.jpg and 3204656.jpg, HPC ordinance amended 7/8/14, demolition-by-neglect ordinance); NR nominations files.nc.gov/ncdcr/nr/GV0521.pdf (original) and GV0972.pdf (2020 boundary increase)",
  "vouchers": "https://www.doa.nc.gov/divisions/american-indian-affairs/section-8-housing-choice-voucher-program (NCCIA; counties served); county Housing Resources sheet granvillecounty.org/DocumentCenter/View/1758 (updated 8/2025); Oxford office 146 Main St 919-693-2456; pre-applications at the PACT Center, Oxford Housing Authority, 105 Hillside Dr; payment standards not online",
  "water_and_sewer": "NC DWR LWSP https://www.ncwater.org/wudc/app/lwsp/report.php?pwsid=02-39-010&year=2024 (connections, purchases, rate-structure description); EPA ECHO NC0025054 (WWTP) and NCL025054 (biosolids); KLRWS henderson.nc.gov/departments/public_utilities/kerr_lake_regional_water_system; S.L. 2025-4 (HB 74) clawback",
  "coverage_warnings": "the county's utility layers do not carry the City of Oxford system (meter counts unresolvable by GIS); the county AddressPoints layer creates unit points only where a unit is addressed (507 B exists, 503 has none); the parcel layer's SalePrice/DeedDate lag the card (505: 2022 on the layer, 10/2024 on the card); Google indexes no local press for Oxford budget or rate news; huduser FY2027 summary pages 404 (use the FY27 files); Zillow is KYC-blocked on the connectors (the in-app browser may load it)"
 },
 "oxford_udo_rules": {
  "_note": "Read verbatim 9/25/26 (round 15) from the 2021-07-01 UDO PDF.",
  "use_table_2_4_3": "Dwelling, Duplex = P in GR5, GR10, O&I, CBD, RMU, NMU; '-' in RA, GR3, NB, HB, IPD, LI, HI, CMU; Multi-Family P in GR10, O&I, CBD, RMU, NMU, CMU; Accessory Dwelling PS in RA, GR3, GR5, GR10, O&I, CBD, RMU, NMU, CMU",
  "table_2_3_1": "density max RA 1 / GR3 3 / GR5 5 / GR10 10 / O&I 10 du per acre (footnote: subject to overlay standards); lot area min RA 25,000 / GR3 10,000 / GR5 8,000 / GR10 5,000 sf; width 80 / 70 / 60 / 50 ft; street setback 30 (RA) / 20 (GR) / 25 (O&I); side 15 / GR3 15 / GR5 10 / GR10 10; rear 35 / 25 / 25; height 35 ft",
  "chapter_13": "13.5E 120-day discontinuance of a nonconforming USE (vacancy counts; historic-district contributing structures and single-family dwellings excepted); 13.6 nonconforming STRUCTURES continue, no enlargement, must conform if moved; 13.7 repairs to nonbearing walls, fixtures, wiring or plumbing capped at 20 percent of the buildings' assessed value per 12 months, no increase in cubical content; 100 percent destruction -> conforming rebuild, lesser damage may be rebuilt; unsafe-building strengthening always allowed; 13.8 later amendments governed by the chapter; 13.9 SUP uses are conforming",
  "campaign_reading": "a duplex in GR5 is a permitted USE, so 13.5E cannot reach it; the only exposure is density (5 du/acre) read as a structure nonconformity under 13.6 with the 13.7 repair cap and one-unit rebuild; the UDO has no lot-of-record or existing-building density exemption; the zoning letter (75, Planning 919-603-1117) must state the rebuild right (Fannie B4-1.3-04)"
 },
 "oxford_ipmc_2024": "Ordinance 26-01-5.5 adopted 1/13/2026, effective 2/13/2026: the 2024 International Property Maintenance Code adopted by reference for all properties; Planning Department = code official; fees by resolution; administrative search warrants; civil infractions 100-500 (first) / 500-1,000 (subsequent) per day plus costs; stop-work orders; weeds over 6 inches; no rental registration or periodic inspection; complaint-driven (Antwan Rice 919-603-1116). Campaign use: an MLS 'No heating' field in Oxford is an IPMC 602 exposure as well as a G.S. 42-42(a)(8)h item",
 "oxford_water_code": {
  "21_36_B_2": "'When two or more houses or units are connected with the same water lateral, a separate meter shall be provided for each house or unit' - one meter per unit is the city's rule; a single-meter duplex is a code item, not only a cost",
  "taps": "Appendix A: 3/4-inch meter tap 550, 1-inch 625, 1.5-inch 725 (Ord. 01-3-2, 3/13/2001); sewer 4-inch tap 500",
  "sdf": "Raftelis draft 4/22/2020 per ERU (300 gpd): water 687 buy-in / 496 marginal / 1,181 combined; wastewater 225 marginal / 1,800 combined; a new draft noticed 10/22/2025; adopted schedule unposted",
  "accounts": "deposit 200 (residence, 7/1/2017), lease required for renters; bills due the 10th, 10 or 1.5 percent late after the 12th, cut-off the 22nd, 25 reconnect-list fee; inside rates inside the corporate limits (21-44); last posted rate PDF 7-1-2019 (min inside bill 43.35); FY2026-27 rates unverified (budget posted as .pub)"
 },
 "nccia_vouchers": "NC Commission of Indian Affairs (NC DOA) is the HCV PHA for Granville, Person, Warren, Hoke and Sampson counties (Halifax and Columbus by agreement); about 930-997 vouchers; Granville waiting list closed since 5/19/2016 (one-day opening; 2014 before that); Oxford office 146 Main St 919-693-2456; PACT Center at Oxford Housing Authority 105 Hillside Dr; payment standards and utility allowances not published (ask); FY2027 Granville County FMRs 0BR 1,036 / 1BR 1,114 / 2BR 1,213 / 3BR 1,465 / 4BR 1,835 (non-metro; no SAFMR applies; ZIP 27565 SAFMR 1,140 informational)",
 "granville_revaluation": "six-year cycle per the county (2018, 2024 after a 2020 NCDOR notice, next 2030); 503 Granville +75 percent in 2024; neighbourhood 013 Oxford City Marginal factor 1.00",
 "oxford_klrws_rate_risk": "Oxford buys all water from Kerr Lake Regional Water System (2.0 MGD contract to 2047; 4.0 MGD from 2030); the 109-million plant expansion (10 -> 20 MGD) lost its 10-million 2023 state appropriation to S.L. 2025-4 (HB 74, signed 5/14/2025; four other projects funded); the city manager (5/2025) said the cost would pass to ratepayers; restoration unknown; treat Oxford water/sewer rates as rising above trend in any owner-paid scenario",
 "advisory_52_rules_adopted": {
  "_note": "Adopted 9/25/26 (round 15, 503 Granville). Advisory 52's six pipeline suggestions are accepted with two amendments; the entries below are what the verification added.",
  "nc_tax_line": "replace max(bill, 1 percent of price) with the CURRENT-YEAR bill where the county grid serves (Granville: the 2026 bill posted in August carries the new city rate) plus a revaluation-year stress line; advisory 52 used the prior-year bill and missed the 3-cent city step",
  "heat_status": "parse the MLS Heating field from every listing copy (Redfin, Coldwell Banker, realtor.com carry it); 'None' is a legal item (G.S. 42-42(a)(8)h) and, where a city has adopted the IPMC, a civil-infraction item; carry heat_status on the row",
  "meter_rule": "before pricing an owner-paid water scenario, read the city code's separate-connection / separate-meter section (Oxford 21-36(B)(2)); a one-meter duplex may be a code item; carry meter_count, owner_paid_utilities and second_meter_cost (tap + SDF + plumbing)",
  "lease_term_field": "read the MLS Rental Information block (Lease/Rent Term) on every copy; MONTH TO MONTH changes the delivery, the ledger and the G.S. 42-14 notice",
  "fmr_areas": "for every NC county row read the FY27 FMR file's hud_area_code and metro flag; label the row with the FMR area name; SAFMRs exist for every ZIP in the file but govern only in metropolitan areas (mandatory metros or PHA opt-ins); non-metro rows carry the county FMR by bedroom size and the ZIP SAFMR as informational",
  "duplex_sale_comps": "Redfin city filter property-type=multifamily,include=sold-5yr as the default duplex comp pull (advisory 52)",
  "nr_inventory_check": "NC HPO nomination PDFs (files.nc.gov/ncdcr/nr/<GV number>.pdf) by address (advisory 52), PLUS the local HPC's district maps (local districts are smaller than the NR district in Oxford)",
  "permit_portal_first": "search the county or city permit portal by parcel address before crediting 'replaced within three years' work; no permit + a duplex (no 160D-1110(c) exemption) = an invoice-and-inspection ask",
  "rod_index_by_all_owners": "search the Register of Deeds index under EVERY record owner and the immediately prior owner; a chain with a satisfied prior deed of trust and no current deed of trust is 'free and clear of record' and lifts the seller-floor constraint",
  "park_and_neighbour_cards": "pull the cards of the parcels across the street and next door: a city park, a mortuary or an exempt use changes the block read (503 Granville: park at 500, mortuary building at 512)"
 },
 "advisory_53_rules_adopted": {
  "_note": "Adopted 9/25/26 (round 16, 307 S Jacob St Cherryville). Advisory 53's six campaign-level findings and six pipeline suggestions are accepted; the entries below are what the verification added or amended.",
  "lien_before_basis": "read the Register of Deeds index under the seller BEFORE writing a seller-basis line: an open purchase-money deed of trust sets the floor (Jacob: 125,000 of 175,000 financed; every 8 percent line sat at or under the payoff); a watch-price trigger should sit at the payoff plus costs, not at the basis",
  "stamps_confirm_price": "a portal 'Sold' price is confirmed when the deed image or index carries the excise (Jacob 350 = 175,000); the index row's Amount column is the excise, not the price",
  "county_photo_dates_condition": "pull the county assessor photo (wEdge ASRIMG/<year>) before reading a 'fresh' or 'new' condition item in MLS frames; the Jacob stump, paint, roof and piers all predate the seller",
  "public_power_meter_rule": "Cherryville 30-90(c)-(d) reproduced verbatim: a residence subdivided into two housekeeping units may not be served through one residential meter and the city installs individual meters; where the photos show one meter in a public-power town, read the municipal utility code and carry a second-service capex line",
  "gas_ldc_by_city_page": "take the gas LDC from the city's own infrastructure page (Cherryville: PSNC = Enbridge Gas NC), not from a regional assumption",
  "ring_ratio_table": "for every NC row in a reappraisal county build the ring's assessed-to-sale ratio table from the county transfer histories (2021+ priced sales): it shows whether the schedule over-values the subject's vintage and sets the appeal expectation for the next reappraisal",
  "duplex_sale_set_by_county": "Redfin's sold-multifamily filter is the discovery leg; the county transfer history is the price of record (Redfin printed 512 W Second's 118,500 as 1,000)",
  "pha_notices_page": "read the PHA's notices and annual-plan pages, not only the payment standard: GHA's 9/2026 notice signals downward standards and its FY2027 plan 'limited voucher issuance'",
  "pha_hqs_variations": "read the PHA's HQS acceptability variations: GHA requires 100 amps per dwelling unit, GFCI or grounding on three-prong receptacles, screens unless central air, R-19 ceilings and treated-lumber steps - each a make-ready line on a 1915 house",
  "deq_viability_scores": "check the SWIA/LGC viability assessment (item J-1/J-2) and the city audit's water-sewer fund unrestricted net position for every NC water-sewer city; a negative fund position without a distressed designation is a rate-pressure flag, not a designation",
  "permit_portal_blindness": "EnerGov CSS public search can return nothing for any address keyword (Gaston); test the portal with a known recent new build before treating an empty result as 'no permits'",
  "wedge_instrument": "DevNet wEdge (gastonnc.devnetwedge.com/parcel/view/<parcel>/<year>) answers by plain curl with values by year, billing and payment history, transfer history with book/page/type/price, the CAMA card, the assessor photo and the sketch",
  "ccs_rod_instrument": "Courthouse Computer Systems Register of Deeds sites: POST the serialized QueryFields_ExecuteSearch form to /LRSearch/ExecuteSearch (X-Requested-With) for the index grid; the Image index by book and page yields a /ProcessedImages/<stamp>.pdf that curl fetches (image-only; render with PyMuPDF)",
  "transport_0925j": "Bright Data connector 2b7b1243 (djnicholasaY) rejected credentials; Bright Data returned empty bodies for gastongov.com, cityofcherryville.com (Wix) and apartments.com unit pages; api.census.gov requires a key (302 to missing_key); Gaston GIS hosts (gis.gastongov.com reset the connection; gis.gastoncountync.gov has no REST); EnerGov CSS public search returns no results for any address keyword and its search API answers 500; the Register of Deeds detail endpoint (GetDetails) answers 500 outside the site's own session (the instrument images were read instead); NC SOS not attempted (Cloudflare ga"
 },
 "gaston_cherryville_instruments": {
  "_note": "Read 9/25/26 (round 16). All plain curl unless noted.",
  "wedge_parcel": "https://gastonnc.devnetwedge.com/parcel/view/<parcel>/<taxyear> (parcel 130688; tax years 2008-2027; data date printed in the footer)",
  "wedge_images": "/PropertyImages/ASRIMG/<year>/<image id>.JPG (assessor photo) and /PropertyImages/CAMA/<year>/<parcel>-1.JPG (Apex sketch); the image ids are in the parcel page HTML",
  "onemap_parcels": "services.nconemap.gov NC1Map_Parcels/MapServer/1: where cntyname='Gaston' (case-sensitive) AND siteadd LIKE '<num> <street>%' (FIRST/SECOND spelled out); altparno = the wEdge parcel; parusedesc 'Residential 2 Family'",
  "onemap_addresses": "services.nconemap.gov AddressNC/NC1Map_Addresses/FeatureServer/0 distance query (unit, unit_type, dateupdate)",
  "rod": "gastonnc.courthousecomputersystems.com: disclaimer Accept -> /LRSearch/LRIndex?searchTabID=0 -> POST /LRSearch/ExecuteSearch (form QueryFields_ExecuteSearch serialized; MultiNameLast, MatchType, CodeType 3, IndexType 3) -> results grid HTML (Date, Kind, Grantor, Grantee, Description, Book, Page, References, Amount = excise, Doc #, PIN); images: /Image/ImageIndex?SearchTabID=0 -> book + page -> /Image/ShowDocImage?...BookNum=&PageNum= -> viewer iframe file=/ProcessedImages/<stamp>.pdf (curl); GetDetails answers 500 outside the session",
  "permits": "selfservice.gastongov.com/energov_prod/selfservice (EnerGov CSS): public keyword search blind (no results even for a 2022 new-build duplex); API /api/energov/search/search answers 500; Building Inspections by phone",
  "county_budget": "gastongov.com/DocumentCenter/View/9277 (FY2027 adopted budget: rate ordinance Section II 59.9 cents; revaluation 2027 effective FY28); /1446/We-Value-Gaston-2027 (calendar); /920/Reappraisal-FAQs (four-year cycle adopted 2025)",
  "city_documents": "cityofcherryville.com: /planning-and-zoning (zoning ordinance text PDF cba8c4_830e979f..., zoning map PDF cba8c4_9b3cb30e..., TOC cba8c4_ea014653..., subdivision ordinance cba8c4_ba59eb78...), /city-ordinances (scanned chapter PDFs; Ch. 30 = 46faef_903db0ee..., Ch. 8 = 46faef_7eadb8cf...; three links mislabelled), /city-budets-and-audits (sic; budgets 2018-2027, audits 2018-2024), /utility-billing-explained, /service-connections, /sanitation-services, /infrastructure, /public-works; Wix pages serve to curl, not to Bright Data",
  "utility_billing": "municipalonlinepayments.com/cherryvillenc (utility billing since 8/4/2025); utilities office 704-435-1700; public works 704-435-1737",
  "deq": "deq.nc.gov/water-infrastructure/item-j-1-2025-distressed-score-and-status-summary-final-rev-9-15-25/open and item-j-2 (scores by unit); /water-infrastructure/vur-assessment-unit-list-sept-2022/open; /water-resources/pws/lead-service-line-inventory-july-2025/open; DSCA lists /waste-management/dwm/sf/dsca/active-and-inactive-drycleaner-facilities-pdf-february-2025/download and files.nc.gov/ncdeq/Waste%20Management/DWM/SF/DSCA/Remediation/NorthCarolinaContaminatedDryCleaningSites.pdf",
  "lwsp": "ncwater.org/wudc/app/lwsp/report.php?pwsid=01-36-030&year=2024",
  "echo": "echodata.epa.gov/echo/echo_rest_services.get_facility_info?output=JSON&p_fn=CHERRYVILLE&p_st=NC (facility names); dfr_rest_services.get_dfr?output=JSON&p_id=110000915528 (WWTP)",
  "pha": "ghanc.org (403 to curl; Apify web-fetch serves pages); PDFs by curl: /wp-content/uploads/2025/05/2025-5-GHA-Admin-Plan.pdf, /wp-content/uploads/2025/03/gha_hqs_acv-1.pdf, /wp-content/uploads/2026/05/Annual-Plan-FYB-10-1-2026-draft-Adobe.pdf; 704-349-5098"
 },
 "cherryville_utility_rates_fy27": {
  "_note": "City of Cherryville FY2026-27 budget ordinance schedules (proposed budget PDF; rider text 'Adopted June 8th 2026'), effective July 2026 billing.",
  "electric_residential_schedule_R": {
   "basic_facilities_charge": 13.05,
   "first_500_kwh": 0.11105,
   "next_500_kwh": 0.10974,
   "over_1000_kwh": 0.10482,
   "change": "+3 percent on usage rates; fuel charge and sales tax extra",
   "disconnection_fee": 50,
   "after_hours_reconnect": 25,
   "extension_fee": 25
  },
  "water": {
   "facility_charge_incl_first_1000_gal": 17.0,
   "per_1000_gal_over": 6.5,
   "outside_city": "double",
   "meter_3_4_inch": 350,
   "tap_3_4_inch": 1100
  },
  "sewer": {
   "facility_charge_incl_first_1000_gal": 17.0,
   "per_1000_gal_over": 6.5,
   "flat_rate": 36.5,
   "tap_4_inch": 1300
  },
  "sanitation": {
   "per_container_per_month": 17.0,
   "container_replacement": 75
  },
  "fees": {
   "application": 25,
   "transfer_to_landlord_name": 15,
   "late": "15 or 3 percent",
   "non_payment": 50,
   "deposit_good_credit": 250,
   "deposit_split": "100 electric / 100 water / 50 sewer",
   "deposit_bad_credit": "twice the 12-month average of the prior residence",
   "meter_damage": 250
  },
  "zoning_fees": {
   "two_family_dwelling_permit": 150,
   "remodel_no_expansion": 50,
   "addition": 75,
   "fence": 25
  },
  "tax_rate": 0.48,
  "owner_paid_one_account_estimate": 1600.0
 },
 "cherryville_electric_meter_rule": "City Code Sec. 30-90(c): 'Residential service to two or more residences on the same property or to a residence subdivided into two or more individual housekeeping apartments or units may not be supplied through one meter on the residential service schedule.' (d): 'Individual meters shall be installed by the city for each individual residence, housekeeping apartment or housekeeping unit.' 30-82: no resale. 30-76(a): the city furnishes meters. Read 9/25/26 from the scanned chapter (OCR checked against the page image).",
 "gaston_revaluation": "four-year cycle adopted 2025; last 1/1/2023 (307 S Jacob +193 percent; the county cut its rate 0.81 -> 0.61, below revenue-neutral), next 1/1/2027 effective FY2028 (notices February 2027, informal appeal 30 days from the notice, bills July 2027); FY2027 county rate 59.9 cents by ordinance; 1A022 ring assessed-to-sale ratios 0.73-1.53 (median 1.08)",
 "cherryville_water_sewer_fund": "FY2024 audit: Water and Sewer Fund unrestricted net position -2,891,233 (-324,436 in the year); Electric Fund +5,307,647; General Fund unassigned 38.4 percent; DEQ viability score 5 (2025), 7-8 (2021-2022), not designated distressed; 2022 State Reserve AMP grants 150,000 + 150,000; S.L. 2022-74 3,000,000; WWTP NC0044440 11 of 12 quarters with violations, no penalty; LSL inventory 1,602 unknown of 3,164 lines; NCMPA1 debt about 9.3 million to 2031",
 "gha_vouchers": "Gastonia Housing Authority administers the HCV for Gaston County (340 W Long Ave, Gastonia; 704-349-5098); admin plan 2/1/2025: 'located in a designated SAFMR area', no designated payment-standard areas; payment standards and utility allowances unpublished; 9/2026 notice: standards 'may be adjusted' down in certain ZIPs under funding limits and SAFMR rules; FY2027 plan draft: 'limited voucher issuance'; 2001 HQS variations: 100 amps per unit, GFCI/grounding, screens unless central air, R-19 ceilings, treated-lumber steps, no unvented fuel-burning room heaters; 28021 FY2027 SAFMR 1BR 1,020 / 2BR 1,120",
 "advisory_57_rules_adopted": {
  "_note": "Adopted 9/25/26 (round 17, 413-415 Gilmer Cir Reidsville, new board row w5). Advisory 57's seven campaign-level findings and seven pipeline suggestions (rockingham_ustaxdata, owner_portfolio, imagery_timeseries, relief_check, address_points, Redfin page parse, transport) are accepted; the entries below are what the verification added or amended.",
  "prior_listing_photo_diff": "diff the property's prior-listing photos (Redfin bigphoto CDN, photo/<mls>/bigphoto/<3 digits>/<mls>_N.jpg) against the current frames for MISSING equipment, not only for reused frames: the 2016 Gilmer frame shows two roof flues and a condenser that the 2026 frames lack (stripped HVAC); the average-hash test then separates provenance (0 = same photo) from change",
  "street_view_dated_captures": "photometa's dated list (SingleImageSearch pano -> photometa j[1][0][5][0][8] indexing j[1][0][5][0][3][0]; thumbnails at the bearing to the house) gives 2007-2026 occupancy and exterior history by plain urllib; Gilmer: 415 occupied in 3/2026 against 'both vacant' remarks in 9/2026",
  "seller_litigation_search": "search the seller entities' names on govinfo (USCOURTS opinions and metadata), Justia and PACER-monitor summaries before pricing: the Gilmer group is litigating a boarding-house code-enforcement dispute against Burlington in federal court (1:25-cv-00236; most counts dismissed 3/31/2026); a litigious seller is a negotiation and code-file signal",
  "county_budget_message_for_the_cycle": "read the county manager's budget message for the revaluation year and the assessed-to-market percentage (Rockingham: 'around 90.8 percent'; 'next revaluation effective for the Fiscal Year 2028/29'); NCDOR's rate table lags a commissioners' resolution (Rockingham 2029 -> 2028)",
  "rate_decomposition_by_bill": "decompose a combined bill with the prior year's known rates: Gilmer 2025 = 0.5801 + 0.66 to the cent and 2026 = 0.569 + 0.66 to the cent, which confirmed the county's 1.1-cent cut before any budget document was found",
  "hud_area_vs_cbsa": "a county carved out of a mandatory-SAFMR CBSA as its own 'HUD Metro FMR Area' (Rockingham METRO24660N37157) is NOT on the mandatory list unless named; the SAFMR is a proxy and the PHA sets standards on the county FMR (Reidsville NRHA: 110 percent of the FY2026 FMR)",
  "efc_rates_dashboard": "dashboards.efc.sog.unc.edu/dashboards/<year id>/chart_data?rate_structure_id=<id>&usage_amount=<gal>&service_type=water,sewer&comparison_group=all_rate_structures returns the utility's monthly bill schedule by usage step, effective dates, accounts, MHI and poverty (rate_structure ids are in the dashboard HTML option list); use it wherever a city's rate page is gated",
  "city_zoning_feature_service": "search ArcGIS Online (arcgis.com/sharing/rest/search q='<city> zoning type:\"Feature Service\"') before assuming a city has no GIS: Reidsville's org publishes zoning, historic districts and a parcel clip that answer point queries",
  "building_footprint_setback": "the NC Composite Building Footprints layer (NCEM) against the OneMap parcel polygon measures a wall-to-line distance in metres (Gilmer 0.46 m north); pair it with the ortho read",
  "ccs_evault_fallbacks": "when a Courthouse Computer Systems e-Vault's traditional view answers 500, the directory view (ResultsType=2) still returns document counts and keys and /Image/ShowDocImage?BookNum=&PageNum= still serves any instrument by book and page; use the county card's chain for book/pages and read the deed images; the instrument LIST stays unread",
  "duplex_cohort_by_use_code": "NC OneMap parcels where parusecode='120' (county duplex use code) -> saledatetx filter -> county cards for prices: a county-confirmed duplex sale cohort in one pass (Rockingham: 178 parcels, 70 sold since 2022, 19 qualified Reidsville sales)",
  "transport_0925gil": "Register of Deeds TRADITIONAL index (ExecuteSearch ResultsType 1, book/page search, GetTraditionalResultsView, GetDetails, PrintDocDetailsStyle: HTTP 500 all evening, scripted and in the in-app browser) - liens under the seller UNREAD; reidsvillenc.gov by curl and by Bright Data (Cloudflare / policy), staging host 403, site search returns nothing, sitemap blocked; the city's water-rate and budget pages not found (the EFC schedule substitutes); Rockingham eTRAKiT (county permits): parcel records open but the Permits/Inspections tabs load by callback and the permit search needs a public login - "
 },
 "rockingham_reidsville_instruments": {
  "_note": "Read 9/25/26 (round 17). All plain curl / urllib unless noted.",
  "tax_application": "https://www.ustaxdata.com/nc/rockingham/ -> disclaimer.cfm?agreement=I+Acknowledge (cookie jar) -> account.cfm|building.cfm|land.cfm?ownerID=<owner>&parcelID=<parcel>&groupParcel=<group>; rockinghamtaxlist.cfm?parcelNum=<parcel> (bills 2012+ with status); taxbill.cfm?ownerID=&billNo=&TaxYear=; Rockinghamlist.cfm?lastName=<owner>&Submit=Search (owner portfolio; businessName ignored); Deeds and Sales tabs 404",
  "property_card": "https://www.webgis.net/nc/rockingham/PropertyCard.php?pid=<parcel> (no cookie; sales history with instrument type, disqualification and price; components; sketch; land segment with zone code)",
  "onemap_parcels": "services.nconemap.gov NC1Map_Parcels/MapServer/1: cntyname='Rockingham'; parno = 12-digit PIN (890518312065), altparno = 6-digit parcel (154693); parusecode '120' = DUPLEX, '110' single family, '411' apartment; salprice EMPTY county-wide, saledatetx carries the date; ownname LIKE for portfolios",
  "rod": "https://rockinghamnc.courthousecomputersystems.com/ (Courthouse Computer Systems e-Vault; the old 72.15.246.181/RockinghamNCNW is dead): /LRSearch/LRIndex?searchTabID=0 form fields Last, Given, SearchType 3, MatchType beginswith, CodeType 3, IndexType 3, ResultsType 1 (traditional) / 2 (directory); POST /LRSearch/ExecuteSearch with X-Requested-With; on 9/25/2026 ResultsType=1, the book/page search, GetTraditionalResultsView, GetDetails and PrintDocDetailsStyle all answered 500 while ResultsType=2 served name rows with document keys ('1-<n>'); /Image/ShowDocImage?BookNum=<book>&PageNum=<page> -> viewer iframe file=/ProcessedImages/<stamp>.pdf (curl; image-only; render with PyMuPDF)",
  "city_gis": "ArcGIS Online org ReidsvilleGIS1873: https://services6.arcgis.com/F05wl398YvOrLJax/arcgis/rest/services/Reidsville_Public_Zoning_Map_WFL1/FeatureServer (0 Historic_Districts HIST_DIST OPR/GR; 1 Parcel_Boundaries_Clip with county fields; 2 Zoning_Districts ZONING); instant app reidsville-nc.maps.arcgis.com/apps/instant/sidebar/index.html?appid=b591ac3e34c74a3e8ee5885db75e5d76",
  "footprints": "https://services1.arcgis.com/YBWrN5qiESVpqi92/arcgis/rest/services/North_Carolina_Composite_Building_Footprints/FeatureServer/0 (distance query at the parcel centroid)",
  "city_code": "Municode client 9475, product 12368 (Code of Ordinances, Supplement 39): api.municode.com/Jobs/latest/12368 -> jobId 453132; codesToc/children?jobId=453132&nodeId=<node>&productId=12368; CodesContent?jobId=453132&nodeId=<node>&productId=12368 (Docs[].Content HTML); nodes PTIICOOR_CH4BUCOREAC_ARTIIHOCO (housing code), PTIICOOR_CH9HESA_ARTIINU (nuisances), PTIICOOR_CH10MUUTSE_ARTIIWASE_DIV1GE (water and sewer generally, 10-20 to 10-35+); the zoning ordinance is NOT in the Code",
  "city_site": "reidsvillenc.gov (CivicPlus behind Cloudflare): curl and Bright Data blocked; Apify vietaro stealth served /historic-preservation-commission, /planning-and-community-development/page/zoning-ordinance and /page/code-enforcement, /building-inspections-permitting, /finance on two runs and was blocked on the third; /search returns nothing; sitemap blocked; Planning 336-349-1066, Code Enforcement 336-347-2385, HPC COA form on Adobe Sign",
  "permits": "City of Reidsville Inspections Department (no online portal found); county eTRAKiT https://permits.rockinghamcountync.gov/etrakit/Search/parcel.aspx (ASP.NET postback: ddSearchBy Geo_Ownership.SITE_APN EQUALS <12-digit PIN> returns converted parcel records; the Permits / Inspections tabs load by RadAjax callback; /Search/permit.aspx needs a public login)",
  "pha": "https://www.newrha.org/section-8 (Wix; curl serves the HTML; payment standards in the page text; HCV 336-589-6511)",
  "water_rates": "https://dashboards.efc.sog.unc.edu/dashboards/251/chart_data?rate_structure_id=407&usage_amount=5000&service_type=water%2Csewer&comparison_group=all_rate_structures (Reidsville = rate structure 407; bill.water and bill.sewer by 500-gal step; rate_structure.bill_effective_date)",
  "county_budget": "https://files.municipalone.com/rockinghamcounty-nc/337014943052726pm.pdf (FY2027 recommended budget, 499 pages: budget message with the rate, tax base, revaluation cycle and fire-district table); county 'Tax Rates' page is navigation only; Citizen Portal articles carry the adoption facts",
  "deq_layers": "https://services2.arcgis.com/kCu40SDxsCGcuUWO/arcgis/rest/services/<name>/FeatureServer/0 distance queries: Underground_Storage_Tank_Incidents, RUST, AST_Incidents, NonUST, Pollution_Incidents_2019 (GW/SW risk ratings), DryCleaning_Contaminated, DryCleaning_Compliance, DryCleaning_City_Directories, Inactive_Hazardous_Sites, Pre_Regulatory_Landfill_Sites, Old_Landfill_Sites_2019, NCBP_Feature_Point_View / Brownfield_Boundary",
  "echo": "https://echodata.epa.gov/echo/dfr_rest_services.get_dfr?output=JSON&p_id=NC0024881 (WWTP); cwa_rest_services.get_facility_info?output=JSON&p_st=NC&p_fn=REIDSVILLE&responseset=50 (facility list)",
  "street_view": "SingleImageSearch (maps.googleapis.com $rpc MapsJsInternalService; body [['apiv3',...],[[null,null,lat,lng],50],...]) -> photometa/v1 pb string with the pano id -> dated list at j[1][0][5][0][8] over j[1][0][5][0][3][0]; thumbnails streetviewpixels-pa.googleapis.com/v1/thumbnail?panoid=&yaw=&thumbfov=&w=1200&h=800 (plain urllib)",
  "prior_listing_photos": "https://ssl.cdn-redfin.com/photo/150/bigphoto/<last 3 digits of the MLS number>/<MLS>_<n>.jpg (Referer redfin.com); current listing photos <MLS>_<n>_0.jpg",
  "court": "https://www.govinfo.gov/wssearch/getContentDetail?packageId=USCOURTS-ncmd-1_25-cv-00236 (metadata incl. party names) and /content/pkg/USCOURTS-ncmd-1_25-cv-00236/pdf/USCOURTS-ncmd-1_25-cv-00236-0.pdf (opinion); Justia and CaseMine are Cloudflare-gated"
 },
