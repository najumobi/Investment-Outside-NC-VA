   ],
   "sewer_tiers_per_kgal": [
    9.08,
    10.19,
    10.99,
    12.13
   ],
   "tier_breaks_gal": [
    3000,
    6000,
    9000
   ],
   "monthly_bill_0_1k_3k_5k_10k": [
    30.87,
    49.37,
    86.37,
    127.95,
    242.14
   ],
   "deposit": 200.0,
   "account_fee": 20.0,
   "late_fee": 25.0,
   "last_increase": "1/1/2025 (+17%)",
   "one_meter_two_units_owner_paid_est": 1535.0
  },
  "e911_convention": "one APT-typed point per duplex (205, 208, 306, 310 Scarborough); two points only for the four-unit 112/114; the APT type, not a second point, is the multi-unit marker",
  "fee_roll_trace": "refuse line = 396 x units (307 x units through 2023): a two-unit charge on the bill is the Town's own unit count",
  "finances": "LGC control 10/5/2021 - 8/1/2024; UAL 10/6/2025; sales tax withheld 9/9/2025 for late FY2022-2024 audits; DEQ distressed (2/4/2026 designations; score 1b on 2024 data); WWTP NC0030970 1.5 MGD, 2025 flow 59%, no penalties, NOVs 2024-2025; not on the DWR moratorium list; water from PWC and Harnett",
  "street_view": "SingleImageSearch (maps.googleapis.com/maps/api/js/GeoPhotoService.SingleImageSearch?pb=!1m5!1sapiv3!5sUS!11m2!1m1!1b0!2m4!1m2!3d<lat>!4d<lng>!2d50!3m10!2m2!1sen!2sUS!9m1!1e2!11m4!1m3!1e2!2b1!3e2!4m10!1e1!1e2!1e3!1e4!1e8!1e6!5m1!1e2!6m1!1e2&callback=cb) returns the current panoid; the photometa response for that panoid lists [year,month] pairs indexed 40, 41, 42 ... into its [2,'panoid'] list, which gives the historical panoids; thumbnails by streetviewpixels with a yaw computed from the pano to the parcel centroid"
 },
 "advisory_47_rules_adopted": {
  "deed_chain_first": "read the county CAMA deed chain (camapwa DeedDetails) before writing 'only the last price is known'; Cumberland carries stamps and prices to 1991 and the instrument kind (trustee's deed to the Secretary of Veterans Affairs = a VA foreclosure)",
  "lien_index_by_name": "a Register of Deeds name index that returns ONE instrument (the vesting deed) under an owner's name means no deed of trust of record; combine with the bill's lender tax-service column (empty since the purchase) before assuming a payoff floor",
  "density_rule_every_nc_row": "read the district's lot-area-per-dwelling-unit row and the lot-of-record exception (single-family-only relief is common); a 1940s duplex on a 50-ft platted lot is density-nonconforming in most NC small-town codes; carry the casualty (>50%) and remodel (>1/3) thresholds against the county RCN",
  "town_permit_authority": "check whether the municipality runs its own inspections department before reading a county permit layer as 'no permits' (Spring Lake, like Fayetteville, is outside the county layers)",
  "duplex_permit_statute": "G.S. 160D-1110(c)'s 40,000 threshold is single-family only; roof, HVAC and electrical claims on a duplex should have Town permit numbers",
  "street_view_equipment_dating": "read the oldest Street View frame with a condenser or window unit visible before accepting an HVAC install year",
  "fee_lines_on_county_bills": "NC county bills carry municipal fee lines without a rate column (refuse, stormwater): reconcile every line to Total Billed and read the municipal fee schedule for the per-unit basis",
  "deq_distressed_and_ual_both": "check the DEQ distressed-unit list (water/sewer) and the LGC Unit Assistance List (general finances) separately; Spring Lake is on both; the DEQ score sheet's 'b' marks missing audits",
  "e911_type_convention_varies": "the county E911 layer's multi-unit signal differs by municipality (Fayetteville: a second APT point; Spring Lake: one APT-typed point) - calibrate on the street's other duplexes",
  "voucher_ceiling_is_rent_reasonableness": "for one-bed units far under the SAFMR/FMR (795 vs 1,150/1,334), the voucher ceiling is the unassisted comp band, not the FMR",
  "advisory_numbering_collision": "when two advisory drafts carry the same number (46 Scarborough vs 46 Pinetops), the later-numbered re-issue governs (47) and the 46 copy is kept unmodified"
 },
 "gate6_basis_rule": {
  "_note": "Adopted 9/25/26 (advisory 48 campaign finding 7; Rogers 9/20 and Scarborough 9/25 already carried stated rents).",
  "rule": "Gate 6 is computed on the DOCUMENTED rent roll: the stated in-place rent for each occupied unit (lease, rent ledger, MLS 'actual rent' or seller text), and the block-comp median only for a vacant unit. The stabilized (all-comp) figure is reported alongside for the negotiation. A row passes Gate 6 only when the documented roll clears 8 percent cash-on-cash at 6.75 (the board's legacy constant) AND year-one cash-on-cash at 7.40 is not negative. In-place rents below 60 percent of the modeled rent are flagged on the row.",
  "applied_to": [
   "2 Daughtry (9/25 late): FAIL on 365 + 800",
   "13 Rogers (9/20): stated 750 + 835",
   "9 Scarborough (9/25): own ask 795 x 2",
   "21 Star (9/25 night): FAIL on 630 x 2 (both units vacant, block-comp median) and on the own ask 695 x 2"
  ]
 },
 "advisory_48_rules_adopted": {
  "mls_actual_rent_every_row": "read the Redfin property-details 'Income units ... reported actual rents' line on every row; the sweep's unit_rent_text was empty for Daughtry although the page carried 365 (pipeline: parse it into rent_in_place and flag below 60 percent of the modeled rent)",
  "rod_index_both_names": "search the Register of Deeds index under the ENTITY and under the individual(s) who conveyed into it: a deed of trust signed before an LLC contribution survives the transfer and never shows under the LLC's name (Daughtry: the 2005 deed of trust surfaced only under the individual and was satisfied 2007)",
  "second_deed_out_check": "an entity seller's index can carry a deed OUT recorded after the listing date (Daughtry: 1401 Hargrove sold 8/27/2026 while the subject sat listed): read every instrument after the list date before writing 'holds five parcels'",
  "county_lien_advertisement": "the county's annual Delinquent Tax Liens advertisement (Edgecombe: 20 pages, liens as of 1/6) lists every parcel by owner name: grep it for the seller entity and its principals; a WebPAAS 'Amount Due' on a prior-year bill plus a $4.00 advertising cost = advertised",
  "city_bills_separately": "Rocky Mount (and other NC cities that bill their own levy) keep the city bill off the county portal: pull the city's Munis Citizen Self Service ViewBill for each year; interest lines on paid bills date the late payments",
  "municipal_permit_and_violation_layers": "Rocky Mount publishes Munis permits (piapphdr) and code cases (picv) as address-geocoded feature services: an address with a permit location record and its own suffixed parcel id since 2007 is unit-count evidence; a Required Permits List tells which absent permits matter (HVAC yes, roof covering under 40,000 no)",
  "nonconforming_lot_check": "read the district's minimum lot and width row (Sec. 601 here) for every nonconforming-use row: a 50 x 150 platted lot in R-10 (10,000 sf, 75 ft) is a nonconforming lot of record on top of the use question, and would fail the two-family district's width (60 ft) even if rezoned",
  "adu_cell_check": "when the use table denies two-family, read the 'Accessory dwelling' cell and the ADU section: a permitted ADU at 50 percent of the principal is a legal fallback for an unequal split, not for twin units",
  "post_supplement_amendments": "Municode's Supp. date is the code snapshot; the city's own LDC page lists adopted text amendments after it (read the PDFs; image-only ones render with PyMuPDF)",
  "deq_site_layers": "query the DEQ DSCA (dry-cleaner) Contaminated and Remediation layers, UST closed/active facilities and incidents, hazardous-waste handlers, brownfields and landfills within 500 m; a plume in Assessment with a 'Higher' groundwater rating within about 200 m is an ask to the project manager, not a knockout on city water",
  "crime_composition": "report the ring count with its composition: one store's shoplifting can be a fifth of a 402 m ring; report the 100 m inner ring and the block's residential break-ins separately",
  "utility_rate_step": "Rocky Mount's utility rates rose about 15 percent on 4/1/2026 (water 23.51 and sewer 29.28 per 3,000 gallons, refuse 21.25, stormwater 8 per ERU): price owner-paid stresses from the current schedule, not the posted 7/1/2025 policy PDF",
  "street_view_pairing": "in the photometa response the dated pano list indexes into the pano entries (panoid followed by lat/lng); compute the bearing from each pano to the building footprint centroid for the thumbnail yaw"
 },
 "rocky_mount_instruments": {
  "agol_org": "orgid:4MdqIsNzxG7xyTvf (928 feature services; search https://www.arcgis.com/sharing/rest/search?q=orgid%3A4MdqIsNzxG7xyTvf%20type%3A%22Feature%20Service%22&num=100&start=N&f=json)",
  "address_points": "External_Viewer_WFL1/54 (A_COMPLETE, A_UNIT, MUNIS_PIN with -NNNNA suffix per secondary dwelling, A_BLDGNAME)",
  "buildings": "External_Viewer_WFL1/55 (BLDG_TYPE DUPLEX/TRIPLEX etc., YR_BUILT; query with the parcel polygon)",
  "zoning": "External_Viewer_WFL1/17 and Zoning_Sec_Codes/75 (Prim_Code, Sec_Code, Ordinance, Municode links)",
  "parcel_master": "CRM_Parcel_Master/67 (OwnerName LIKE; Bookpage; values; Ward; County)",
  "crime": "All_Crimes_for_FS_New/16 (5-year window; geox/geoy EPSG 6543 ft; where-clause bbox then true distance; fields offense, ucr_code, premise, streetnbr, street)",
