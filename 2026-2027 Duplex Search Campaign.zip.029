 },
 "nc_sales_assessment_ratio_2025": {
  "_note": "NCDOR 2025 sales assessment ratio; G.S. 105-286(a)(2) forces an advanced reappraisal for counties >= 75,000 population when the ratio leaves 0.85-1.15. None of the board counties is triggered on the 2025 study.",
  "Wilson": 0.9293,
