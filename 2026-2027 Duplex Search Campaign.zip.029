␀␀␀␀␀Î,]ÎŸy ØG␀␀ØG␀␀A␀␀␀2026-2027 Duplex Search Campaign/_pipeline/rentcomp_underwrite.py# Rent-comp pass for the two round-10 entrants (run 2026-09-12). Reuses the round10_final.py formula:
# NOI = rent*12*(1-0.05 vac-0.10 mgmt-0.08 maint-0.05 capex) - taxes - insurance; loan 75% at 6.75%/30y; cash 31.25% of price.
import csv
CAMP = "C:/Users/najum/Dropbox/linked/FAMILY/Ogo/.Investment/2026-2027 Duplex Search Campaign/"
def num(x):
    try: return float(str(x).replace(",",""))
    except: return None
def pmt(loan, rate=0.0675): r=rate/12; return loan*r/(1-(1+r)**-360)*12
def crime_pen(g): return {"F": 3, "D-": 2, "D": 1, "D+": 0.5}.get(g.split(" ")[0], 0)
def uw(price, rent, taxes, ins, grade, crime, drive, flood, gate1=True):
    vac = 0.08 if grade == "RED" else 0.05
    gross = rent*12; noi = gross*(1-vac-0.10-0.08-0.05) - taxes - ins
    ads = pmt(0.75*price); cash = 0.3125*price
    coc = (noi-ads)/cash*100; dscr = noi/ads; r2p = rent/price*100
    if not gate1: verdict = "OUT"
    elif r2p < 0.9: verdict = "NEAR-MISS"
    elif coc < 0: verdict = "OUT (negative cash flow)"
    else: verdict = "ENTRANT"
    pen = 0; why = []
    if verdict in ("ENTRANT", "NEAR-MISS"):
        if grade.startswith("YELLOW"): pen += 4; why.append("YELLOW -4")
        cp = crime_pen(crime)
        if cp: pen += cp; why.append(f"crime {crime.split(' ')[0]} -{cp}")
        if drive and drive > 1.25: pen += 2; why.append(f"drive {drive}h -2")
        if flood and flood >= 5: pen += 1; why.append(f"flood {flood} -1")
        if dscr < 1.2: pen += 2; why.append(f"DSCR {dscr:.2f} -2")
        if verdict == "NEAR-MISS": why.insert(0, f"fails Gate 5: rent-to-price {r2p:.2f}% < 0.9%")
    score = round(coc - pen, 1)
    return dict(noi=round(noi), ads=round(ads), cash=round(cash), coc=round(coc,1), dscr=round(dscr,2), r2p=round(r2p,2), verdict=verdict, score=score, why="; ".join(why))

P = {
 "133 Hugh Caldwell Rd, Charlotte, NC 28214": dict(price=305000, ins=1600, grade="GREEN-verify", crime="D+ (CrimeGrade 28214, read 9/11/26)", drive=5.0, flood=1,
    taxes={"framework 1.00% of price": 3050, "2025 county bill (assessment $260,500; next revaluation 2027)": 2172},
    scen=[(1100, "low", "older small-property 1-beds in west Charlotte: Westchester Craigslist $1,050-1,150, 731 Wabash Ave $1,100, 1900 Lasalle St #1 $1,095"),
          (1200, "BASE", "renovated small-property 1-beds: 8212 Larkhaven Rd #2 $1,195, 3303 Rozzelles Ferry #113 $1,192 (710 sf), 3014 Robin Terry Ct $1,213, 2623 Greenland Ave $1,175 (572 sf)"),
          (1300, "high", "top of the small-property band: 2419 Smugglers Ct $1,350, Ponderosa Apts $1,325; new Class A complexes in 28214 start at $1,323-1,425"),
          (1373, "Gate-5 break-even", "0.90% of $305,000 = $2,745/mo"),
          (1480, "voucher ceiling", "HUD FY2026 SAFMR 1BR for 28214 is $1,650 gross; less a ~$170 utility allowance (tenants pay all utilities) = ~$1,480 contract, and only if Inlivian's rent-reasonableness test accepts it against $1,100-1,350 unassisted comps"),
          (1867, "round-10 basis (retired)", "tract median x 2 = $3,734/mo; not a 1-bed rent")]),
 "610 /612 S 2nd St, Pinetops, NC 27864": dict(price=113900, ins=1600, grade="YELLOW", crime="D- (CrimeGrade 27864, read 9/11/26)", drive=2.7, flood=1,
    taxes={"framework 1.47% of price": 1674, "current-assessment estimate ($420/yr per Redfin's tax line; 606 S 2nd St pays $328 on a $22,337 assessment) - verify with Edgecombe tax office, remodel permits may raise it": 420},
    scen=[(600, "floor", "income-restricted 1-beds in Rocky Mount (Five Points Crossing $575-610); Georgetowne Apts Tarboro from $700"),
          (650, "low", "about 78% of the $825-850 that 606 S 2nd St (2bd/1ba, 840 sf, average condition, two doors down) rented for in Sep 2025 and Apr 2026; it did not move at $900 in Jul 2026"),
          (725, "BASE", "remodeled 1-bed on the same block: Redfin's local summary at 606 S 2nd St shows 1 bd $700 / 2 bd $825; Georgetowne Tarboro 1-bed $700-995; 74 Clark St Tarboro 2bd/1ba house $750"),
          (800, "high", "HUD FY2026 SAFMR 1BR for 27864 is $860 gross (~$800 contract after a utility allowance); Tarboro market 1-beds run $1,000-1,050 but Tarboro is a 3x larger town 8 miles away"),
          (860, "SAFMR gross / round-10 basis", "tract median x 2 = $1,722/mo; equals the SAFMR 1BR gross rent"),
          (513, "Gate-5 break-even", "0.90% of $113,900 = $1,025/mo")]),
}
rows = []
for addr, p in P.items():
    print("\n=====", addr)
    for tlabel, tax in p["taxes"].items():
        for per_unit, case, basis in p["scen"]:
            r = uw(p["price"], per_unit*2, tax, p["ins"], p["grade"], p["crime"], p["drive"], p["flood"])
            rows.append({"address": addr, "price": p["price"], "tax_case": tlabel, "taxes_per_yr": tax, "insurance_per_yr": p["ins"], "rent_case": case, "rent_per_unit": per_unit, "rent_total_mo": per_unit*2, "rent_to_price_pct": r["r2p"], "noi": r["noi"], "debt_service": r["ads"], "cash_in": r["cash"], "coc_6.75_pct": r["coc"], "dscr_6.75": r["dscr"], "verdict": r["verdict"], "score": r["score"], "why": r["why"], "comp_basis": basis})
            print(f"  tax ${tax:>5} | {case:26s} ${per_unit:>5}/unit ${per_unit*2:>5}/mo | r2p {r['r2p']:.2f}% | NOI {r['noi']:>6} | CoC {r['coc']:>5}% | DSCR {r['dscr']:.2f} | {r['verdict']:24s} | score {r['score']:>5} | {r['why']}")
with open(CAMP+"27b Rent-comp underwriting scenarios, round-10 entrants (2026-09-12).csv","w",newline="",encoding="utf-8") as f:
    w = csv.DictWriter(f, fieldnames=list(rows[0].keys())); w.writeheader(); w.writerows(rows)

