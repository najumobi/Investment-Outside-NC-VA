CAMP = "C:/Users/najum/Dropbox/linked/FAMILY/Ogo/.Investment/2026-2027 Duplex Search Campaign/"
SP = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/bacddab6-3a85-475f-bc65-89968adcdf59/scratchpad/r11/"
GEONAMES = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/d3fc537c-7b24-472b-90c0-ce79334bff8a/scratchpad/pass2/US.txt"
PIPE = CAMP + "_pipeline/"
scored = list(csv.DictReader(open(SP+"round11_scored.csv", encoding="utf-8")))
def num(x):
    try: return float(str(x).replace(",",""))
    except: return None
def pmt(loan, rate=0.0675): r=rate/12; return loan*r/(1-(1+r)**-360)*12
# detail facts from the three Zillow detail pages read 2026-09-11 ~11:30pm ET; the other rows are described from the list pages. No photos: nothing reached the photo gate.
D = {
 "760 Collicello St": dict(built=1910, dom=110, status="For sale (Active on Zillow, 110 days; price cut $10,000 on Sep 8, 2026; Zestimate $414,900; MLS #677551)", units=2, units_txt="1910 over/under duplex near downtown Harrisonburg, 2 x 3bd/2ba, 2,392 sf, separate entrances and separately metered utilities; one long-standing month-to-month tenant who pays all utilities", rents=None, cond="OUT under Gate 1: tract 51660000402 (Harrisonburg city) is not in the positive-cash-flow set at x1.0. It also fails Gate 5 badly: 0.50% at tract rents ($2,104 = 2 x $1,052); break-even for 0.9% is $3,771/mo = $1,886 per 3bd unit, above the downtown Harrisonburg market. The only whole duplex in the round.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "100 Suter St": dict(built=2023, dom=108, status="For sale (Active on Zillow, 108 days; price cut $5,000 on Aug 31, 2026; Zestimate $319,200; MLS #677589)", units=1, units_txt="one side of a 2023 duplex: 3bd/2.5ba, 1,296 sf, two floors, granite kitchen, back yard", rents=None, cond="OUT under Gate 3 (a single new-construction duplex half, not the whole building) and Gate 1 (tract 51660000402 fails at x1.0); rent-to-price 0.66% at tract rents.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "289 Hilton Rd": dict(built=1946, dom=505, status="For sale (Zillow, 505 days; MLS #9979271)", units=2, units_txt="a 1946 two-story 5bd/2ba house plus a 1992 doublewide (2bd/2ba, remodeled 2016) on the same lot, three garages, separate septic tanks sharing one drain field", rents=None, cond="OUT under Gate 3 (a house plus a mobile home, not a duplex) and Gate 1 (tract 51169030500 is tier F); rent-to-price 0.43% at tract rents ($1,362). 505 days on market.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "2341 Pocket Rd": dict(built=None, dom=None, status="For sale (Redfin and Zillow)", units=12, units_txt="12-unit mobile home park plus two rented lot spaces, 11 of 12 units rented", rents=None, cond="OUT: a 12-unit mobile home park at $719,000, above the hard ceiling ($532,643) and not a duplex, although tract 51143010200 is tier S and the park yields 1.40% at tract rents.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "4394-4396 4398 Spainhour Mill Rd": dict(built=None, dom=47, status="For sale (Redfin 47 days; price cut $49,001 on Sep 9, 2026 to $299,999)", units=3, units_txt="three separate well-maintained houses on one parcel in Tobaccoville, each 2bd/1+ba, all tenant-occupied", rents=None, cond="OUT under Gate 3 (three detached houses on one parcel, not a duplex). For the record: tract 37067002801 is tier S and three units at the tract median ($950 each = $2,850) would be 0.95%, so the parcel would clear Gate 5 if the campaign ever admits small multi-house parcels; the $49,001 cut on Sep 9 suggests a motivated seller.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "300 Taylor Rd": dict(built=None, dom=None, status="For sale (Redfin and Zillow)", units=5, units_txt="two 2bd/1ba duplexes plus a 3bd/2ba manufactured home, five doors, 4,748 sf, outside Stanley", rents=None, cond="OUT: a five-door package at $698,500, above the hard ceiling and not a single duplex; tract 37071030205 is tier W but rent-to-price is 0.32% at tract rents even before the package problem.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
}
DUP = {"4394": "4394-4396 4398 Spainhour Mill Rd"}
EXTRA = set(D.keys())
TAX = {"VA": 0.0122, "NC": 0.010}
TAX_CITY = {"Bedford": 0.0084, "Fayetteville": 0.013, "Gastonia": 0.011, "Spring Lake": 0.015, "Danville": 0.0084, "Forest": 0.0052, "Blackstone": 0.0082, "Pulaski": 0.011, "Covington": 0.009, "Pinetops": 0.0147, "Charlottesville": 0.0098}
TAX_STREET = {}
BILL = {}
INS = {"VA": 1500, "NC": 1600}
DRIVE_WB = {"Roanoke": 3.8, "Bedford": 3.7, "Mebane": 3.0, "Richlands": 5.5, "Midway Park": 3.5, "Meadowview": 5.2, "Angier": 3.0, "Pennington Gap": 6.7, "Mount Airy": 4.3, "Pinetops": 2.7, "Charlotte": 5.0, "Fairlawn": 4.4, "Smithfield": 3.0, "Charlottesville": 2.1, "Erwin": 3.2, "Harrisonburg": 2.8, "Gate City": 6.3, "Hurt": 3.4, "Tobaccoville": 3.7, "Stanley": 4.8}
CRIME = {}
def crime_pen(g):
    g = g.split(" ")[0] if g else ""
    return {"F": 3, "D-": 2, "D": 1, "D+": 0.5}.get(g, 0)
ORDER = {"ENTRANT": 0, "NEAR-MISS": 1, "OUT (negative cash flow)": 2, "OUT (RED)": 3, "OUT": 4}
out = []; seen = set()
for r in scored:
    street = r["address"].split(",")[0]
    if street in DUP: continue
    if r["shortlist"] != "YES" and street not in EXTRA: continue
    if street in seen: continue
    seen.add(street)
    d = D.get(street)
    if not d: print("no detail for", street); continue
    parts = [p.strip() for p in r["address"].split(",")]
    city = parts[1]; st = parts[2].split()[0]
    price = num(r["price"]); med = num(r["tract_median_rent"])
    rent = d["rents"] or (2*med if med else None)
    gate1 = r["gate1_x1.0"] == "PASS"
    rate = TAX_STREET.get(street) or TAX_CITY.get(city) or TAX[st]
    taxes = rate*price
    if st == "NC": taxes = max(taxes, BILL.get(street, 0))
    ins = INS[st]
    coc = dscr = r2p = None; score = ""; why = []
    if rent:
        vac = 0.08 if d["grade"] == "RED" else 0.05
        gross = rent*12; noi = gross*(1-vac-0.10-0.08-0.05) - taxes - ins
        ads = pmt(0.75*price); cash = 0.3125*price
        coc = (noi-ads)/cash*100; dscr = noi/ads; r2p = rent/price*100
    drive = DRIVE_WB.get(city); crime = CRIME.get(city, "")
    if d["grade"] == "RED": verdict = "OUT (RED)"
    elif d["grade"] == "OUT" or not rent or d["units"] != 2 or not gate1: verdict = "OUT"
    elif r2p < 0.9: verdict = "NEAR-MISS"
    elif coc < 0: verdict = "OUT (negative cash flow)"
    else: verdict = "ENTRANT"
    if verdict in ("ENTRANT", "NEAR-MISS"):
        pen = 0
        if d["grade"].startswith("YELLOW"): pen += 4; why.append("YELLOW -4")
        cp = crime_pen(crime)
        if cp: pen += cp; why.append(f"crime {crime.split(' ')[0]} -{cp}")
        if drive and drive > 1.25: pen += 2; why.append(f"drive {drive}h -2")
        if d["flood"] and d["flood"] >= 5: pen += 1; why.append(f"flood {d['flood']} -1")
        if dscr is not None and dscr < 1.2: pen += 2; why.append(f"DSCR {dscr:.2f} -2")
        score = round(coc - pen, 1)
        if verdict == "NEAR-MISS": why.insert(0, f"fails Gate 5: rent-to-price {r2p:.2f}% < 0.9%")
