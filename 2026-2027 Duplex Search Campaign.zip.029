SP = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/bacddab6-3a85-475f-bc65-89968adcdf59/scratchpad/r12/"
GEONAMES = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/d3fc537c-7b24-472b-90c0-ce79334bff8a/scratchpad/pass2/US.txt"
PIPE = CAMP + "_pipeline/"
scored = list(csv.DictReader(open(SP+"round12_scored.csv", encoding="utf-8")))
def num(x):
    try: return float(str(x).replace(",",""))
    except: return None
def pmt(loan, rate=0.0675): r=rate/12; return loan*r/(1-(1+r)**-360)*12
# detail facts from the 7 detail pages read 2026-09-11 ~11:45pm ET; photos viewed for the Robersonville duplex only
D = {
 "409 E Nelson St": dict(built=1965, dom=81, status="For sale (81 days on Redfin, 82 on Zillow; listing updated Aug 18, 2026; Hive MLS #100583609, Touchdown Realty)", units=2, units_txt="1965 one-story concrete-block duplex, 6bd/2ba total per the portals (sides A and B, marketed as multiple 3-bedroom units), 1,960 sf, 0.49-acre lot (the record says 1 acre), slab, shingle roof, electric heat plus new mini-splits on each side, new windows and front steps, trees removed; B side recently remodeled and rented at $750/mo on a lease, A side long-term tenant at $600/mo with no lease, both want to stay", rents=1350, cond="OUT (negative cash flow) by the thinnest margin: tract 37117970600 (Martin County) is tier P and passes at x1.0 and x1.25, and the stated rents of $750 + $600 = $1,350/mo are exactly 0.90% of $150,000, so Gate 5 passes, but at those rents full-expense NOI (about $8,560 with taxes at the 1.0% NC floor and $1,600 insurance) does not cover the roughly $8,760 debt service (CoC -0.4%, DSCR 0.98). Raising the no-lease A side to the B side's $750 ($1,500/mo, 1.00%) would make it a thin entrant (CoC about 2.4%, DSCR 1.13, still inside the DSCR penalty). The only exterior photo is a night shot from a car windshield, so condition is unverified; CrimeGrade 27871 is D-. Worth a rent question to the agent, not a trip.", grade="YELLOW", flood=1, last_sold="", c="C4", pnote="night photo taken from inside a car: one-story block building, new six-panel door with a fan light, black railing on a small stoop, mini-split condenser on the side wall, chain-link fence, bare dirt yard; nothing else visible"),
 "2112 Providence Rd": dict(built=2002, dom=0, status="For sale (new listing, 11 hours on Zillow; MLS #2624888)", units=1, units_txt="2002 single-family transitional home in Providence Creek, North Chesterfield: 4bd/3ba, 2,156 sf, home office, formal dining, primary suite, cul-de-sac; filed on Zillow as multi-family by mistake", rents=None, cond="OUT under Gate 3: a single-family house, not a duplex, despite tract 51041100910 (tier X0, passes at x1.0 and x1.25) and a mechanical 1.10% at tract rents ($4,620 = 2 x $2,310).", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "101/103 Baldwin Ave": dict(built=2026, dom=52, status="For sale (52 days on Redfin; under construction, completion expected mid-September 2026; Canopy MLS #4405982, EXP Realty; up to 5% closing credit with the preferred lender)", units=2, units_txt="new-construction two-story duplex by Ardent Building Group, mirror-image 3bd/2.5ba units, 2,610 sf total, 5,662 sf lot, slab, forced-air heat and central air, private entrances, rear patios", rents=None, cond="OUT: the Census geocoder cannot place the new address (no tract, so no Gate 1 result), and at $450,000 the 0.9% floor needs $4,050/mo = $2,025 per 3bd unit, above the Spencer market (Rowan County tract medians run about $950-1,100). Noted because it is a genuine new duplex under the practical ceiling. CrimeGrade 28159 is D.", grade="OUT", flood=1, last_sold="", c="", pnote=""),
 "2638 Sunnymeade Rd Unit A&B": dict(built=2024, dom=171, status="For sale (171 days on Redfin; listing updated Jun 26, 2026; LMLS #365044, Elite Realty)", units=2, units_txt="2024 duplex 7 minutes from Liberty University, 2 x 3bd/2.5ba with vaulted ceilings, granite, stainless, walk-in tile showers, back decks over a pond, 2,650 sf total, 0.57 acre, heat pumps; each unit listed for rent at $1,795", rents=3590, cond="OUT: above the practical ceiling ($494,900 vs $481,443) and rent-to-price is only 0.73% at the stated $1,795 per unit ($3,590/mo); break-even is $4,454/mo. Tract 51031020200 is tier S (passes at x1.0, fails at x1.25). 171 days on market.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "723 & 725 N Market Street": dict(built=1930, dom=140, status="For sale (140 days on Zillow; price cut $16,000 on Aug 16, 2026; Zestimate $386,500; Hive MLS #100569655)", units=2, units_txt="1930 duplex renovated to the studs in downtown Washington NC: one 3bd/2ba two-story side and one 2bd/2ba single-level side, 2,219 sf, new metal roof, new HVAC, tankless water heaters, screened rear porches, shed, off-street parking; marketed for Airbnb use", rents=None, cond="OUT under Gate 1: tract 37013930400 is tier F. Rent-to-price 0.46% at tract rents ($1,848); break-even $3,591/mo. The listing's short-term-rental pitch is outside the campaign's long-term-rental model.", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "152 Palmers Aly": dict(built=1964, dom=7, status="For sale (7 days on Redfin; listing updated Sep 4, 2026; DRRAR MLS #79241)", units=4, units_txt="two buildings on 2.21 acres in historic Milton: a 1979 duplex with 2 x 2bd/1ba (wall heat pumps 2024, roof 2013) and a 1964 building with a 3bd/1ba and a 2bd/1ba (window units, older furnace and roof); four apartments, 3,095 sf", rents=None, cond="OUT under Gate 3: a two-building, four-apartment package, not a single duplex. Tract 37033930100 is tier S; even at four units x the $790 tract median ($3,160) it would be 0.85%.", grade="OUT", flood=1, last_sold="", c="", pnote=""),
}
DUP = {"45 NE Castle Ct": "45 Castle Ct", "409 E Nelson Street": "409 E Nelson St"}
EXTRA = set(D.keys())
TAX = {"VA": 0.0122, "NC": 0.010}
TAX_CITY = {"Bedford": 0.0084, "Fayetteville": 0.013, "Gastonia": 0.011, "Spring Lake": 0.015, "Danville": 0.0084, "Forest": 0.0052, "Blackstone": 0.0082, "Pulaski": 0.011, "Covington": 0.009, "Pinetops": 0.0147, "Charlottesville": 0.0098}
TAX_STREET = {}
BILL = {}
INS = {"VA": 1500, "NC": 1600}
DRIVE_WB = {"Roanoke": 3.8, "Bedford": 3.7, "Mebane": 3.0, "Richlands": 5.5, "Midway Park": 3.5, "Meadowview": 5.2, "Angier": 3.0, "Pennington Gap": 6.7, "Mount Airy": 4.3, "Pinetops": 2.7, "Charlotte": 5.0, "Fairlawn": 4.4, "Smithfield": 3.0, "Charlottesville": 2.1, "Erwin": 3.2, "Harrisonburg": 2.8, "Gate City": 6.3, "Hurt": 3.4, "Tobaccoville": 3.7, "Stanley": 4.8, "Robersonville": 2.7, "Richmond": 1.1, "Spencer": 4.2, "Rustburg": 3.6, "Washington": 2.4, "Milton": 3.5}
CRIME = {"Robersonville": "D- (CrimeGrade 27871, read 9/11/26)", "Spencer": "D (CrimeGrade 28159, read 9/11/26)", "Richmond": "C- (CrimeGrade 23236, read 9/11/26)", "Rustburg": "C (CrimeGrade 24588, read 9/11/26)", "Washington": "D+ (CrimeGrade 27889, read 9/11/26)", "Milton": "B- (CrimeGrade 27305, read 9/11/26)"}
def crime_pen(g):
    g = g.split(" ")[0] if g else ""
    return {"F": 3, "D-": 2, "D": 1, "D+": 0.5}.get(g, 0)
ORDER = {"ENTRANT": 0, "NEAR-MISS": 1, "OUT (negative cash flow)": 2, "OUT (RED)": 3, "OUT": 4}
out = []; seen = set()
for r in scored:
    street = r["address"].split(",")[0]
    if street in DUP: continue
    if r["shortlist"] != "YES" and street not in EXTRA: continue
    if street in seen: continue
    seen.add(street)
    d = D.get(street)
    if not d: print("no detail for", street); continue
    parts = [p.strip() for p in r["address"].split(",")]
    city = parts[1]; st = parts[2].split()[0]
    price = num(r["price"]); med = num(r["tract_median_rent"])
    rent = d["rents"] or (2*med if med else None)
    gate1 = r["gate1_x1.0"] == "PASS"
    rate = TAX_STREET.get(street) or TAX_CITY.get(city) or TAX[st]
    taxes = rate*price
    if st == "NC": taxes = max(taxes, BILL.get(street, 0))
    ins = INS[st]
    coc = dscr = r2p = None; score = ""; why = []
    if rent:
        vac = 0.08 if d["grade"] == "RED" else 0.05
        gross = rent*12; noi = gross*(1-vac-0.10-0.08-0.05) - taxes - ins
        ads = pmt(0.75*price); cash = 0.3125*price
        coc = (noi-ads)/cash*100; dscr = noi/ads; r2p = round(rent*100/price, 4)
    drive = DRIVE_WB.get(city); crime = CRIME.get(city, "")
    if d["grade"] == "RED": verdict = "OUT (RED)"
    elif d["grade"] == "OUT" or not rent or d["units"] != 2 or not gate1: verdict = "OUT"
    elif r2p < 0.9: verdict = "NEAR-MISS"
    elif coc < 0: verdict = "OUT (negative cash flow)"
    else: verdict = "ENTRANT"
    if verdict in ("ENTRANT", "NEAR-MISS"):
        pen = 0
        if d["grade"].startswith("YELLOW"): pen += 4; why.append("YELLOW -4")
        cp = crime_pen(crime)
        if cp: pen += cp; why.append(f"crime {crime.split(' ')[0]} -{cp}")
        if drive and drive > 1.25: pen += 2; why.append(f"drive {drive}h -2")
        if d["flood"] and d["flood"] >= 5: pen += 1; why.append(f"flood {d['flood']} -1")
        if dscr is not None and dscr < 1.2: pen += 2; why.append(f"DSCR {dscr:.2f} -2")
        score = round(coc - pen, 1)
        if verdict == "NEAR-MISS": why.insert(0, f"fails Gate 5: rent-to-price {r2p:.2f}% < 0.9%")
