 "https://www.zillow.com/homedetails/211-213-E-Clifford-St-215-Winchester-VA-22601/463520251_zpid/": {
  "url": "https://www.zillow.com/homedetails/211-213-E-Clifford-St-215-Winchester-VA-22601/463520251_zpid/",
  "ok": true,
