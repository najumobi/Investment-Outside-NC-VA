 "lender_property_screen": {
  "_note": "Adopted 9/16/26 from advisory 38 (McFunding MVP DSCR matrix, update 08/05/2026, re-read from the PDF 9/16). One lender's matrix, used as a screen; Ogo's actual lender answers in writing before appraisal spend.",
  "ineligible": [
   "Multiple dwellings on same lot (legal ADU acceptable, limited to one)",
   "Properties with two (2) or more detached single-family homes on a single lot are generally ineligible",
   "Zoning Violations",
   "Work escrows are not allowed",
   "C5 or C6 Property Condition Grades",
   "Properties Less than 600 Square Feet",
   "Rural properties greater than 5 acres"
  ],
  "rural": "Max LTV 70%, no cash-out; triggers include population < 25,000, comps > 5 miles, lot > 5 acres, dirt road, outbuildings",
  "favorable": [
   "First Time Investor: Allowed. No restriction.",
   "2-4 Unit Properties eligible",
   "Minimum DSCR 0.75 with pricing adjustments (campaign's own 1.20 binds)"
  ],
  "fannie_conventional_contrast": "Fannie B4-1.3-05: whether a property is a one-unit with an ADU or a two- to four-unit property is based on characteristics such as separate utility meters, a unique postal address, and whether the unit can be legally rented -> two detached dwellings with two addresses and two meters can be a 2-unit on Form 1025; conventional unlocks 10/13/26",
  "rows_flagged": {
   "18 Troy": "HOLD (detached; 548 sf; open zoning case)",
   "r7a Tunstall": "HOLD (rural 70% LTV; price floor $142,857; single-family land-book class)",
   "r5a Jacob": "rural 70 percent LTV (Cherryville 6,078); class 1020 two-family; missing appliances = no-escrow exposure",
   "w5 Gilmer": "two-unit conventional at 75 percent LTV (Reidsville about 14,500: rural screen not triggered); D- Fair card; baseboard heat with no cooling and no range = no-escrow exposure; appraisal support 115,000-135,000 as-is",
   "w6 Church": "nonconforming duplex in RMD with UDO 5.6.7 barring a rebuild after a 51 percent casualty: the Fannie B4-1.3-04 rebuild-right letter cannot be written -> conventional two-unit financing unavailable; DSCR / portfolio at the 8.00 leg; Clayton about 32,600 (not rural); C3-C4 upper unit, lower unseen; appraisal support 250,000-300,000 as-is"
  },
  "fannie_rebuild_rule": "Fannie B4-1.3-04 (read 9/19/26): the appraiser must classify the use as legal, legal nonconforming, illegal or no zoning; Fannie will not purchase loans on properties subject to regulations that 'prevent the reconstruction or maintenance of the property improvements if they are damaged or destroyed' -> every zoning letter must state the rebuild right"
 },
 "owner_side_municipal_fees": {
  "_note": "Adopted 9/16/26 (advisory 38, verified on city pages): fees billed to the owner on the tax bill, outside the tax rate.",
  "Roanoke": {
   "solid_waste": "$109.20/yr single home; $218.40/yr for properties with more than one home (tax bill; 10% penalty + 10% interest)",
   "stormwater": "$1.55/month per 500 sf impervious ($18.60/yr per unit); 50% residential credit possible, apply by June 1",
   "bpol": "$50 issuance fee at <= $100,000 gross receipts; Permit Center use verification = written zoning answer"
  },
  "Fayetteville": {
   "county_solid_waste_per_dwelling_unit": 130.0,
   "city_solid_waste_per_dwelling_unit": {
    "FY2026": 275.0,
    "FY2027": 285.0
   },
   "city_stormwater_per_parcel": 84.0,
   "duplex_total_2026_bill": 914.0,
   "note": "Verified 9/19/26 on the Cumberland bill details for the four Squirrel parcels (2023-2026). A duplex billed for one household is a machine-readable vacancy or unit-count trace (417 Squirrel, four consecutive bills).",
   "applied_to_rows_2026_09_20": "0 Rhew, 13 Rogers, 11 Edgar, w2 Nickey, 14 Varsity, 26 Pecan, r4d Tamarack (2026 bills read); Squirrel rows on 9/19"
  },
  "Wilson": {
   "note": "no owner-billed fee found; municipal electric/water/sewer/trash/stormwater are tenant-facing accounts ($81.50/mo fixed per account)"
  },
  "Blackstone": {
   "note": "town is the utility (water, sewer, garbage $17.25/mo, electric); single-meter case ~$2,000/yr owner-paid"
  },
  "Spring Lake": {
   "refuse_per_unit_per_year": 396.0,
   "refuse_note": "solid waste availability $32 + litter control $1 a month per residential unit, per container (FY2027 = FY2026; $307 a unit through the 2023 bill), billed on the county tax bill as 'SPRING LAKE 3000 REFUSE TAX' (a duplex pays $792)",
   "stormwater_per_parcel": 60.0,
   "stormwater_note": "$5 per ERU a month residential, 'SPRING LAKE 3000 RES STORM WATER' on the county bill",
   "duplex_total_2026_bill": 852.0,
   "note": "CORRECTED 9/25/26: the 9/20 note ('NO solid-waste or stormwater lines; town sanitation billed through the utility') was wrong; both fees are on the county bill and were in the $1,620.84 total all along. Town on the LGC Unit Assistance List and DEQ-distressed for water/sewer.",
   "applied_to_rows": "9 Scarborough (file 41)"
  }
 },
 "nc_dwelling_insurance": {
  "_note": "NCDOI settlement 4/22/26 (release read verbatim 9/23): average +5% statewide effective 10/1/2026 and +5% effective 10/1/2027, varying by territory; fortified home/roof credits in eastern territories; the 68.3% two-year request (28.5% then 30.9%) was filed 10/30/2025.",
  "ledger": "The board's _0919/_0920 NC figures ($1,680 = $1,600 x 1.05) ALREADY carry the 10/1/2026 step; the 10/1/2027 step gives $1,764. Do not re-apply the first step (advisory 42 did, to $1,764/$1,852). 9/23: the step was applied as an NOI delta to the NC rows still on _0916 figures (Wilson, Eden, Charlotte) where the _0916 CoC convention reproduced from its NOI. 9/24 evening: advisory 45a ALSO re-applied the 10/1/2026 step ($1,764 'as applied since 36a'); its recomputed grid is the 10/2027 grid; 45c's $1,680 grid is current.",
  "base_nc_pre_step": 1600,
  "from_2026_10_01": 1680,
  "from_2027_10_01": 1764
 },
 "safmr_proxy_rule": "Adopted 9/16/26: where the HUD SAFMR for the bedroom count exceeds the portal (Zillow) median for the same ZIP and bedroom count by more than 50%, the proxy is INVALID; underwrite on comps only (28214: SAFMR 1BR $1,650 vs Zillow $695 = +137%).",
 "voucher_fields": "Adopted 9/16/26: record payment_standard, estimated utility_allowance and implied contract_rent separately; only the implied contract rent may enter a rent basis; payment standards cap GROSS rent (contract + utility allowance).",
 "portsmouth_meter_rule": "9/16/26: Portsmouth duplex units carry separate street numbers; query Portsmouth_Meters by CPN (CPN='..' OR Parcel_CPN='..') and by street name, never by the subject address alone (7/9 Barney, 25/27 Carver, 161/163 Choate, 2324/2326 Elm each = two accounts; 3704 Mariner = one).",
 "rate_of_the_week": {
  "_note": "Adopted 9/19/26 (advisory 40 pipeline suggestion, verified): every clearing price is stamped with the rate that produced it; emit the triple.",
  "pmms_30yr": 0.0703,
  "pmms_as_of": "2026-09-24",
  "pmms_prior_week": 0.0695,
  "pmms_year_ago": 0.0626,
  "pmms_15yr": 0.0626,
  "pmms_5wk_series": {
   "2026-08-20": 6.65,
   "2026-08-27": 6.66,
   "2026-09-03": 6.71,
   "2026-09-10": 6.76,
   "2026-09-17": 6.95,
   "2026-09-24": 7.03
  },
  "source": "https://www.freddiemac.com/pmms/docs/PMMS_history.csv (plain curl; last line = current week)",
  "rate_triple": {
   "legacy_constant": 0.0675,
   "conventional_2unit_assumption": 0.074,
   "dscr_estimate": 0.08
  },
  "dscr_spread_over_pmms_bps": [
   75,
   150
  ],
  "dscr_spread_basis": "advisory estimate, not a quoted rate",
  "sensitivity": "125 bp moves the 8%-CoC clearing price about 8.4% when the tax line is assessment-based (price8 = NOI / (0.025 + 0.75 k))",
  "_note_9_25": "PMMS 7.03% on 9/24/2026 (+8 bp); the triple 6.75 / 7.40 / 8.00 is unchanged; the 7.40 conventional two-unit estimate now sits about 37 bp over PMMS",
  "_note_9_25_night": "unchanged: PMMS 7.03 percent (9/24/2026); triple 6.75 / 7.40 / 8.00",
  "_note_9_25_late": "unchanged: PMMS 7.03 percent (9/24/2026); triple 6.75 / 7.40 / 8.00; advisory 51 quoted 6.95 (9/17)",
  "_note_9_25_night_g": "unchanged: PMMS 7.03 percent (9/24/2026); triple 6.75 / 7.40 / 8.00; advisory 52 quoted 6.95",
  "_note_9_25_late_night_j": "unchanged: PMMS 7.03 percent (9/24/2026); triple 6.75 / 7.40 / 8.00; advisory 53 quoted 6.95",
  "_note_9_25_late_evening_gil": "unchanged: PMMS 7.03 percent (9/24/2026); triple 6.75 / 7.40 / 8.00; advisory 57 used the triple",
  "_note_9_26_church": "unchanged: PMMS 7.03 percent (9/24/2026); triple 6.75 / 7.40 / 8.00; advisory 56 used the triple"
 },
 "lgc_unit_assistance_list": {
  "_note": "Adopted 9/19/26: check every NC city AND county row against the current LGC Unit Assistance List; a listed unit carries financial, operational or reporting concerns and loses financing autonomy (G.S. 159-34, S.L. 2022).",
  "list_in_force": "compiled 10/06/2025 on FY2024 audited financials (146 units); the September 2026 list (FY2025 audits) publishes once all units are notified",
  "url": "https://www.nctreasurer.gov/documents/files/slgfdlgc/unit-assistance-list-based-fy-2024-data-compiled-10-06-2025/open",
  "campaign_units_on_10_06_2025_list": [
   "Laurinburg (Scotland) - r7b",
   "Spring Lake (Cumberland) - 9 Scarborough",
   "Vance County - Henderson rows",
   "Robersonville (Martin)",
   "Godwin, Linden, Stedman (Cumberland)",
   "Black Creek, Elm City, Lucama (Wilson County)",
   "Bailey, Middlesex, Whitakers (Nash)",
   "Conetoe, Macclesfield, Princeville (Edgecombe)"
  ],
  "september_2026_additions_announced": [
   "Rocky Mount",
   "Cary",
   "Greensboro",
   "Zebulon"
  ],
  "source_release": "https://www.nctreasurer.gov/news/press-releases/2026/09/04/lgc-applies-financial-oversight-standards-larger-local-governments",
  "september_2026_confirmed_9_25": "LGC release 9/4/2026: Rocky Mount (Edgecombe and Nash), Cary, Greensboro and Zebulon added on FY2025 audits; the full list publishes after notifications; board rows 2 Daughtry, 21 Star, 22 Pine carry the flag",
  "cherryville_gaston_9_25": "Cherryville and Gaston County absent from the 10/06/2025 list (Gaston units: Belmont, Bessemer City, Ranlo, Stanley) and from the 9/4/2026 additions (reproduced on the PDF)",
  "reidsville_rockingham_9_25": "Reidsville and Rockingham County absent from the 10/06/2025 list (Rockingham units listed: Madison, Stoneville) and from the 9/4/2026 additions (reproduced on the PDF); DEQ viability score for Reidsville 7 in 2025 (rising), not distressed",
  "clayton_johnston_9_26": "Clayton and Johnston County absent from the 10/06/2025 list (Johnston units listed: Benson, Kenly, Micro, Whitley Heights Sanitary District) and from the 9/4/2026 additions (reproduced on the PDF)"
 },
 "nc_reappraisal_freeze_2026": "SL 2026-8 (SB 889, 6/19/2026): counties of 15,000+ with a 1/1/2026 reappraisal had to bill FY2027 on the previous schedule of values and use the 2026 values from FY2028; SL 2026-47 (SB 474, 7/8/2026) adjusted the county list (Scotland exempted and re-adopted 69.9c on the new values). Watch for a 2027-session repeat on Wake and Mecklenburg (both reappraise 1/1/2027).",
 "cumberland_condition_codes": "CONDITION field = class letter + percent depreciation: A=Average, F=Fair, P=Poor, U=Unsound (sector 0046MF duplexes: 52 A, 21 F, 1 P, 1 U). Not letter grades. GRADE field = building quality code (e.g. '265 85%').",
 "fayetteville_instruments": {
  "parcels": "https://gis.co.cumberland.nc.us/server/rest/services/Tax/Parcels/MapServer/0 (OWNER LIKE for seller concentration; VCS for the valuation sector; REVENUE_STAMPS x 500 = price; multiple BLDG_PK rows repeat one parcel's sale)",
  "bills": "https://taxpwa.co.cumberland.nc.us/PublicWebAccess/BillSearchResults.aspx?ParcelNum=<PIN with dashes> then BillDetails.aspx?BillPk=<pk> (plain curl with a cookie jar; itemized county/city tax, county SW fee, city SW fee, stormwater, lender tax-service name, payer names)",
  "police": "https://gismaps.fayettevillenc.gov/cofopendatagis/rest/services/Police/IncidentsCrimesAgainst{Persons,Property,Society}/MapServer/0 (Date_Incident >= DATE 'yyyy-mm-dd'; Address LIKE; point + distance buffer)",
  "zoning": "https://gismaps.fayettevillenc.gov/cofopendatagis/rest/services/DevelopmentServices/Zoning/MapServer/0 (ZNTYPE)",
  "udo": "https://online.encodeplus.com/regs/fayetteville-nc/doc-view.aspx?secid= (30-3 districts 9381, 30-4 use table 9434, 30-7 nonconformities 10597/10603/10612/10618); doc-viewer.aspx is a JS shell; ordinance PDFs at doclibrary.aspx?id= are image-only (render with PyMuPDF and read)",
  "permits": "county EnerGov and city open-data layers do NOT hold city residential renovation permits; IDT Plans (login) or Development Services 910-433-1329",
  "choice_neighborhoods": "planning area = tracts 37051001000 and 37051001100; Transformation Plan PDF (104 MB) at fayettevillenc.gov (p.31 boundary text, p.11 map); market study PDF at murchisonchoice.com/s/2022-Murchison-CN-Plan-Housing-Market-Analysis.pdf (tract table)",
  "register_of_deeds": "https://www.ccrodinternet.org/ (browser only; see advisory_41_rules_adopted.rod_transport)",
  "special_assessments": "https://taxpwa.co.cumberland.nc.us/PublicWebAccess/SpecialAssessmentSearch.aspx (POST with __VIEWSTATE/__EVENTVALIDATION, lookupCriterion 'Parcel Number', projectType '' or SATPSW/SATPSA/SATPSL, txtSearchString PIN with dashes, btnGo 'Go'; 'NO DATA FOUND' = none)",
  "ramp": "City Code Ch. 14 Art. (Secs. 14-95 to 14-113) at doc-view.aspx?secid=4 (5.7 MB render; Appendix A point table sits after Sec. 14-129's editor's note); fee in the city fee schedule PDF (Development Services guidance documents)",
  "hud": "https://www.huduser.gov/portal/datasets/fmr.html serves to plain curl with a browser UA; FY27 files at /portal/datasets/fmr/fmr2027/FY27_FMRs.xlsx and FY27_safmrs.xlsx (openpyxl); FY2027_FMR_Schedule.pdf; FY27-Public-SAFMR-Methodology.pdf (Appendix II mandatory list)",
  "cama_cards": "https://taxpwa.co.cumberland.nc.us/camapwa/<Page>.aspx?PARCELPK=<PARCEL_PK> (plain curl): PropertySummary, BuildingDetails&BldgCardNum=1&SectionNum=1, IncomeDetails?VCS=<VCS>&PARCELPK=, SaleDetails?VCS=&PARCELPK=, LandDetails, OutbuildingDetails, DeedDetails, DocumentDetails, PhotoImage; PARCEL_PK is a field of the parcel layer",
  "pwc_service_lines": "https://pws-ptd.120wateraudit.com/fayettevillepwc (JS map; browser only; address search returns one entry per service record; popup carries PWC-side and customer-side material)",
  "pwc_service_regulations": "https://www.faypwc.com/wp-content/uploads/2024/05/Service-Regulations-and-Charges-Revised-5.1.24-Final.pdf (Rev 11 eff. 5/1/2024; p.18 single-meter default; p.9 duplex = Non-single Family; p.58-60 per-unit UCC/SDF for one-meter multi-family)",
  "citizen_connect": "https://cumberlandcounty-nc-cc.connect.socrata.com/ (county Citizen Connect, launched 8/14/2025: planning cases, permits, inspections, code enforcement; JS map, no dataset API found 9/23; county jurisdiction)",
  "pwc_service_lines_api": "POST https://api.120water.com/pws/ptd/graphql with {query: 'query($accountId:ID!,$resultsCount:Int,$search:String){ assetLocationSearch(accountId:$accountId,resultsCount:$resultsCount,search:$search){ items { id location { id addressLine1 addressLine2 latitude longitude } } } }', variables: {accountId:'147', resultsCount:5, search:'<number street>'}} (accountId 147 = fayettevillepwc; plain curl; introspection disabled; one asset per service line -> the count answers the meter question; materials live on the map's clustersForBounds query) | 9/24 street pattern: 2614 Pecan 1 asset (one meter), 2604 Pecan 2 ('' and 'B'), 2703 Pecan 2, single-family neighbours 1 each",
  "rod_imaging_plat_and_5digit_books": "Register of Deeds Imaging tab (browser): Image Set 'Plat' + Book 14 + Page 64 -> View Pages -> 'Open in new tab' href PDFs/00140064.pdf, then curl; five-digit deed books use Image Set 'Deed 10000' (Book 10572 Page 620 -> PDFs/105720620.pdf); the Blazor page may show 'An unhandled error has occurred' after generating the link - the PDF still serves",
  "e911_addresses": "https://gis.co.cumberland.nc.us/server/rest/services/E911/Addresses/MapServer/0 (plain curl; point+distance or ADDRESS LIKE; fields ADDRESS, ADDRESSNO, TYPE (APT/HOM), PIN, LM_NAME, OLD_ADD, DATE_ASGN; a second unit address on the same PIN typed APT = documentary two-unit evidence)",
  "udo_export": "https://online.encodeplus.com/regs/fayetteville-nc/export2doc.aspx?pdf=1&tocid=005.030.00N (N = article; the PDF comes back on the first request - no poll needed; 30-7 = 12 pages, 30-5 = 158 pages, 30-3 = 6 MB)",
  "delinquent_advertisement": "2016-2022 and 2024-2025: https://www.cumberlandcountync.gov/docs/default-source/tax-documents/delinquent-taxes/delinquent_taxes__<YYYY>.pdf (single underscore-word pattern; 2024 = 12 pages published 6/15/2025, 2025 = 14 pages published 6/21/2026); 2023: delinquent-taxes__2023.pdf?sfvrsn=782cbf11_2 (hyphen pattern); text layer greps by PIN, owner name and street; a parcel already in the foreclosure attorney's file may be absent",
  "historic_districts_map": "https://www.fayettevillenc.gov/files/sharedassets/main/v/1/development-services/documents/historic-properties/historic-districts-map.pdf (official map 9/2014: Haymount LHD, Downtown HD, Liberty Row NR, Market House Square NR; render with PyMuPDF and read the street labels)",
  "schedule_of_values_2025": "https://www.cumberlandcountync.gov/docs/default-source/tax-documents/2025-revaluation/2025-sov-draft.pdf (362 pages; p.155 residential exterior-wall codes: 01 minimal, 02 aluminum, 03 MAS/ABST/OLD WOOD, 04 vinyl, 11 brick veneer ...; foundation C/G/S/P; no heating key in the text layer)",
  "county_aerials_public": "Imagery/CC1968 and Imagery/CC2023 export without a token (bbox in 2264 or 4326); CC1982, CC1995, CC2001, CC2008, CC2013, CC2017, CC2021 answer 'Token Required' from this PC",
  "ecourts_portal": "https://portal-nc.tylertech.cloud/Portal/ (Cumberland live since 10/14/2024, Track 6; case-number form YYE00NNNN-260 for estates; fronts a human-verification gate - run by hand)",
  "tax_foreclosure_attorney": "David B. Craig, Attorney at Law (davidbcraig.com; 1903 Bragg Blvd Suite 4; 910-223-3768) represents Cumberland County in tax foreclosures; a bill 'Paid By DAVID B CRAIG, ATTORNEY' means the year was redeemed out of a county foreclosure file; his 'Tax Foreclosure Sales' page lists upcoming sales (watch instrument)",
  "bill_payer_reading": "BillDetails 'Transaction History' payer: owner name = paid by the owner; 'YYYY - 700' / '- 850' = escrow batch (on time); 'ROCKET MORTGAGE/CORELOGIC' or a servicer after the interest date = escrow advance (distress); 'DAVID B CRAIG, ATTORNEY' = tax-foreclosure redemption (distress); a closing law firm = paid at a sale",
  "stormwater_tiers_fy2027": {
   "tier1_lt_2500sf": 84,
   "tier2_2501_4800sf": 168,
   "tier3_gt_4800sf": 252,
   "basis": "impervious building area on the parcel; 77/22/1% of residential parcels",
   "source": "https://www.fayettevillenc.gov/City-Departments/Public-Services/Stormwater/Stormwater-Utility-Fee-Structure-Updates",
   "note": "the 'stormwater $84 per parcel' line in the 9/20 fee stack is tier 1 only; 741 Tamarack (2,166 sf footprint + patios) bills $168"
  },
  "rod_full_system_pdf": "Full System -> name search -> Directory -> Index Detail tree grid (row: Expand / Series / Name / Reverse Party / Description / Rec Date / Type / Instrument # / Book/Page) -> click the row -> 'Image - N page(s)' button -> the Image panel's 'Open in new tab' link is PDFs/User_0_<MM-DD-YYYY-HH-MM-SS-N>.pdf and serves to plain curl (image-only pages); the direct PDFs/<book><page>.pdf pattern 404s; fetching the PDF logs the browser session out (re-acknowledge the disclaimer); the tab strip needs the tab element (not its label) clicked and the grid scrolled before a row can be clicked by coordinates",
  "owner_portfolio_query": "Tax/Parcels layer OWNER LIKE '<LAST, FIRST>%' lists an individual's other Cumberland parcels (mailing address, deed date, stamps); read their BillSearchResults for a portfolio default pattern before pricing a reopen line",
  "listing_record_variants": "Zillow keeps a second zpid for the same parcel (a '741 Tamarack Dr' single-family record 80879434 beside the '741-745' multi-family record 2075846722) and Trulia keeps unit records ('#A' 2056012428); the second zpid and the unit records carried the owner's earlier listing text and rent ask; Zillow, hotpads and Trulia refuse WebFetch and the in-app browser, Bright Data 57ad3277 serves them (truncated), Apify web-fetch (fabdb3db) returns Zillow's listing block and FSBO.com's JSON-LD",
  "cama_cards_note": "https://taxpwa.co.cumberland.nc.us/camapwa/<Page>.aspx?PARCELPK=<PARCEL_PK> (plain curl): PropertySummary, BuildingDetails&BldgCardNum=1&SectionNum=1, IncomeDetails?VCS=<VCS>&PARCELPK=, SaleDetails?VCS=&PARCELPK=, LandDetails, OutbuildingDetails, DeedDetails, DocumentDetails, PhotoImage; PARCEL_PK is a field of the parcel layer | 9/24 evening: IncomeDetails, PermitDetails, NotesDetails and SalesComparison answered 'Application Unavailable' all evening (the other cards served)"
 },
 "laurinburg_instruments": {
  "parcels": "https://services3.arcgis.com/bgKigTDifCMNj8OU/arcgis/rest/services/Tax_Parcels_Scotland_County_view/FeatureServer/6 (2019 values; DeedStamps; PropertyAd LIKE)",
  "zoning": "https://services3.arcgis.com/bgKigTDifCMNj8OU/arcgis/rest/services/Zoning_Laurinburg_-_Public_View/FeatureServer/14 (SR 2264; use a point with inSR=4326 plus distance, or the parcel envelope)",
  "utility_accounts": "https://services3.arcgis.com/bgKigTDifCMNj8OU/arcgis/rest/services/Addresses_City_of_Laurinburg_view/FeatureServer/0 (ACCOUNT_NU per address = city utility account; two accounts = two units on the utility)",
  "webmap": "laurinburg.maps.arcgis.com app 889f012d9e2645278a18addbedd03d74 -> webmap 17634ab57aa5424eb8eca15dd6ecfce7 lists 16 layers (parcel sales, easements, ETJ, city limits, address points)",
  "udo": "https://www.laurinburg.org/wp-content/uploads/2023/10/Adopted-UDO-with-Amendments_10-17-2023.pdf (342 pages; Article 6 use table and 6.8 dimensional table; Article 8 nonconforming situations)"
 },
 "advisory_40_rules_adopted": {
  "gs_105_287_capex_rule": "any renovation budget carries an assessment-increase line; NC values are insulated from market movement, not from the buyer's own capex (G.S. 105-287(a)(2b)); 'locked until the next revaluation' language is withdrawn",
  "redfin_assessment_trap": "Redfin's Assessment column for Cumberland parcels shows the cost-approach components (e.g. $61,020), not the sales-comparison tax base ($189,400); use TOTAL_PROP_VALUE or the bill",
  "owner_concentration_probe": "run OWNER LIKE on the county parcel layer for every new row; also run it in the seller's home county (Wake for the 840 Project: empty)",
  "prior_listing_remarks": "keep prior-cycle MLS remarks; the 2016-17 Squirrel remarks disclosed 'needs new wiring and plumbing'",
  "service_fee_vacancy_trace": "compare billed per-unit fees with the modeled count; a one-unit shortfall on a duplex is a vacancy or unit-count trace (417 Squirrel: four bills)",
  "read_the_current_use_table": "never carry a permit precedent as the rule; read the served use-table cell and record the amending ordinance and date (Fayetteville S2025-008 flipped SF-6 duplexes to P on 4/14/2025)",
  "photo_duplicate_check": "hash and pixel-signature every MLS set before counting units or defects (Squirrel: 1=5 identical, 20=39 same room)"
 },
 "advisory_41_rules_adopted": {
  "remarks_rent_scan": "parse rent figures out of the body of listing remarks ('Rent $855', 'Rented at $750, and $835'), not only from Redfin rental-history events; two Fayetteville rows stated in-place rents the proxy overstated by 9-17%",
  "cni_rad_footprint_screen": "screen every candidate against active HUD Choice Neighborhoods and RAD footprints (dated voucher demand wave, dated supply wave, multi-year disruption window); Fayetteville: Murchison Choice = tracts 10 and 11; Newport News: Marshall-Ridley (file 33)",
  "nc_sector_factor": "record the county valuation sector (VCS) and its sales-comp/cost factor with every NC assessment; Cumberland applies a near-uniform factor per sector (0055MF median 2.985, 0046MF similar), so individual appeals have no traction and G.S. 105-287 fixes the value to the next reval",
  "rrp_loading": "pre-1978 rental: EPA RRP applies; 40 CFR 745.83 de minimis = 6 sf per room interior, 20 sf exterior; add a certified-renovator loading to file 08 rehab ranges",
  "siding_material_line": "photo reads carry a siding material line (vinyl / hardboard / wood / brick / block); hardboard signature = face nails, butt joints, edge swelling, face delamination",
  "redfin_assessment_column": "for NC parcels Redfin's 'assessment' can be the cost-approach subtotal (Edgar $77,950) while the county bills on the sales-comparison total ($235,100); Redfin's tax figure itself is usually right",
  "rod_transport": "Cumberland Register of Deeds (ccrodinternet.org) is a Logan Systems Blazor app: plain curl cannot drive it; the in-app browser can (acknowledge disclaimer -> Full System -> Corp radio + form_input the name -> Search -> click the name in Directory -> Index Detail grid lists type, date, book/page, reverse party, description; click a row -> 'Image - N page(s)' -> the 'Open in new tab' link is PDFs/<book><page>.pdf, which curl then fetches; the Imaging tab's Book field truncates to 4 digits, use the Full System route). Instrument PDFs are image-only: render with PyMuPDF and read the pages. Deed-of-trust Exhibit A pages carry parcel IDs, so encumbrance IS answerable this way (Edgar: DT 11802/0067)",
  "npo_definition": "Fayetteville 'NPO' = Noise-Accident Potential Overlay (airport / military), not neighborhood preservation; the zoning layer's ZNTYPE suffixes (/MHO, /CZ) are the only overlays it encodes",
  "seller_entity_check": "pull the SOS/OpenCorporates filing list for every LLC seller: administrative dissolution and reinstatement (Southern Wake Property Group, 11/21-26/2025) and multiple amended annual reports are contract-side flags; require a Certificate of Existence",
  "late_tax_pattern": "read payment dates on the bill detail: a seller who pays after the 1/6 interest date on every parcel (Southern Wake: 3/19/2026 on three parcels) is a liquidity signal, and unpaid current-year bills across the portfolio are consistent with the pattern rather than distress per se",
  "centroid_rule": "point queries against the Fayetteville zoning and police layers must use the parcel centroid; the Census-geocoded address point falls in the right-of-way and returns no zoning polygon",
  "bright_data_account_state": "djnicholasq threw a tool-level error on its first call of 9/20 (advisory); route through Composio next session; the 1d64e66b connector served all 9/20 legs cleanly"
 },
 "fmr_2br_fy2027": {
