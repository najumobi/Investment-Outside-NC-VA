  "mandatory_safmr_metros": "FY27 SAFMR methodology Appendix II lists Charlotte-Gastonia-Rock Hill, Greensboro-High Point, Raleigh, Virginia Beach-Norfolk-Newport News and Winston-Salem among the campaign's metros; Fayetteville, Roanoke, Richmond, Rocky Mount and Durham are not mandatory (a PHA may opt in); payment standards run 90-110% of the applicable figure and cap GROSS rent"
 },
 "fayetteville_lot_area_per_unit": {
  "_note": "UDO 30-3 dimensional tables read 9/23/26 (secid 9381); two- to four-family column",
  "SF-10": 7500,
  "SF-6": 6000,
  "SF-15": "two- to four-family is S in SF-15 and the table's 15,000 is the single-family column; read before use",
  "MR-5": "'5,000 for 1st unit, then 4,000' (read at the ordinance before use)",
  "rule": "compare (units x per-unit minimum) with the GIS Shape.STArea and the county ACREAGE; route any row within 5% of the line to the recorded plat (ROD Image tab, Image Set 'Plat', Book/Page) or a survey"
 },
 "fayetteville_ramp": {
  "ordinance": "City Code Ch. 14 Secs. 14-95 to 14-113 (Ord. S2012-003 eff. 7/1/2012; S2014-022; S2015-005)",
  "triggers": "3+ verified violations in 12 months (14-97) or disorder activity count >= the 90th-percentile threshold for the category (14-101), computed by 1/1 and 7/1 from the prior six months (14-102) with Appendix A point weights (homicide 4; robbery, aggravated assault, illegal discharge, drugs 3; burglary, simple assault, weapons, disorderly conduct 2; threats, prostitution, liquor, ordinance 1; larceny/vandalism/fraud not listed)",
  "consequences": "mandatory meeting within 30 days, remedial action plan, six-month reviews, INRA, revocation for a year, nuisance referral; registered seller reports purchaser within 30 days",
  "fee": "$500 registration (FY25 city fee schedule, set 2017); civil penalty $50/day first 30 days, $100/day next 30, $500/day thereafter",
  "state_ceiling": "G.S. 160D-1207(c): registration only for >4 verified violations in 12 months, 2+ in 30 days, or the top 10% crime/disorder; fee cap $500 per 12 months",
  "instrument": "address-level police history from the three city incident layers scores the Appendix A count; RAMP status itself is an ask to the police official or Development Services"
 },
 "cumberland_appeal_calendar": {
  "informal_2027": "open now; deadline 2/5/2027; Request for Review online / mail / email / Room 530, 117 Dick St; on-site appraiser review; decision letters ~April 2027",
  "informal_2026": "closed 5/20/2026 with the BER's adjournment (BER convened 4/22/2026)",
  "statute": "G.S. 105-322(e) first meeting first Monday April to first Monday May; (g)(2) taxpayer heard on written request before adjournment; (g)(1)c bound by 105-286/287 in a non-reval year; 105-287(a)(2) misapplication of schedules is the only market-adjacent ground",
  "sector_factors": {
   "0055MF": 2.985,
   "0329MF": 2.07
  },
  "source": "https://www.cumberlandcountync.gov/departments/tax-group/tax/real-estate-gis-mapping/real-property-value-and-appeal"
 },
 "advisory_42_rules_adopted": {
  "zip_tract_check": "verify every row's ZIP and tract with the Census geocoder at the parcel centroid before SAFMR, comp or tract screens (Varsity: MLS 28304, record 28301)",
  "rent_ask_history": "parse unit-level rental pages (listed / price changed / removed / relisted under a new MLS number) into rent_ask_history; a relist resets the visible days on market (Varsity: 67 true days across two MLS numbers)",
  "lot_area_by_district": "see fayetteville_lot_area_per_unit; rows within 5% of the line go to the plat",
  "ramp_status": "see fayetteville_ramp; score the Appendix A count from the incident layers and ask the city",
  "sales_ratio_screen": "for each VCS compute assessment / stamp-implied price on sales-comparison parcels; above 1.2 = structural tax drag; an appeal still needs a record error",
  "mls_utility_fields": "cross-check 'septic' or 'well' against county PublicUtils layers 2 (PWC Sewer) and 11 (PWC Water) and the county special-assessment search (Sewer & Water project type)",
  "two_dscrs": "report lender-style DSCR (rent over PITIA) beside the framework's NOI-based DSCR",
  "insurance_step_ledger": "record which step a NC insurance figure already carries before adding a step (see nc_dwelling_insurance.ledger)",
  "ira_seller_floor": "for a custodian-held (IRA) seller read the purchase-money deed of trust: loan amount, maturity, ARM type, non-recourse rider, prepayment premium, securitization assignments; payoff + commission + costs is the seller's floor, and a price under it is a short payoff the trust must approve",
  "rod_image_sets": "the ROD Image tab offers Image Sets Deed / Deed 10000 / Plat / Condo / Partnerships / Bond; the Index Detail's '(prev) / (next)' page buttons load adjacent instruments; a Plat book/page can return an 'Image Not Found' placeholder (PB 18 PG 44 did on 9/23) - do not treat the placeholder PDF as the plat",
  "hud_fy27": "see fmr_2br_fy2027; FY2027 FMRs and SAFMRs took effect 10/1/2026 and moved Fayetteville +18% (2BR) and 28301 +11.6%"
 },
 "cumberland_next_revaluation": {
  "year": 2031,
  "basis": "Board of Commissioners resolution 3/2/2026: six-year cycle after the 2025 revaluation, then possibly four-year (2035); CityView 3/3/2026; G.S. 105-286 allows advancement by resolution",
  "replaces": "2033 carried in file 29a's nc_next_reval",
  "source": "https://www.cityviewnc.com/stories/county-to-appraise-property-every-6-years/"
 },
 "advisory_43_rules_adopted": {
  "prior_listing_remarks": "scan every prior listing's remarks in the Redfin history (the 2022 remarks carried the true unit mix and rents; Rogers)",
  "photo_provenance": "flag burned-in MLS watermarks with a year, resolution/aspect clusters and lead images older than 12 months; a listing whose cover is a prior-sale collage is presenting the last owner's staging",
  "county_income_model": "for every Cumberland A101 parcel read camapwa IncomeDetails: the unit-type line is a third source on the mix and the model's rents/expense ratio/rate give the revaluation scenario directly",
  "release_floor": "when one deed of trust covers several listed parcels, read the instrument for the note type (term vs line), maturity and any release clause; allocate by value across the pool and carry release at 100-125% of allocation grossed up for 7.5% costs",
  "twin_cards": "pull the same-product twins' building cards (bedrooms, baths, exterior, depreciation) when the subject has no building record",
  "same_street_rental": "search the street's unit-level rental pages (Redfin unit-A/B, Zillow APT records, apartments.com) for asks within 90 days; a same-product ask beats any ZIP average",
  "lender_status": "check the lender's FDIC record and merger news: a blanket-lien release decision moves with the bank's ownership",
  "seller_litigation": "search Trellis/eCourts for the seller LLC as defendant; an open buyer suit is a disclosure and judgment-search item",
  "cares_notice_floor": "notice_to_vacate_floor_days = 30 under Fannie/Freddie/FHA/VA/USDA financing (CARES Act section 4024; CRS R48955)",
  "revaluation_year_check": "re-verify each county's next revaluation year at every rebase (Cumberland moved 2033 -> 2031 by resolution)",
  "transport_0923_evening": "Bright Data: connector 2b7b1243 (djnicholasaY) served Redfin/apartments.com/apartmentfinder and Google SERP; connectors 1d64e66b (djnicholasq) and 57ad3277 (ajumobinicholasY) 'rejected the current credentials' (reconnect needed); 7f958115 (bjumobinicholasY) and all four user-scope servers HTTP 407. Apify web-fetch actor (MobY, CajH, NcaH) served Zillow, realtor.com, trellis.law, myhtr.com and sfranalytics through Cloudflare (GcaH hit 'too-many-concurrent-requests'); OpenCorporates is an HAProxy captcha to every leg; NC SOS bars scripted searches (run by hand). Plain curl served the Cumberland parcel/CAMA/bill/imagery services, the city police and zoning layers, FEMA, Census, PWC's PDF, CityView, ABA, Yahoo, the Federal Register and the FDIC API; Redfin, Zillow, apartments.com, myhtr and realtor.com 403 plain curl and WebFetch; the Register of Deeds Blazor app served the 202-row index through the in-app browser (Directory tab -> name -> Index Detail), screenshots time out while the pane is hidden - use get_page_text",
  "water_meter_count": "count the PWC 120Water service-line assets for the address (two = per-unit metering, probable) before carrying an owner-paid-water scenario; confirm with a bill",
  "plat_face_check": "pull the subdivision plat through the ROD Imaging 'Plat' image set: the 1950s plats carry the original unit type per lot (duplex vs single) and show whether covenants are on the face"
 },
 "pwc_rates_2026": {
