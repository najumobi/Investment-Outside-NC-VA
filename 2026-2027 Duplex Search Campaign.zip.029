TAX_STREET = {}
BILL = {}
INS = {"VA": 1500, "NC": 1600}
DRIVE_WB = {"Raleigh": 2.9}
CRIME = {"Raleigh": "C+ (CrimeGrade 27613, read 9/12/26)"}
def crime_pen(g):
    g = g.split(" ")[0] if g else ""
    return {"F": 3, "D-": 2, "D": 1, "D+": 0.5}.get(g, 0)
ORDER = {"ENTRANT": 0, "NEAR-MISS": 1, "OUT (negative cash flow)": 2, "OUT (RED)": 3, "OUT": 4}
out = []; seen = set()
for r in scored:
    street = r["address"].split(",")[0]
    if street in DUP: continue
    if r["shortlist"] != "YES" and street not in EXTRA: continue
    if street in seen: continue
    seen.add(street)
    d = D.get(street)
    if not d: print("no detail for", street); continue
    parts = [p.strip() for p in r["address"].split(",")]
    city = parts[1]; st = parts[2].split()[0]
    price = num(r["price"]); med = num(r["tract_median_rent"])
    rent = d["rents"] or (2*med if med else None)
    gate1 = r["gate1_x1.0"] == "PASS"
    rate = TAX_STREET.get(street) or TAX_CITY.get(city) or TAX[st]
    taxes = rate*price
    if st == "NC": taxes = max(taxes, BILL.get(street, 0))
    ins = INS[st]
    coc = dscr = r2p = None; score = ""; why = []
    if rent:
        vac = 0.08 if d["grade"] == "RED" else 0.05
        gross = rent*12; noi = gross*(1-vac-0.10-0.08-0.05) - taxes - ins
        ads = pmt(0.75*price); cash = 0.3125*price
        coc = (noi-ads)/cash*100; dscr = noi/ads; r2p = round(rent*100/price, 4)
    drive = DRIVE_WB.get(city); crime = CRIME.get(city, "")
    if d["grade"] == "RED": verdict = "OUT (RED)"
    elif d["grade"] == "OUT" or not rent or d["units"] != 2 or not gate1: verdict = "OUT"
    elif r2p < 0.9: verdict = "NEAR-MISS"
    elif coc < 0: verdict = "OUT (negative cash flow)"
    else: verdict = "ENTRANT"
    if verdict in ("ENTRANT", "NEAR-MISS"):
        pen = 0
        if d["grade"].startswith("YELLOW"): pen += 4; why.append("YELLOW -4")
        cp = crime_pen(crime)
        if cp: pen += cp; why.append(f"crime {crime.split(' ')[0]} -{cp}")
        if drive and drive > 1.25: pen += 2; why.append(f"drive {drive}h -2")
        if d["flood"] and d["flood"] >= 5: pen += 1; why.append(f"flood {d['flood']} -1")
        if dscr is not None and dscr < 1.2: pen += 2; why.append(f"DSCR {dscr:.2f} -2")
        score = round(coc - pen, 1)
        if verdict == "NEAR-MISS": why.insert(0, f"fails Gate 5: rent-to-price {r2p:.2f}% < 0.9%")
    rec = {"address": r["address"], "price": int(price), "built": d["built"] or "", "days_on_market": d["dom"] if d["dom"] is not None else "", "status_"+TODAY: d["status"], "units": d["units_txt"], "rent_used": round(rent) if rent else "", "rent_basis": "listing text" if d["rents"] else ("tract median x 2" if rent else ""), "tract": r["tract"], "tract_tier": r["tract_tier"], "gate1_x1.0": r["gate1_x1.0"], "gate1_x1.25": r["gate1_x1.25"], "tract_tpr": r["tract_tpr"], "rent_to_price_pct": round(r2p, 2) if r2p else "", "taxes_assumed": f"${taxes:,.0f}/yr at {rate*100:.2f}%", "coc_6.75_full_expense_pct": round(coc, 1) if coc is not None else "", "dscr_6.75": round(dscr, 2) if dscr is not None else "", "break_even_rent_for_0.9pct": round(0.009*price), "novice_grade": d["grade"], "photo_c_rating": d["c"], "photo_note": d["pnote"], "condition_note": d["cond"], "crime_zip": crime, "drive_h_williamsburg": drive or "", "flood_factor": d["flood"] if d["flood"] is not None else "", "last_sold": d["last_sold"], "score": score, "why": "; ".join(why), "verdict": verdict, "source": r["source"], "url": r["url"]}
    out.append(rec)
out.sort(key=lambda o: (ORDER[o["verdict"]], -(o["score"] if o["score"] != "" else -999)))
with open(CAMP+f"26a Round 14 mechanical passes, detail and underwriting ({TODAY}).csv","w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=list(out[0].keys())); w.writeheader(); w.writerows(out)
keys = []
for o in scored:
    for k in o.keys():
        if k not in keys: keys.append(k)
with open(CAMP+f"26 Round 14 sweep, final 16 ZIPs scored ({TODAY}).csv","w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=keys); w.writeheader(); w.writerows(scored)
for o in out: print(f"{o['verdict']:24s} | {o['address'][:40]:40s} | ${o['price']:>7} | rent {o['rent_used']} r2p {o['rent_to_price_pct']} | CoC {o['coc_6.75_full_expense_pct']} DSCR {o['dscr_6.75']} | tax {o['taxes_assumed']} | score {o['score']} | {o['novice_grade']} {o['photo_c_rating']}")
