 "rental_inspection_districts": {
  "_note": "Virginia rental inspection districts (Va. Code 36-105.1:1) verified 9/15/26 by GIS layer where available. NC cities are barred from periodic rental inspection programs by G.S. 160D-1207.",
  "Roanoke": "GIS Public/Rental_Inspection: districts Northwest, Southeast (+4 others); Certificate of Compliance 4 yrs, $25/$50",
  "Newport News": "RID 1-3 = NSAs 01-03 (South NN, 2016), RID 4 = NSA 08 (eff. 1/1/2026); certificate ends on transfer of ownership (Sec. 13-196)",
  "Suffolk": "GIS Rental_Inspection_Districts layer 3; Rental Certificate of Occupancy, 48-month term, $100 civil penalty",
  "Danville": "CityWorks layer 7: North and South districts; $50 initial / $35 re-inspection; 4-yr certificate",
