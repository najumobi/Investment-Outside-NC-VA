CAMP = "C:/Users/najum/Dropbox/linked/FAMILY/Ogo/.Investment/2026-2027 Duplex Search Campaign/"
SP = "C:/Users/najum/AppData/Local/Temp/claude/C--Users-najum-Dropbox-linked-FAMILY/d3fc537c-7b24-472b-90c0-ce79334bff8a/scratchpad/pass2/"
scored = list(csv.DictReader(open(SP+"round9_scored.csv", encoding="utf-8")))
def num(x):
    try: return float(str(x).replace(",",""))
    except: return None
def pmt(loan, rate=0.0675): r=rate/12; return loan*r/(1-(1+r)**-360)*12
# detail facts from the 10 detail pages read 2026-09-11 ~9:25pm ET (Redfin unless noted); photos viewed for the six duplex-shaped rows
D = {
 "1903 Fourth St": dict(built=1973, dom=333, status="For sale (relisted Apr 16, 2026)", units=2, units_txt="unit 1 = 1973 doublewide mobile home, 2bd/2ba, heat pump, propane fireplace, covered porches; unit 2 = 1bd/1ba second-story apartment over a full walk-out basement, propane wall heater, age unknown; public record style Mobile/Manufactured Home, block foundation, metal siding", rents=None, cond="OUT under Gate 3: a doublewide mobile home plus an apartment, not a duplex. It was the only mechanical pass of the round: tract 51185020900 is tier S (passes at x1.0 and x1.25) and rent-to-price is 1.12% at tract rents ($1,742). Tenants in place, 333 days on market.", grade="OUT", flood=1, last_sold="", c="C4", pnote="white-and-brown doublewide on a block foundation, small covered porch, level corner lot; the apartment unit is not visible in the front photo"),
 "1702 Elbert Dr": dict(built=1970, dom=93, status="For sale (listing updated Sep 4, 2026; a 2025 listing at $399,000 was withdrawn)", units=2, units_txt="townhouse-style duplex (1702-1704), 2 x 3bd/2.5ba, updated kitchens with islands, decks with mountain views, central heat pumps, separate electric, owner pays water and sewer, 1 acre backing to an apple orchard; both units vacant after recent structural renovations", rents=None, cond="OUT under Gate 1: tract 51161030602 is tier F (tenant-payment rate 11.7) and fails at x1.0 and x1.25. Rent-to-price 0.57% at tract rents ($2,236); the 3bd/2.5ba units would need $1,750 each to reach 0.9%. Both units are vacant after what the listing calls structural renovations; ask what was structural.", grade="YELLOW", flood=1, last_sold="", c="C3", pnote="split-level brick and vinyl duplex, red shutters, side stair to the upper unit, tidy; the photo is dusk-enhanced"),
 "1656 Shady Knoll Ave Unit A&B": dict(built=1967, dom=66, status="For sale", units=2, units_txt="brick one-story duplex, 2 x 1bd/1ba, full basement (1,344 sf), new roof 2020, double-pane windows, most appliances 2023 or newer, central heat pump per unit with its own thermostat, paved drive with 3 spaces, both units rented; MLS gross income $20,400/yr; annual tax listed $603", rents=1700, cond="NEAR-MISS: clears Gate 1 (tract 51019050102, tier P, x1.0 PASS) but the stated rent of $1,700/mo is 0.76% of price (tract rents would be $2,000 = 0.89%). Break-even is $2,025/mo, i.e. $1,013 per 1bd unit in Bedford, which the market does not support.", grade="GREEN-verify", flood=1, last_sold="", c="C3", pnote="brick ranch, new-looking architectural shingle roof, fresh mulch beds, level lawn; only one front door is in frame"),
 "536 Westview Ave #538": dict(built=1942, dom=135, status="For sale (listing updated Sep 1, 2026)", units=2, units_txt="all-brick two-story duplex, 2 x 2bd/1ba, 2,408 sf, full basements, hardwood floors, separate utilities, off-street parking, back porch, dead-end street within walking distance of downtown Bedford", rents=None, cond="NEAR-MISS: clears Gate 1 (tract 51019050102, tier P) but rent-to-price is 0.62% at tract rents ($2,000). Break-even is $2,880/mo, i.e. $1,440 per 2bd unit in Bedford, which the market does not support.", grade="GREEN-verify", flood=None, last_sold="", c="C3", pnote="symmetrical 1942 brick colonial duplex, twin pedimented entries 536/538, original-style windows, roof older but intact, lawn patchy"),
 "106 -108 S 2nd St": dict(built=1950, dom=125, status="For sale (cut from $267,000 to $217,000; Redfin Estimate $193,945)", units=2, units_txt="duplex shell mid-renovation: unit 106 planned as 3bd/2ba with new roof, some new windows, siding started and furnace ductwork in; unit 108 a blank canvas with new floor tile and a tub; buyer must pull full permits to finish electrical, plumbing and interiors; sold as-is; TowneBank renovation loan offered", rents=None, cond="OUT (RED): an unfinished renovation. It also fails Gate 1 (tract 37001021206, tier F).", grade="RED", flood=1, last_sold="", c="C5", pnote="exposed sheathing in both gables, unfinished siding, tape on the windows, bare porch; a construction project, not a rental"),
 "406 N 408 5th St": dict(built=1949, dom=37, status="For sale (listed Aug 5, 2026; Redfin Estimate $302,691)", units=2, units_txt="one-story duplex, 2 x 2bd/1ba, 1,622 sf on 0.43 acre; HVAC and furnace replaced, new flooring, roof repairs, front porch work; tenants in place; part of the seller's Alamance Residential Investment Portfolio (individual sale considered); showings only after an accepted contract; photos predate the tenants", rents=None, cond="NEAR-MISS, the closest of the round: clears Gate 1 (tract 37001021207, tier X0: x1.0 PASS, x1.25 FAIL) and rent-to-price is 0.85% at tract rents ($2,690). Break-even is $2,834/mo = $1,417 per 2bd unit, within reach of Mebane rents; the MLS portfolio summary lists the actual rents. YELLOW because the units cannot be seen before contract and the seller prefers a portfolio sale.", grade="YELLOW", flood=1, last_sold="", c="C3", pnote="vinyl-sided one-story duplex on a raised crawl space, twin gabled porticos and walks, mowed lawn; the photo predates the tenants"),
 "622 Young Rd": dict(built=1970, dom=18, status="For sale (Zillow, 18 days)", units=3, units_txt="three singlewide mobile homes on two parcels (1.90 acres), shared well and driveway, sold as-is", rents=None, cond="OUT under Gate 3: three singlewides, not a duplex", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "30077 Hillman Hwy": dict(built=1976, dom=None, status="For sale (Zillow, sold as-is)", units=1, units_txt="one 8bd/3ba house with two kitchens and two living rooms and a small basement; no separate entrances or meters described; kitchens need updating, some sheetrock work", rents=None, cond="OUT under Gate 3: a single house with two kitchens, not a duplex", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "40595 W Morgan Ave": dict(built=1975, dom=123, status="For sale by owner (Zillow, 123 days)", units=3, units_txt="main house plus two additional small homes on the lot; hot tub, whole-house generator, two sunrooms", rents=None, cond="OUT under Gate 3 (a house plus two small homes) and Gate 1 (tract 51105950301, tier F)", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "101 Bitting Ave": dict(built=1940, dom=163, status="For sale (repeat of the round-7 listing in 27030; Zillow files it under 27041)", units=2, units_txt="2 x 1bd/1ba, fully renovated 2021 (electric, plumbing, drywall, kitchens, baths, roof, mini-splits), both occupied, separately metered electric; can be bought with 528 N Scales St", rents=None, cond="OUT under Gate 1 (tract 37171930400, tier F), as in round 7; rent-to-price 0.60% at tract rents", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "231 Barbara Ave": dict(built=None, dom=None, status="For sale", units=2, units_txt="duplex, 2 x 2bd/3.5ba, 3,264 sf, Midway Park beside Camp Lejeune", rents=None, cond="OUT: above the practical ceiling ($499,000 vs $481,443) and rent-to-price 0.47% at tract rents ($2,324); break-even $4,491/mo", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "711 Tallman Cir": dict(built=None, dom=None, status="For sale", units=2, units_txt="duplex, 2 x 2bd/3.5ba, 2,324 sf, Midway Park beside Camp Lejeune", rents=None, cond="OUT: above the practical ceiling ($499,000 vs $481,443) and rent-to-price 0.47% at tract rents ($2,324); break-even $4,491/mo", grade="OUT", flood=None, last_sold="", c="", pnote=""),
 "31157 Princeton Ave": dict(built=None, dom=None, status="For sale (Zillow)", units=2, units_txt="4bd/4ba, 1,988 sf, metal roof, listed as multi-family", rents=None, cond="OUT: above the practical ceiling ($499,900) and the Census geocoder cannot place the address, so no tract", grade="OUT", flood=None, last_sold="", c="", pnote=""),
}
DUP = {"1903 4th St": "1903 Fourth St", "106-108 2nd St": "106 -108 S 2nd St", "406 N 413th St": "406 N 408 5th St", "406 N 5th St": "406 N 408 5th St"}
EXTRA = set(D.keys())
TAX = {"VA": 0.0122, "NC": 0.010}
TAX_CITY = {"Bedford": 0.0084, "Fayetteville": 0.013, "Gastonia": 0.011, "Spring Lake": 0.015, "Danville": 0.0084, "Forest": 0.0052, "Blackstone": 0.0082, "Pulaski": 0.011, "Covington": 0.009}
TAX_STREET = {"1702 Elbert Dr": 0.0109}
BILL = {}
INS = {"VA": 1500, "NC": 1600}
DRIVE_WB = {"Roanoke": 3.8, "Bedford": 3.7, "Mebane": 3.0, "Richlands": 5.5, "Midway Park": 3.5, "Meadowview": 5.2, "Angier": 3.0, "Pennington Gap": 6.7, "Mount Airy": 4.3}
CRIME = {"Roanoke": "C (CrimeGrade 24018, read 9/11/26)", "Bedford": "C+ (CrimeGrade 24523, read 9/11/26)", "Mebane": "C (CrimeGrade 27302, read 9/11/26)", "Richlands": "D (CrimeGrade 24641, read 9/11/26)", "Meadowview": "C (CrimeGrade 24361, read 9/11/26)", "Pennington Gap": "D+ (CrimeGrade 24277, read 9/11/26)", "Angier": "B (CrimeGrade 27501, read 9/11/26)", "Mount Airy": "D+ (CrimeGrade 27030; 27041 reads C-), read 9/11/26"}
def crime_pen(g):
    g = g.split(" ")[0] if g else ""
    return {"F": 3, "D-": 2, "D": 1, "D+": 0.5}.get(g, 0)
ORDER = {"ENTRANT": 0, "NEAR-MISS": 1, "OUT (negative cash flow)": 2, "OUT (RED)": 3, "OUT": 4}
out = []; seen = set()
for r in scored:
    street = r["address"].split(",")[0]
    if street in DUP: continue
    if r["shortlist"] != "YES" and street not in EXTRA: continue
    if street in seen: continue
    seen.add(street)
    d = D.get(street)
    if not d: print("no detail for", street); continue
    parts = [p.strip() for p in r["address"].split(",")]
    city = parts[1]; st = parts[2].split()[0]
    price = num(r["price"]); med = num(r["tract_median_rent"])
    rent = d["rents"] or (2*med if med else None)
    gate1 = r["gate1_x1.0"] == "PASS"
    rate = TAX_STREET.get(street) or TAX_CITY.get(city) or TAX[st]
    taxes = rate*price
    if st == "NC": taxes = max(taxes, BILL.get(street, 0))
    ins = INS[st]
    coc = dscr = r2p = None; score = ""; why = []
    if rent:
        vac = 0.08 if d["grade"] == "RED" else 0.05
        gross = rent*12; noi = gross*(1-vac-0.10-0.08-0.05) - taxes - ins
        ads = pmt(0.75*price); cash = 0.3125*price
        coc = (noi-ads)/cash*100; dscr = noi/ads; r2p = rent/price*100
    drive = DRIVE_WB.get(city); crime = CRIME.get(city, "")
    if d["grade"] == "RED": verdict = "OUT (RED)"
    elif d["grade"] == "OUT" or not rent or d["units"] != 2 or not gate1: verdict = "OUT"
    elif r2p < 0.9: verdict = "NEAR-MISS"
    elif coc < 0: verdict = "OUT (negative cash flow)"
    else: verdict = "ENTRANT"
    if verdict in ("ENTRANT", "NEAR-MISS"):
        pen = 0
        if d["grade"].startswith("YELLOW"): pen += 4; why.append("YELLOW -4")
        cp = crime_pen(crime)
        if cp: pen += cp; why.append(f"crime {crime.split(' ')[0]} -{cp}")
        if drive and drive > 1.25: pen += 2; why.append(f"drive {drive}h -2")
        if d["flood"] and d["flood"] >= 5: pen += 1; why.append(f"flood {d['flood']} -1")
        if dscr is not None and dscr < 1.2: pen += 2; why.append(f"DSCR {dscr:.2f} -2")
        score = round(coc - pen, 1)
        if verdict == "NEAR-MISS": why.insert(0, f"fails Gate 5: rent-to-price {r2p:.2f}% < 0.9%")
    rec = {"address": r["address"], "price": int(price), "built": d["built"] or "", "days_on_market": d["dom"] or "", "status_2026-09-11": d["status"], "units": d["units_txt"], "rent_used": round(rent) if rent else "", "rent_basis": "listing text" if d["rents"] else ("tract median x 2" if rent else ""), "tract": r["tract"], "tract_tier": r["tract_tier"], "gate1_x1.0": r["gate1_x1.0"], "gate1_x1.25": r["gate1_x1.25"], "tract_tpr": r["tract_tpr"], "rent_to_price_pct": round(r2p, 2) if r2p else "", "taxes_assumed": f"${taxes:,.0f}/yr at {rate*100:.2f}%", "coc_6.75_full_expense_pct": round(coc, 1) if coc is not None else "", "dscr_6.75": round(dscr, 2) if dscr is not None else "", "break_even_rent_for_0.9pct": round(0.009*price), "novice_grade": d["grade"], "photo_c_rating": d["c"], "photo_note": d["pnote"], "condition_note": d["cond"], "crime_zip": crime, "drive_h_williamsburg": drive or "", "flood_factor": d["flood"] if d["flood"] is not None else "", "last_sold": d["last_sold"], "score": score, "why": "; ".join(why), "verdict": verdict, "source": r["source"], "url": r["url"]}
    out.append(rec)
out.sort(key=lambda o: (ORDER[o["verdict"]], -(o["score"] if o["score"] != "" else -999)))
with open(CAMP+"21a Round 9 mechanical passes, detail and underwriting (2026-09-11).csv","w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=list(out[0].keys())); w.writeheader(); w.writerows(out)
keys = []
for o in scored:
    for k in o.keys():
        if k not in keys: keys.append(k)
with open(CAMP+"21 Round 9 sweep, 50 ZIPs scored (2026-09-11).csv","w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=keys); w.writeheader(); w.writerows(scored)
for o in out: print(f"{o['verdict']:24s} | {o['address'][:40]:40s} | ${o['price']:>7} | rent {o['rent_used']} r2p {o['rent_to_price_pct']} | CoC {o['coc_6.75_full_expense_pct']} DSCR {o['dscr_6.75']} | score {o['score']} | {o['novice_grade']} {o['photo_c_rating']} | {o['why'][:60]}")
# per-ZIP merged listing counts from the round-9 listings file
lst = list(csv.DictReader(open(SP+"round9_listings.csv", encoding="utf-8")))
Z50 = [z["zip"] for z in json.load(open(SP+"round9_zips.json"))]
MERGED = {z: 0 for z in Z50}
for r in lst: MERGED[r["page_zip"]] = MERGED.get(r["page_zip"], 0) + 1
sl = {}
for r in scored:
    if r["shortlist"] == "YES" and r["address"].split(",")[0] not in DUP: z = r["page_zip"]; sl[z] = sl.get(z,0)+1
qf = CAMP+"06d ZIP sweep queue, active and shallow sets (2026-09-09).csv"
qrows = list(csv.DictReader(open(qf, encoding="utf-8"))); qfields = list(qrows[0].keys()); q = {r["zip"]: r for r in qrows}
tf = CAMP+"12 ZIP sweep tally, rounds 1-8 (2026-09-11).csv"
tally = list(csv.DictReader(open(tf, encoding="utf-8"))); fields = list(tally[0].keys())
tally = [r for r in tally if r["round"] != "round 9"]
for z in Z50:
    qr = q[z]
    tally.append({"round":"round 9","set":qr["set"],"zip":z,"state":"VA" if int(z) < 27000 else "NC","counties":qr["counties"],"weighted_duplex_units_in_passing_tracts":qr["weighted_duplex_units"],"in_home_csa":"no","listings_found_redfin":MERGED.get(z,0),"mechanical_shortlist":sl.get(z,0),"advancing_after_full_gates":0,"second_source_checked":"Zillow duplex page pulled with Redfin in the same pass, 2026-09-11"})
    if not qr["status"].startswith("swept"): qr["status"] = "swept 2026-09-11 (round 9: Redfin + Zillow duplex page)"
newname = CAMP+"12 ZIP sweep tally, rounds 1-9 (2026-09-11).csv"
with open(newname,"w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=fields); w.writeheader(); w.writerows(tally)
with open(qf,"w",newline="",encoding="utf-8") as f:
    w=csv.DictWriter(f, fieldnames=qfields); w.writeheader(); w.writerows(qrows)
print("merged per zip:", MERGED)
print("tally rows:", len(tally), "| queue swept:", sum(1 for r in qrows if r["status"].startswith("swept")), "of", len(qrows), "| pending active:", sum(1 for r in qrows if r["set"]=="active" and r["status"].startswith("pending")), "| pending shallow:", sum(1 for r in qrows if r["set"]=="shallow" and r["status"].startswith("pending")))
pend=[r for r in qrows if r["status"].startswith("pending")]
pend.sort(key=lambda r:-int(r["weighted_duplex_units"]))
print("next 50 stock:", pend[0]["weighted_duplex_units"], "-", pend[49]["weighted_duplex_units"], "| units in next 50:", sum(int(r["weighted_duplex_units"]) for r in pend[:50]), "| total pending units:", sum(int(r["weighted_duplex_units"]) for r in pend))
json.dump([{"rank": i+1, "set": r["set"], "zip": r["zip"], "city": r.get("city",""), "state": r.get("state",""), "counties": r["counties"], "units": int(r["weighted_duplex_units"])} for i, r in enumerate(pend[:50])], open(SP+"round10_pending_top50.json","w"), indent=0)
print("round 10 candidates:", ", ".join(f"{r['zip']} {r.get('city','')}" for r in pend[:50]))
